flowchart TB
    n1["admin/index.php → admin/config.php → start(admin) → framework.php"]
    n2["framework.php khởi tạo DB; Session::start() + cookie OCSESSID<br/>Admin kế thừa session_autostart=true, engine=db"]
    n3["pre-actions: startup/startup → error → event → sass → login → permission"]
    n4["startup/login: Cart\User → isLogged() → user_token<br/>Nếu không hợp lệ: trả Action(common/login), dừng vòng pre-action"]
    n5["startup/permission: hasPermission(access, route)<br/>Nếu bị từ chối: Action(error/permission); dashboard thuộc ignore"]
    n6["startup/router → Action → admin controller/model/view<br/>Mặc định common/dashboard; từng write controller kiểm tra modify"]
    n7["Response::output() → HTTP; shutdown ghi oc_session"]
    n1 --> n2
    n2 --> n3
    n3 --> n4
    n4 --> n5
    n5 --> n6
    n6 --> n7
