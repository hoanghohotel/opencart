{{ header }}
<div id="not-found">
  <div class="container">
    <div class="row">
      <div class="col-sm-4 hidden-xs">
        <div class="icon"><img src="application/view/image/icon/icon-error-404-page-not-found.png" alt="{{ store_name }}" title="{{ store_name }}" class="img-responsive"/></div>
      </div>
      <div class="col-sm-8">
        <div class="message">
          <h1>{{ text_404 }}</h1>
          <h2>{{ text_heading }}</h2>
          <div class="icon visible-xs"><img src="application/view/image/icon/icon-error-404-page-not-found.png" alt="{{ store_name }}" title="{{ store_name }}" class="img-responsive"/></div>
          <p>{{ text_error }}</p>
          <p>{{ text_navigation }}</p>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
