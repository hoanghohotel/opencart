{{ header }} 
<!-- START OF 1/1 (FULL WIDTH) COLUMN BLOCK-->
<table bgcolor="#ffffff" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td valign="top" width="100%"><table align="center" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="100%"><table width="600" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="100%"><table width="600" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td class="spacer" width="30"></td>
                      <td width="540"><table class="full" align="left" width="540" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">
                          
                          <!-- START OF HEADING-->
                          <tr>
                            <td class="center" align="left" style="padding: 0px; font-weight: bold; font-family: 'Open Sans', Helvetica, Arial, sans-serif; color:#23a1d1; font-size:22px; line-height:32px; mso-line-height-rule: exactly;"><span><a class="heading-link" href="#" style="color:#23a1d1; text-decoration: none; font-style: normal; font-weight: bold;">Extension Alert</a></span></td>
                          </tr>
                          <!-- END OF HEADING--> 
                          
                          <!-- START OF TEXT-->
                          <tr>
                            <td class="center" align="left" style="margin: 0; font-size:13px ; color:#aaaaaa; font-family: 'Open Sans', Helvetica, Arial, sans-serif; line-height: 23px;mso-line-height-rule: exactly;"><span>An update has been made to an extension you have purchased. For more information about this update please read the comment below or contact the developer.</span></td>
                          </tr>
                          <!-- END OF TEXT--> 
                          
                          {% if comment %} 
                          <!-- START OF HEADING-->
                          <tr>
                            <td class="center" align="left" style="padding: 0px; padding-top:15px; font-weight: bold; font-family: 'Open Sans', Helvetica, Arial, sans-serif; color:#23a1d1; font-size:16px; line-height:32px; mso-line-height-rule: exactly;"><span>Comment from developer</span></td>
                          </tr>
                          <!-- END OF HEADING--> 
                          
                          <!-- START OF TEXT-->
                          <tr>
                            <td class="center" align="left" style="margin: 0; font-size:13px ; color:#aaaaaa; font-family: 'Open Sans', Helvetica, Arial, sans-serif; line-height: 23px;mso-line-height-rule: exactly;"><span>{{ comment }}</span></td>
                          </tr>
                          <!-- END OF TEXT--> 
                          {% endif %} 
                          
                          <!-- START OF TEXT-->
                          <tr>
                            <td class="center" align="left" style="margin: 0; font-size:13px ; color:#aaaaaa; font-family: 'Open Sans', Helvetica, Arial, sans-serif; line-height: 23px;mso-line-height-rule: exactly;"><p style="text-align:left;"><br />
                                Kind regards,<br />
                                The {{ store }} team</p></td>
                          </tr>
                          <!-- END OF TEXT-->
                        </table></td>
                      <td class="spacer" width="30"></td>
                    </tr>
                  </table></td>
              </tr>
            </table>
            
            <!-- START OF VERTICAL SPACER-->
            
            <table width="600" align="center" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="100%" height="40">&nbsp;</td>
              </tr>
            </table>
            
            <!-- END OF VERTICAL SPACER--></td>
        </tr>
      </table></td>
  </tr>
</table>
<!-- END OF 1/1 (FULL WIDTH) COLUMN BLOCK--> 

<!-- START OF 1/3 AND 2/3 COL LEFT IMAGE BLOCK-->
<table bgcolor="#ffffff" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
