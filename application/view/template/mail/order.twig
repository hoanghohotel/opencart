{{ header }}
<table bgcolor="#ffffff" width="100%" align="center" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td valign="top" width="100%"><table align="center" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td width="100%"><table width="600" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="100%"><table width="600" cellpadding="0" cellspacing="0" border="0">
                    <tr>
                      <td class="spacer" width="30"></td>
                      <td width="540"><table class="full" align="left" width="540" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; mso-table-lspace:0pt; mso-table-rspace:0pt;">

                          <!-- START OF HEADING-->
                          <tr>
                            <td class="center" align="center" style="padding: 0px; font-weight: bold; font-family: 'Open Sans', Helvetica, Arial, sans-serif; color:#6dc6dd; font-size:22px; line-height:32px; mso-line-height-rule: exactly;">
                              <span> <a class="heading-link" href="#" style="color:#6dc6dd; text-decoration: none; font-style: normal; font-weight: bold;"> Your order status has been updated</a></span>
                            </td>
                          </tr>
                          <!-- END OF HEADING-->

                          <tr>
                            <td style="height:30px;">&nbsp;</td>
                          </tr>
                          <!-- START OF TEXT-->
                          <tr>
                            <td align="left" style="margin: 0; font-size:13px ; color:#aaaaaa; font-family: 'Open Sans', Helvetica, Arial, sans-serif; line-height: 23px;mso-line-height-rule: exactly;">
 

                              <table style="width:100%; border:0; font-size:16px; line-height:28px;" cellspacing="0" cellpadding="0">
                                <tr>
                                  <td style="height:50px;">
                                    <span style="display:none"> Status</span>
                                    {% if status == 'complete' %}
                                    <table style="width:100%; border:0; font-size:24px; line-height:28px;" cellspacing="0" cellpadding="0">
                                      <tr>
                                        <td width="33%" align="right"><img src="https://image.opencart.com/original/591985cbf36e6.jpg" alt="" title="" /></td>
                                        <td width="67%" style="font-size:; color:#00af29; text-transform:uppercase; font-weight:bold; padding-left:20px;">{{ order_status }}</td>
                                      </tr>
                                    </table>
                                    {% elseif status == 'pending' %}
                                    <table style="width:100%; border:0; font-size:24px; line-height:28px;" cellspacing="0" cellpadding="0">
                                      <tr>
                                        <td width="33%" align="right"><img src="https://image.opencart.com/original/591985e43dbc0.jpg" alt="" title="" /></td>
                                        <td width="67%" style="font-size:; color:#efa500; text-transform:uppercase; font-weight:bold; padding-left:20px;">{{ order_status }}</td>
                                      </tr>
                                    </table>
                                    {% else %}
                                    <table style="width:100%; border:0; font-size:24px; line-height:28px;" cellspacing="0" cellpadding="0">
                                      <tr>
                                        <td width="33%" align="right"><img src="https://image.opencart.com/original/591985f732af2.jpg" alt="" title="" /></td>
                                        <td width="67%" style="font-size:; color:#ad0000; text-transform:uppercase; font-weight:bold; padding-left:20px;">{{ order_status }}</td>
                                      </tr>
                                    </table>
                                    {% endif %}

                                  </td>
                                </tr>
                                {% if status == 'complete' %}
                                <tr>
                                  <td style="height:30px;">&nbsp;
                                    
                                  </td>
                                </tr>
                                <tr>
                                  <td><a href="{{ download }}" style="background-color:#23a1d1; display:block; padding-top:12px; padding-bottom:12px; color:#ffffff; text-align:center; border-radius:4px; text-decoration:none; font-family:'Open Sans',Helvetica,Arial,sans-serif;" target="_blank">DOWNLOAD EXTENSION</a></td>
                                </tr>
                                {% endif %}
                              </table>


                              <table style="width:100%; border:0; font-size:16px; line-height:28px;" cellspacing="0" cellpadding="0">
                                <tr>
                                  <td style="height:30px;">&nbsp;
                                    
                                  </td>
                                </tr>
                                <tr>
                                  <td width="50" style="height:50px;">Order ID</td>
                                  <td width="50" align="right" style="text-align:right; font-weight:bold; color:#333333;">#{{ order_id }}</td>
                                </tr>
                                <tr>
                                  <td style="height:50px;">Date Added</td>
                                  <td align="right" style="text-align:right; font-weight:bold; color:#333333;">{{ date_added }}</td>
                                </tr>
                              </table>
                              </td>
                          </tr>

                          <!-- END OF TEXT-->

                          <!-- START BUTTON-->

                          <!-- END BUTTON-->

                          <!-- START OF TEXT-->
                          <tr>
                            <td class="center" align="right" style="margin: 0; font-size:13px ; color:#aaaaaa; font-family: 'Open Sans', Helvetica, Arial, sans-serif; line-height: 23px;mso-line-height-rule: exactly;">
                              <p style="text-align:right;">
                                <br />
                                Many thanks,<br />
                                The {{ store }} team</p>
                              </td>
                          </tr>
                          <!-- END OF TEXT-->
                        </table></td>
                      <td class="spacer" width="30"></td>
                    </tr>
                  </table></td>
              </tr>
            </table>

            <!-- START OF VERTICAL SPACER-->

            <table width="600" align="center" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td width="100%" height="40">&nbsp;</td>
              </tr>
            </table>

            <!-- END OF VERTICAL SPACER--></td>
        </tr>
      </table></td>
  </tr>
</table>


