{{ header }}
<div id="support-contact">
	<div class="page-header">
		<div class="container">
			<h1>Contact Us</h1>
			<p>Stay connected with us</p>
		</div>
	</div>
	<div class="container">
		<div class="row">
			<div id="support-contact" class="col-md-8">
				<div class="form-group required">
					<label for="input-reason">Please, choose type of advertising</label> <select name="type" id="input-reason" class="form-control">
						<option value="extension" selected>Extension Advertising</option>
						<option value="marketplace">Marketplace Advertising</option>
					</select>
				</div>
				<div class="row">
					<div class="col-md-5">
						<div class="form-group required">
							<label for="input-name" class="control-label">What is your name?</label> <input type="text" name="name" value="{{ name }}" placeholder="Name" id="input-name" class="form-control">
						</div>
					</div>
					<div class="col-md-7">
						<div class="form-group required">
							<label for="input-email" class="control-label">E-Mail</label> <input type="text" name="email" value="{{ email }}" placeholder="Email" id="input-email" class="form-control"/>
						</div>
					</div>
				</div>
				<div id="contact"></div>
				<div class="form-group required">
					<label for="input-enquiry" class="control-label">Message</label> <textarea name="enquiry" rows="7" id="input-enquiry" class="form-control"></textarea>
				</div>
				<div class="row">
					<div class="col-md-5">
						<div data-captcha="#button-send"></div>
					</div>
					<div class="col-md-7">
						<button type="button" id="button-send" class="btn btn-primary btn-xl btn-block" disabled="disabled">Send Message</button>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="well">
					<h4>General Information</h4>
					<hr>
					<p><a href="mailto:{{ contact_support }}">{{ contact_support }}</a></p>
					<h4>Support</h4>
					<p><a href="mailto:opencart@zendesk.com">opencart@zendesk.com</a>
						<br/>
						Available every day from 09:30 to 18:30 (HK Time).
						<br/>
						Provide your feedback regarding <a href="https://support.opencart.com/anonymous_requests/new" target="_blank">support</a> or an <a href="https://support.opencart.com/anonymous_requests/new" target="_blank">extension</a> .
						<br/>
					</p>
					<h4>Partnerships</h4>
					<p><a href="tel:{{ contact_telephone }}">{{ contact_telephone }}</a>
						<br/>
						<a href="mailto:{{ contact_partner }}">{{ contact_partner }}</a></p>
					<h4>Press And Media</h4>
					<p><a href="tel:{{ contact_telephone }}">{{ contact_telephone }}</a>
						<br/>
						<a href="mailto:{{ contact_marketing }}">{{ contact_marketing }}</a></p>
				</div>
			</div>
		</div>
		<div id="address">
			<h2>Our Office</h2>
			<div class="row">
				<div class="col-md-12">
					<div id="map-hk" class="map"></div>
					<div class="office">
						<div class="row">
							<div class="col-sm-6">
								<h4>Address</h4>
								<p>OpenCart Limited,
									<br/>
									Workshop 22, 7 Floor,
									<br/>
									99Commons,
									<br/>
									99 Pui To Road,
									<br/>
									Tuen Mun,
									<br/>
									Hong Kong
								</p>
							</div>
							<div class="col-sm-6">
								<h4>Office Hours</h4>
								<p>Monday to Friday, 09:30 - 18:30
									<br/>
									Lunch Time: 13:00 - 14:00
									<br/>
									Closed on general holidays
								</p>
								<h4>Telephone</h4>
								<p>+852 2499 0996</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="container-fluid">
		<div class="container">
			<p>Looking for dedicated technical support for your OpenCart Project?
				<br/>
				View our new Dedicated Support.
			</p>
			<p><a href="https://dedicated.opencart.com/" target="_blank" class="btn btn-primary btn-lg">Learn More</a></p>
		</div>
	</div>
	<script type="text/javascript"><!--
  $('#input-reason').change(function(e) {
      e.preventDefault();

      var element = this;

      $.ajax({
          url: 'index.php?route=support/contact/reason&reason=' + encodeURIComponent($('#input-reason').val()),
          dataType: 'html',
          beforeSend: function() {
              $(element).prop('disabled', true);
          },
          complete: function() {
              $(element).prop('disabled', false);
          },
          success: function(html) {
              $('#contact').html(html).fadeIn(200);
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
  });

  $('#button-send').on('click', function() {
      $.ajax({
          url: 'index.php?route=support/advertise/send',
          type: 'post',
          data: $('#support-contact :input, #input-country select, #input-enquiry textarea'),
          dataType: 'json',
          beforeSend: function() {
              $('#button-send').button('loading');
          },
          complete: function() {
              $('#button-send').button('reset');
          },
          success: function(json) {
              $('.alert, .text-danger').remove();
              $('.form-group').removeClass('has-error');

              if (json['redirect']) {
                  location = json['redirect'];
              }

              if (json['error']) {
                  $('.alert-info').after('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error']['warning'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                  for (i in json['error']) {
                      var element = $('#input-' + i.replace('_', '-'));

                      if ($(element).parent().hasClass('form-group')) {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      } else {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      }
                  }

                  // Highlight any found errors
                  $('.text-danger').parent().addClass('has-error');
              }
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
  });
  //--></script>
