{{ header }}
<div id="support-seller">
	<div class="page-header">
		<div class="container">
			<h1>{{ text_heading }}</h1>
			<p>{{ text_subtitle }}</p>
		</div>
	</div>
	<div class="container">
		<div class="row">
			<div class="col-md-8">
				<div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_form_info }}
					<button type="button" class="close" data-dismiss="alert">&times;</button>
				</div>
				<form id="form-contact">
					<div class="form-group required">
						<label for="input-reason">{{ entry_reason }}</label> <select name="reason" id="input-reason" class="form-control">
							<option value="question">{{ text_reason_question }}</option>
							<option value="support">{{ text_reason_support }}</option>
							<option value="refund">{{ text_reason_refund }}</option>
						</select>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-group required">
								<label for="input-name">{{ entry_name }}</label> <input type="text" name="name" value="{{ name }}" placeholder="{{ placeholder_name }}" id="input-name" class="form-control">
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label for="input-website">{{ entry_website }}</label> <input type="text" name="website" value="" placeholder="{{ placeholder_website }}" id="input-website" class="form-control"/>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<div class="form-group required">
								<label for="input-order-id">{{ entry_order_id }}</label> <input type="text" name="order_id" value="" placeholder="{{ placeholder_order_id }}" id="input-order-id" class="form-control">
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group required">
								<label class="control-label" for="input-version">{{ entry_version }}</label> <select name="version_id" id="input-version" class="form-control">
									<option value=""></option>
									{% for download in downloads %}
										<option value="{{ download.download_id }}">{{ download.name }}</option>
									{% endfor %}
								</select>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-12">
							<div class="form-group required">
								<label for="input-enquiry">{{ entry_enquiry }}</label> <textarea name="enquiry" rows="7" id="input-enquiry" class="form-control">{{ enquiry }}</textarea>
							</div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-12">
							<div data-captcha="#button-contact"></div>
						</div>
					</div>
					<div class="row">
						<div class="col-md-12">
							<button type="button" id="button-contact" class="btn btn-primary btn-xl btn-block" disabled="disabled">{{ button_send }}</button>
						</div>
					</div>
				</form>
			</div>
			<div class="col-md-4">
				<div class="well">
					<div class="media">
						<div class="media-left media-middle"><img src="{{ member_image }}" alt="{{ member_username }}" title="{{ member_username }}" class="media-object img-circle"/></div>
						<div class="media-body"><span>{{ member_username }}</span>
							<br/>
							<small>{{ text_member_since }} {{ member_date_added }}</small>
						</div>
					</div>
					<br/>
					<a href="{{ filter_member }}" class="btn btn-primary btn-lg btn-block">{{ button_view_extensions }}</a></div>
				<div id="side-banner"> {{ banner }} </div>
			</div>
		</div>
	</div>
	<script type="text/javascript"><!--
  $('#button-contact').on('click', function() {
      var element = this;

      $.ajax({
          url: 'index.php?route=support/seller/send&member_token={{ member_token }}&extension_id={{ extension_id }}',
          type: 'post',
          data: $('#form-contact :input'),
          dataType: 'json',
          beforeSend: function() {
              $(element).button('loading');
          },
          complete: function() {
              $(element).button('reset');
          },
          success: function(json) {
              $('.alert, .text-danger').remove();
              $('.form-group').removeClass('has-error');

              if (json['redirect']) {
                  location = json['redirect'];
              }

              if (json['error']) {
                  if (json['error']['warning']) {
                      $('.alert-info').after('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error']['warning'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                  }

                  for (i in json['error']) {
                      var element = $('#input-' + i.replace('_', '-'));

                      if ($(element).parent().hasClass('form-group')) {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      } else {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      }
                  }

                  // Highlight any found errors
                  $('.text-danger').parent().addClass('has-error');
              }
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
  });
  //--></script>
</div>
{{ footer }}
