{{ header }}
<div id="support-support">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_heading }}</h1>
    </div>
  </div>
  <div class="container">
    <h2>{{ text_dedicated_heading }}</h2>
    <div class="row">
      <div class="col-md-6">
        <div id="support-ticket">
          <h3>{{ text_open_ticket }}</h3>
          <p>{{ text_open_ticket_desc }}</p>
          <p>{{ text_support_hours }}</p>
          <p><a href="{{ support }}" class="btn btn-primary">{{ button_open_ticket }}</a></p>
        </div>
      </div>
      <div class="col-md-6">
        <div class="methods"><a href="{{ documentation }}" target="_blank">
            <div id="documentation" class="media">
              <div class="media-left"><img src="application/view/image/support/icon-document.png" class="media-object"/></div>
              <div class="media-body">
                <h4 class="media-heading">{{ text_documentation }}</h4>
                <p>{{ text_documentation_desc }}</p>
              </div>
            </div>
          </a><a href="{{ forum }}" target="_blank">
            <div id="cs" class="media">
              <div class="media-left"><img src="application/view/image/support/icon-cs.png" class="media-object"/></div>
              <div class="media-body">
                <h4 class="media-heading">{{ text_community_support }}</h4>
                <p>{{ text_community_support_desc }}</p>
              </div>
            </div>
          </a><a href="{{ dedicated_support }}" target="_blank">
            <div id="ds" class="media">
              <div class="media-left"><img src="application/view/image/support/icon-ds.png" class="media-object"/></div>
              <div class="media-body">
                <h4 class="media-heading">{{ text_dedicated_support }}</h4>
                <p>{{ text_dedicated_support_desc }}</p>
              </div>
            </div>
          </a></div>
      </div>
    </div>
    <div id="resources">
      <h2>{{ text_more_resources }}</h2>
      <div class="row">
        <div class="col-sm-4">
          <div class="box">
            <div class="box-overlay"><a href="{{ documentation }}" target="_blank"><span>{{ button_view_more }}</span></a></div>
            <div><img src="application/view/image/support/icon-github.png"/></div>
            <h4>{{ text_dev_docs }}</h4>
            <p>{{ text_dev_docs_desc }}</p>
          </div>
        </div>
        <div class="col-sm-4">
          <div class="box">
            <div class="box-overlay"><a href="{{ partner }}"><span>{{ button_view_more }}</span></a></div>
            <div><img src="application/view/image/support/icon-partners.png"/></div>
            <h4>{{ text_partners }}</h4>
            <p>{{ text_partners_desc }}</p>
          </div>
        </div>
        <div class="col-sm-4">
          <div class="box">
            <div class="box-overlay"><a href="{{ marketplace }}"><span>{{ button_view_more }}</span></a></div>
            <div><img src="application/view/image/support/icon-marketplace.png"/></div>
            <h4>{{ text_marketplace }}</h4>
            <p>{{ text_marketplace_desc }}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
