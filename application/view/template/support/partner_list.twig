{{ header }}
<div id="support-partner">
	<div class="page-header">
		<div class="container">
			<h1>{{ text_list_heading }}</h1>
			<p>{{ text_list_subtitle }}</p>
		</div>
	</div>
	<div class="container">
		<div class="row">
			<div class="col-sm-4 col-md-3">
				<section id="partner-country">
					<h4>{{ text_country }}</h4>
					<div class="form-group">
						<select class="form-control" onchange="location = this.value">
							{% for country in countries %}
								{% if country.country_id == filter_country_id %}
									<option value="{{ country.href }}" selected="selected">{{ country.name }}</option>
								{% else %}
									<option value="{{ country.href }}">{{ country.name }}</option>
								{% endif %}
							{% endfor %}
						</select>
					</div>
				</section>

				<section id="partner-type">
					<h4>{{ text_type }}</h4>
					{% for partner_type in partner_types %}
						{% if partner_type.member_partner_type_id == filter_type_id %}
							<div class="radio">
								<label onclick="location = '{{ type.href }}'"> <input type="radio" name="partner_type" value="{{ partner_type.href }}" checked="checked">
									{{ partner_type.name }}</label>
							</div>
						{% else %}
							<div class="radio" onclick="location = '{{ partner_type.href }}'">
								<label> <input type="radio" name="partner_type" value="{{ partner_type.href }}"/>
									{{ partner_type.name }}</label>
							</div>
						{% endif %}
					{% endfor %}
				</section>

				<section id="partner-status">
					<h4>{{ text_status }}</h4>
					{% for partner_status in partner_statuses %}
						{% if partner_status.member_partner_status_id == filter_status_id %}
							<div class="radio">
								<label onclick="location = '{{ partner_status.href }}'"> <input type="radio" name="partner_status" value="{{ partner_status.member_partner_status_id }}" checked="checked">
									{{ partner_status.name }}</label>
							</div>
						{% else %}
							<div class="radio">
								<label onclick="location = '{{ partner_status.href }}'"> <input type="radio" name="partner_status" value="{{ partner_status.member_partner_status_id }}"/>
									{{ partner_status.name }}</label>
							</div>
						{% endif %}
					{% endfor %}
				</section>
			</div>
			<div class="col-sm-8 col-md-9">
				{% if country %}
					<h3>{{ text_partners_for }} {{ country }}</h3>
				{% else %}
					<h3>{{ text_worldwide_partners }}</h3>
				{% endif %}

				{% for partner in partners %}
					<section id="partner-list">
						<div class="row">
							<div class="col-xs-6">
								<div class="media">
									<div class="media-left"><img src="{{ partner.status_image }}" title="{{ partner.status_name }}" alt="{{ partner.status_name }}" class="media-object"/></div>
									<div class="media-body">
										<h4>{{ partner.company }}</h4>
										<h6>{{ partner.country }}</h6>
									</div>
								</div>
							</div>
							{% if partner.image %}
								<div class="col-xs-6 text-right"><img src="{{ partner.image }}" title="{{ partner.company }}" alt="{{ partner.company }}"/></div>
							{% endif %}
						</div>
						<div class="row">
							<div class="col-xs-12">
								<p>{{ partner.description }}</p>
								<p><a href="{{ partner.href }}" class="btn btn-primary btn-sm">{{ button_view_partner }}</a></p>
							</div>
						</div>
					</section>
					<hr/>
				{% endfor %}
				<nav>{{ pagination }}</nav>
			</div>
		</div>
	</div>
	<div class="container-fluid">
		<div class="container">
			<div class="media">
				<div class="media-left"><img src="application/view/image/partner/device.png" title="" alt="" class="media-object"/></div>
				<div class="media-body">
					<h4 class="media-heading">{{ text_programme_heading }}</h4>
					<p>{{ text_programme_desc_1 }}</p>
					<p>{{ text_programme_desc_2 }}</p>
					<p><a href="{{ add }}" class="btn btn-primary">{{ button_apply_now }}</a></p>
				</div>
			</div>
		</div>
	</div>
</div>
{{ footer }}
