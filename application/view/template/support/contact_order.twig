<div class="row">
	<div class="col-md-5">
		<div class="form-group required">
			<label for="input-order-id" class="control-label">{{ entry_order_id }}</label> <input type="text" name="order_id" value="" placeholder="{{ placeholder_order_id }}" id="input-order-id" class="form-control">
		</div>
	</div>
	<div class="col-md-7">
		<div class="form-group">
			<label for="input-website" class="control-label">{{ entry_website }}</label> <input type="text" name="website" value="" placeholder="{{ placeholder_website }}" id="input-website" class="form-control"/>
		</div>
	</div>
</div>
<div class="form-group required">
	<label for="input-version" class="control-label">{{ entry_version }}</label>
	<select name="version_id" id="input-version" class="form-control">
		<option value=""></option>
		{% for download in downloads %}
			<option value="{{ download.download_id }}">{{ download.name }}</option>
		{% endfor %}
	</select>
</div>
