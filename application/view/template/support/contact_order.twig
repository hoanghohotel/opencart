<div class="row">
	<div class="col-md-5">
		<div class="form-group required">
			<label for="input-order-id" class="control-label">What is your order ID?</label> <input type="text" name="order_id" value="" placeholder="Order ID" id="input-order-id" class="form-control">
		</div>
	</div>
	<div class="col-md-7">
		<div class="form-group">
			<label for="input-website" class="control-label">Web Site</label> <input type="text" name="website" value="" placeholder="Web Site" id="input-website" class="form-control"/>
		</div>
	</div>
</div>
<div class="form-group required">
	<label for="input-version" class="control-label">Which Opencart version are you using?</label>
	<select name="version_id" id="input-version" class="form-control">
		<option value=""></option>
		{% for download in downloads %}
			<option value="{{ download.download_id }}">{{ download.name }}</option>
		{% endfor %}
	</select>
</div>