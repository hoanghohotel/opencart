{{ header }}
<div id="support-contact">
	<div class="page-header">
		<div class="container">
			<h1>{{ text_heading }}</h1>
			<p>{{ text_subtitle }}</p>
		</div>
	</div>
	<div class="container">
		<div class="row">
			<div id="support-contact" class="col-md-8">
				<div class="alert alert-info"><i class="fa fa-info-circle"></i> {{ text_form_info }}
					<button type="button" class="close" data-dismiss="alert">&times;</button>
				</div>
				<div class="form-group required">
					<label for="input-reason">{{ entry_reason }}</label> <select name="reason" id="input-reason" class="form-control">
						<option value=""></option>
						<option value="account">{{ text_reason_account }}</option>
						<option value="order">{{ text_reason_order }}</option>
						<option value="partner">{{ text_reason_partner }}</option>
						<option value="fraud">{{ text_reason_fraud }}</option>
						<option value="support">{{ text_reason_support }}</option>
						<option value="other">{{ text_reason_other }}</option>
					</select>
				</div>
				<div class="row">
					<div class="col-md-5">
						<div class="form-group required">
							<label for="input-name" class="control-label">{{ entry_name }}</label> <input type="text" name="name" value="{{ name }}" placeholder="{{ placeholder_name }}" id="input-name" class="form-control">
						</div>
					</div>
					<div class="col-md-7">
						<div class="form-group required">
							<label for="input-email" class="control-label">{{ entry_email }}</label> <input type="text" name="email" value="{{ email }}" placeholder="{{ placeholder_email }}" id="input-email" class="form-control"/>
						</div>
					</div>
				</div>
				<div id="contact"></div>
				<div class="form-group required">
					<label for="input-enquiry" class="control-label">{{ entry_enquiry }}</label> <textarea name="enquiry" rows="7" id="input-enquiry" class="form-control"></textarea>
				</div>
				<div class="row">
					{#
					<div class="col-md-5">
						<div data-captcha="#button-send"></div>
					</div>
					#}
					<div class="col-md-7">
						<button type="button" id="button-send" class="btn btn-primary btn-xl btn-block">{{ button_send }}</button>
					</div>
				</div>
			</div>
			<div class="col-md-4">
				<div class="well">
					<h4>{{ text_general_info }}</h4>
					<hr>
					<p><a href="mailto:{{ contact_support }}">{{ contact_support }}</a></p>
					<h4>{{ text_support }}</h4>
					<p><a href="mailto:{{ contact_support }}">{{ contact_support }}</a>
						<br/>
						{{ text_support_hours }}
						<br/>
						{{ text_feedback_prefix }} <a href="{{ dedicated_support }}" target="_blank">{{ text_feedback_support }}</a> {{ text_feedback_or }} <a href="{{ dedicated_support }}" target="_blank">{{ text_feedback_extension }}</a> .
						<br/>
					</p>
					<h4>{{ text_partnerships }}</h4>
					<p><a href="tel:{{ contact_telephone }}">{{ contact_telephone }}</a>
						<br/>
						<a href="mailto:{{ contact_partner }}">{{ contact_partner }}</a></p>
					<h4>{{ text_press_media }}</h4>
					<p><a href="tel:{{ contact_telephone }}">{{ contact_telephone }}</a>
						<br/>
						<a href="mailto:{{ contact_marketing }}">{{ contact_marketing }}</a></p>
				</div>
			</div>
		</div>
		<div id="address">
			<h2>{{ text_our_office }}</h2>
			<div class="row">
				<div class="col-md-12">
					<div id="map-hk" class="map"></div>
					<div class="office">
						<div class="row">
							<div class="col-sm-6">
								<h4>{{ text_address }}</h4>
								<p><strong>{{ store_owner }}</strong><br />{{ store_address }}</p>
							</div>
							<div class="col-sm-6">
								<h4>{{ text_office_hours }}</h4>
								<p>{{ text_office_hours_detail }}</p>
								<h4>{{ text_telephone }}</h4>
								<p>{{ contact_telephone }}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="container-fluid">
		<div class="container">
			<p>{{ text_dedicated_cta }}</p>
			<p><a href="{{ dedicated_support }}" target="_blank" class="btn btn-primary btn-lg">{{ button_learn_more }}</a></p>
		</div>
	</div>
	<script type="text/javascript"><!--
  $('#input-reason').change(function(e) {
      e.preventDefault();

      var element = this;

      $.ajax({
          url: 'index.php?route=support/contact/reason&reason=' + encodeURIComponent($('#input-reason').val()),
          dataType: 'html',
          beforeSend: function() {
              $(element).prop('disabled', true);
          },
          complete: function() {
              $(element).prop('disabled', false);
          },
          success: function(html) {
              $('#contact').html(html).fadeIn(200);
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
  });

  $('#button-send').on('click', function() {
      $.ajax({
          url: 'index.php?route=support/contact/send',
          type: 'post',
          data: $('#support-contact :input, #input-country select, #input-enquiry textarea'),
          dataType: 'json',
          beforeSend: function() {
              $('#button-send').button('loading');
          },
          complete: function() {
              $('#button-send').button('reset');
          },
          success: function(json) {
              $('.alert, .text-danger').remove();
              $('.form-group').removeClass('has-error');

              if (json['redirect']) {
                  location = json['redirect'];
              }

              if (json['error']) {
                  $('.alert-info').after('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error']['warning'] + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                  for (i in json['error']) {
                      var element = $('#input-' + i.replace('_', '-'));

                      if ($(element).parent().hasClass('form-group')) {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      } else {
                          $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
                      }
                  }

                  // Highlight any found errors
                  $('.text-danger').parent().addClass('has-error');
              }
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
  });
  //--></script>
