{{ header }}
<div id="account-download-info">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <div class="media">
          <div class="media-left"><img src="{{ image }}" alt="{{ name }}" title="{{ name }}" class="media-object" /></div>
          <div class="media-body">{% if license %}
            <div class="pull-right">
              <div class="well well-sm text-center"><small class="text-uppercase">{{ text_support_valid }}</small><br />
                <strong>{{ date_added }}</strong></div>
            </div>
            {% endif %}
            <h4 class="media-heading">{{ name }}</h4>
            {% if license %}
            <p>{{ text_purchased_on }} <strong>{{ date_added }}</strong></p>
            {% else %}
            <p>{{ text_added_on }} <strong>{{ date_added }}</strong></p>
            {% endif %}
            <p><a href="{{ extension }}">{{ text_go_extension }}</a></p>
          </div>
        </div>
        <br />
        <ul class="nav nav-tabs">
          <li class="active"><a href="#tab-download" data-toggle="tab">{{ tab_downloads }}</a></li>
          <li><a href="#tab-documentation" data-toggle="tab">{{ tab_documentation }}</a></li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active" id="tab-download">
            <div class="table-responsive">
              <table class="table table-hover">
                <thead>
                  <tr>
                    <th class="text-left">{{ column_name }}</th>
                    <th class="text-left">{{ column_compatibility }}</th>
                    <th class="text-left">{{ column_date_added }}</th>
                    <th class="text-left">{{ column_action }}</th>
                  </tr>
                </thead>
                <tbody>
                
                {% if downloads %}
					{% for download in downloads %}
						<tr>
							<td class="text-left">{{ download.name }}</td>
							<td class="text-left">{{ download.compatibility }}</td>
							<td class="text-left">{{ download.date_added }}</td>
							<td class="text-left"> 
							{% if download.upgrade %}
								<a href="{{ download.upgrade }}" class="btn btn-primary">{{ button_upgrade }}</a>
							{% endif %}
							{% if download.href %}
								<a href="{{ download.href }}" class="btn btn-primary">{{ button_download }}</a>							
							{% endif %}
							{% if not download.href %}
								<button type="button" disabled="disabled" class="btn btn-primary">{{ button_download }}</button>
							{% endif %}</td>
						</tr>
					{% endfor %}
                {% else %}
					<tr>
						<td class="text-center" colspan="4">{{ text_no_results }}</td>
					</tr>
                {% endif %}
                </tbody>                
              </table>
            </div>
          </div>
          <div class="tab-pane" id="tab-documentation"><br />
            {{ documentation }} 
          </div>
        </div>
      </div>    
      <div class="col-md-4">
      <div id="side-banner">{{ banner }}</div>
    </div>
    </div>

  </div>
</div>
{{ footer }}
