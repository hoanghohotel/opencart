<form action="{{ action }}" method="post" id="form-paypal">
  <input type="hidden" name="cmd" value="_xclick" />
  <input type="hidden" name="upload" value="1" />
  <input type="hidden" name="business" value="{{ business }}" />
  <input type="hidden" name="item_name" value="{{ item_name }}" />
  <input type="hidden" name="item_number" value="{{ item_number }}" />
  <input type="hidden" name="currency_code" value="{{ currency_code }}" />
  <input type="hidden" name="amount" value="{{ amount }}" />
  <input type="hidden" name="quantity" value="{{ quantity }}" />
  <input type="hidden" name="email" value="{{ email }}" />
  <input type="hidden" name="invoice" value="{{ invoice }}" />
  <input type="hidden" name="custom" value="{{ custom }}" />
  <input type="hidden" name="rm" value="2" />
  <input type="hidden" name="no_note" value="1" />
  <input type="hidden" name="charset" value="utf-8" />
  <input type="hidden" name="return" value="{{ return }}" />
  <input type="hidden" name="notify_url" value="{{ notify_url }}" />
  <input type="hidden" name="cancel_return" value="{{ cancel_return }}" />
  <input type="hidden" name="paymentaction" value="sale" />
  <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
  </div>
</form>
<script type="text/javascript"><!--
$('#button-confirm').on('click', function() {
	$.ajax({
		url: 'index.php?route=marketplace/paypal/send&extension_id={{ extension_id }}&quantity={{ quantity }}',
		type: 'post',
		data: $('input[name="agree"]'),		
		dataType: 'json',
		beforeSend: function() {
			$('#button-confirm').button('loading');
		},	
		success: function(json) {
			$('.danger').remove();

			if (json['error']) {
				$('#payment').prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			
				$('#button-confirm').button('reset');
			} else {
				$('input[name=\'invoice\']').attr('value', json['invoice']);
				$('input[name=\'custom\']').attr('value', json['custom']);
				
				if ($('input[name=\'custom\']').val()) {
					$('#form-paypal').submit();
				}
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
}).ready(function() {
	$('#button-confirm').button('reset');
});
//--></script> 