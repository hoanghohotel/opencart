{{ header }}
<div id="account-partner">
  <div class="container">
    <div class="row">
      <div class="col-sm-9">
        <form action="{{ action }}" method="post" enctype="multipart/form-data">


          {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
              <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
          {% endif %}
          {% if partner_pending %}
            <div class="alert alert-warning"><i class="fa fa-clock-o"></i> {{ text_pending_approval }}</div>
          {% endif %}


          <fieldset>

            <legend>{{ text_register_partner }}</legend>
          {% if not partner_status %}

            {% if route == 'account/partner/add' %}
            <h1>{{ heading_add }}</h1>
            <p>{{ text_subtitle_add }}</p>
          {% else %}
            <h1>{{ heading_title }}</h1>
            <p>{{ text_subtitle_edit }}</p>
          {% endif %}

              <p>{{ text_qualify_desc }}</p>
              <h4><strong>{{ text_attention }}</strong></h4>
              <div class="alert alert-info">
                <ol>
                  <li>{{ text_requirement_1 }}</li>
                  <li>{{ text_requirement_2 }}</li>
                  <li>{{ text_requirement_3 }}</li>
                  <li>{{ text_requirement_4 }}</li>
                  <li>{{ text_requirement_5 }}</li>
                </ol>
              </div>
            </fieldset>
          {% endif %}

          <fieldset>
            <legend>{{ text_contact_details }}</legend>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-firstname">{{ entry_firstname }}</label> <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control"/>
                  {% if error_firstname %}
                    <div class="text-danger">{{ error_firstname }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-lastname">{{ entry_lastname }}</label> <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control"/>
                  {% if error_lastname %}
                    <div class="text-danger">{{ error_lastname }}</div>
                  {% endif %}</div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-company">{{ entry_company }}</label> <input type="text" name="company" value="{{ company }}" placeholder="{{ entry_company }}" id="input-company" class="form-control"/>
                  {% if error_company %}
                    <div class="text-danger">{{ error_company }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-website">{{ entry_website }}</label> <input type="text" name="website" value="{{ website }}" placeholder="{{ entry_website }}" id="input-website" class="form-control"/>
                  {% if error_website %}
                    <div class="text-danger">{{ error_website }}</div>
                  {% endif %}</div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-email">{{ entry_email }}</label> <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control"/>
                  {% if error_email %}
                    <div class="text-danger">{{ error_email }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-telephone">{{ entry_telephone }}</label> <input type="text" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control"/>
                  <div class="help-block">{{ help_telephone }}</div>
                  {% if error_telephone %}
                    <div class="text-danger">{{ error_telephone }}</div>
                  {% endif %}</div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_about_company }}</legend>
            <div class="form-group required">
              <label class="control-label" for="input-partner-type">{{ entry_partner_type }}</label> <select name="member_partner_type_id" id="input-partner-type" class="form-control">
                <option value=""></option>
                {% for partner_type in partner_types %}
                  {% if partner_type.member_partner_type_id == member_partner_type_id %}
                    <option value="{{ partner_type.member_partner_type_id }}" selected="selected">{{ partner_type.name }}</option>
                  {% else %}
                    <option value="{{ partner_type.member_partner_type_id }}">{{ partner_type.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              {% if error_partner_type %}
                <div class="text-danger">{{ error_partner_type }}</div>
              {% endif %}
            </div>
            <div class="form-group required">
              <label for="input-description-short">{{ entry_description_short }}</label> <textarea name="description_short" placeholder="{{ entry_description_short_holder }}" rows="5" id="input-description-short" class="form-control">{{ description_short }}</textarea>
              {% if error_description_short %}
                <div class="text-danger">{{ error_description_short }}</div>
              {% endif %} </div>
            <div class="form-group required">
              <label for="input-description-long">{{ entry_description_long }}</label> <textarea name="description_long" placeholder="{{ entry_description_long_holder }}" rows="8" id="input-description-long" class="form-control">{{ description_long }}</textarea>
              {% if error_description_long %}
                <div class="text-danger">{{ error_description_long }}</div>
              {% endif %}
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_address }}</legend>
            <div class="form-group required">
              <label class="control-label" for="input-address-1">{{ entry_address_1 }}</label> <input type="text" name="address_1" value="{{ address_1 }}" placeholder="{{ entry_address_1 }}" id="input-address-1" class="form-control"/>
              {% if error_address_1 %}
                <div class="text-danger">{{ error_address_1 }}</div>
              {% endif %}</div>
            <div class="form-group">
              <label class="control-label" for="input-address-2">{{ entry_address_2 }}</label> <input type="text" name="address_2" value="{{ address_2 }}" placeholder="{{ entry_address_2 }}" id="input-address-2" class="form-control"/>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-city">{{ entry_city }}</label> <input type="text" name="city" value="{{ city }}" placeholder="{{ entry_city }}" id="input-city" class="form-control"/>
                  {% if error_city %}
                    <div class="text-danger">{{ error_city }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-postcode">{{ entry_postcode }}</label> <input type="text" name="postcode" value="{{ postcode }}" placeholder="{{ entry_postcode }}" id="input-postcode" class="form-control"/>
                  {% if error_postcode %}
                    <div class="text-danger">{{ error_postcode }}</div>
                  {% endif %}
                </div>
              </div>
            </div>
            <div class="form-group required">
              <label class="control-label" for="input-country">{{ entry_country }}</label> <select name="country_id" id="input-country" class="form-control">
                <option value=""></option>
                {% for country in countries %}
                  {% if country.country_id == country_id %}
                    <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
                  {% else %}
                    <option value="{{ country.country_id }}">{{ country.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              {% if error_country %}
                <div class="text-danger">{{ error_country }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-zone">{{ entry_zone }}</label> <select name="zone_id" id="input-zone" class="form-control"></select>
              {% if error_zone %}
                <div class="text-danger">{{ error_zone }}</div>
              {% endif %}
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_image }}</legend>
            <div class="form-group">
              <div class="row">
                <div class="col-sm-4">
                  <div class="thumbnail"><img src="{{ thumb }}" alt="" title="" id="thumb-image"/> <input type="hidden" name="image" value="{{ image }}" id="input-image"/></div>
                </div>
              </div>
              <div class="row">
                <div class="col-sm-2">
                  <button type="button" data-toggle="image" data-target="#input-image" data-thumb="#thumb-image" class="btn btn-success btn-block">{{ button_browse }}</button>
                </div>
                <div class="col-sm-2">
                  <button type="button" data-toggle="clear" data-target="#input-image" data-thumb="#thumb-image" data-placeholder="{{ placeholder }}" class="btn btn-default btn-block">{{ button_clear }}</button>
                </div>
              </div>
              <div class="help-block">{{ help_image }}</div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_social_platform }}</legend>
            <div class="form-group">
              <label for="input-facebook">{{ entry_facebook }}</label>
              <div class="input-group">
                <input type="text" name="facebook" value="{{ facebook }}" placeholder="{{ entry_facebook_placeholder }}" id="input-facebook" class="form-control"/>
                <div class="input-group-addon"><i class="fa fa-facebook"></i></div>
              </div>
            </div>
            <div class="form-group">
              <label for="input-twitter">{{ entry_twitter }}</label>
              <div class="input-group">
                <input type="text" name="twitter" value="{{ twitter }}" placeholder="{{ entry_twitter_placeholder }}" id="input-twitter" class="form-control"/>
                <div class="input-group-addon"><i class="fa fa-twitter"></i></div>
              </div>
            </div>
            <div class="form-group">
              <label for="input-linkedin">{{ entry_linkedin }}</label>
              <div class="input-group">
                <input type="text" name="linkedin" value="{{ linkedin }}" id="input-linkedin" class="form-control" placeholder="{{ entry_linkedin_placeholder }}"/>
                <div class="input-group-addon"><i class="fa fa-linkedin"></i></div>
              </div>
            </div>
          </fieldset>
          {% if route == 'account/partner/add' %}
            <fieldset>
              <legend>{{ text_terms }}</legend>
              <textarea rows="8" class="form-control" readonly="readonly">{{ text_terms_title }}
  {{ text_terms_intro }}

  {{ text_terms_1 }}

  {{ text_terms_2 }}

  {{ text_terms_3 }}

  {{ text_terms_4 }}

  {{ text_terms_5 }}

  {{ text_terms_6 }}

  {{ text_terms_7 }}</textarea>
              <div class="checkbox">
                <label>{% if agree %}
                    <input type="checkbox" name="agree" value="1" checked="checked"/>
                  {% else %}
                    <input type="checkbox" name="agree" value="1"/>
                  {% endif %}
                  {{ text_agree }}</label>
              </div>
            </fieldset>
          {% endif %}
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
            <button type="submit" class="btn btn-primary">{{ button_submit }}</button>
          </div>
        </form>
      </div>
      <div class="col-sm-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
<link href="application/view/javascript/jquery/colorpicker/css/bootstrap-colorpicker.css" rel="stylesheet"/>
<script type="text/javascript" src="application/view/javascript/jquery/colorpicker/js/bootstrap-colorpicker.js"></script>
<script type="text/javascript" src="application/view/javascript/bbcode.js"></script>
<script type="text/javascript"><!--
$('textarea[name=\'description_long\']').bbcode();
//--></script>
<script type="text/javascript"><!--
$('select[name=\'country_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=localisation/country&member_token={{ member_token }}&country_id=' + this.value,
		dataType: 'json',
		beforeSend: function() {
			$('select[name=\'zone_id\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'zone_id\']').prop('disabled', false);
		},
		success: function(json) {
			if (json['postcode_required'] == '1') {
				$('input[name=\'postcode\']').parent().addClass('required');
			} else {
				$('input[name=\'postcode\']').parent().removeClass('required');
			}

			html = '<option value=""></option>';

			if (json['zone'] && json['zone'] != '') {
				for (i = 0; i < json['zone'].length; i++) {
					html += '<option value="' + json['zone'][i]['zone_id'] + '"';

					if (json['zone'][i]['zone_id'] == '{{ zone_id }}') {
						html += ' selected="selected"';
					}

					html += '>' + json['zone'][i]['name'] + '</option>';
				}
			} else {
				html += '<option value="0" selected="selected">{{ text_none|e('js') }}</option>';
			}

			$('select[name=\'zone_id\']').html(html);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name=\'country_id\']').trigger('change');
//--></script>
{{ footer }}
