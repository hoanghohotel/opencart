{{ header }}
<div id="account-security">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_page }}</h1>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-8">{% if pin_total >= 3 %}
          <div class="alert alert-danger">
            <p><i class="fa fa-exclamation-circle"></i> {{ text_locked_before }} <strong>{{ text_locked_button }}</strong> {{ text_locked_middle }} <a href="{{ contact }}" class="alert-link">{{ text_locked_contact }}</a> {{ text_locked_after }}</p>
          </div>
        {% elseif error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
        {% endif %}
        <h2>{{ text_confirm_title }}</h2>
        <p>{{ text_pin_info_1 }}</p>
        <p>{{ text_pin_info_2 }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">

          <div class="form-group">
            <label for="input-pin">{{ entry_pin }}</label>
            <div class="input-group">
            <input type="password" name="pin" value="{{ pin }}" placeholder="{{ entry_pin }}" id="input-pin" class="form-control"/>
              <div class="input-group-btn"><button type="button" id="button-reset" class="btn btn-danger btn-lg"><i class="fa fa-refresh"></i> {{ button_reset }}</button></div>
            </div>
          </div>

          <div class="form-group">
            <button type="submit" class="btn btn-primary btn-lg">{{ button_continue }}</button>
            <input type="hidden" name="redirect" value="{{ redirect }}" />
          </div>

        </form>
      </div>
      <div class="col-md-4">
        <div id="side-banner">{{ banner }}</div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-reset').on('click', function () {
    $.ajax({
        url: 'index.php?route=account/security/reset',
        dataType: 'json',
        crossDomain: true,
        beforeSend: function () {
            $('#button-reset').button('loading');
        },
        complete: function () {
            $('#button-reset').button('reset');
        },
        success: function (json) {
            $('.alert').remove();

            if (json['success']) {
                $('.container .col-md-8').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
