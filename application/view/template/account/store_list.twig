{{ header }}
<div id="account-store">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <h2>{{ text_registered_stores }}</h2>
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <div class="table-responsive">
          <table id="store" class="table table-bstoreed">
            <thead>
              <tr>
                <th>{{ column_store }}</th>
                <th>{{ column_date_added }}</th>
                <th>{{ column_date_modified }}</th>
                <th class="text-right">{{ column_action }}</th>
              </tr>
            </thead>
            <tbody>
              {% if stores %}
                {% for store in stores %}
                  <tr>
                    <td>{{ store.domain }}</td>
                    <td>{{ store.date_added }}</td>
                    <td>{{ store.date_modified }}</td>
                    <td class="text-right"><a href="{{ store.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info"><i class="fa fa-eye"></i></a> <a href="{{ store.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fa fa-times"></i></a></td>
                  </tr>
                {% endfor %}
              {% else %}
                <tr>
                  <td class="text-center" colspan="4">{{ text_no_results }}</td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <nav>{{ pagination }}</nav>
        <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> <a href="{{ add }}" class="btn btn-primary">{{ button_add }}</a></div>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#store .btn-danger').on('click', function(e) {
	e.preventDefault();

	if (confirm('{{ text_confirm|e('js') }}')) {
		location = $(this).attr('href');
	}
})
//--></script>
{{ footer }}
