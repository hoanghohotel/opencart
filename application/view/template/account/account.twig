{{ header }}
<div id="account-account">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_welcome }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <div id="short-cut">
          <p id="pp-banner"><a href="/index.php?route=marketplace/extension/info&extension_id=38358"><img width="100%" src="application/view/image/banner/paypal_banner_large.jpg" alt="paypal"/></a></p>
          <h2>{{ text_account_section }}</h2>
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ edit }}"><img src="application/view/image/account/icons/account_details.svg" alt="{{ text_account_section }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ edit }}">{{ text_account_details }}</a></h4>
                  <p><a href="{{ edit }}">{{ text_account_details_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ password }}"><img src="application/view/image/account/icons/change_password.svg" alt="{{ text_change_password }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ password }}">{{ text_change_password }}</a></h4>
                  <p><a href="{{ password }}">{{ text_change_password_desc }}</a></p>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ payment }}"><img src="application/view/image/account/icons/payment_methods.svg" alt="{{ text_payment_methods }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ payment }}">{{ text_payment_methods }}</a></h4>
                  <p><a href="{{ payment }}">{{ text_payment_methods_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ showcase }}"><img src="application/view/image/account/icons/showcase.svg" alt="{{ text_showcase }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ showcase }}">{{ text_showcase }}</a></h4>
                  <p><a href="{{ showcase }}">{{ text_showcase_desc }}</a></p>
                </div>
              </div>
            </div>
          </div>

          <div class="row">
            {% if not partner_status %}
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ partner }}"><img src="application/view/image/account/icons/partner_up.svg" alt="{{ text_partner_up_desc }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ partner }}">{{ text_partner_up }}</a></h4>
                    <p><a href="{{ partner }}">{{ text_partner_up_desc }}</a></p>
                  </div>
                </div>
              </div>
            {% else %}
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ partner }}"><img src="application/view/image/account/icons/partner_edit.svg" alt="{{ text_partner_edit }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ partner }}">{{ text_partner_edit }}</a></h4>
                    <p><a href="{{ partner }}">{{ text_partner_edit_desc }}</a></p>
                  </div>
                </div>
              </div>
            {% endif %}
          </div>

          {% if moderator %}
            <h2>{{ text_cloud_stores_section }}</h2>
            <div class="row">
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ subscription }}"><img src="application/view/image/account/icons/showcase.svg" alt="{{ text_cloud_stores }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ subscription }}">{{ text_cloud_stores }}</a></h4>
                    <p><a href="{{ subscription }}">{{ text_cloud_subscriptions_desc }}</a></p>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

          <h2>{{ text_purchases_section }}</h2>
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ order }}"><img src="application/view/image/account/icons/your_orders.svg" alt="{{ text_your_orders }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ order }}">{{ text_your_orders }}</a></h4>
                  <p><a href="{{ order }}">{{ text_your_orders_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ download }}"><img src="application/view/image/account/icons/your_downloads.svg" alt="{{ text_your_downloads }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ download }}">{{ text_your_downloads }}</a></h4>
                  <p><a href="{{ download }}">{{ text_your_downloads_desc }}</a></p>
                </div>
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ store }}"><img src="application/view/image/account/icons/your_stores.svg" alt="{{ text_your_stores }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ store }}">{{ text_your_stores }}</a></h4>
                  <p><a href="{{ store }}">{{ text_your_stores_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ rating }}"><img src="application/view/image/account/icons/rate_your_downloads.svg" alt="{{ text_rate_downloads }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ rating }}">{{ text_rate_downloads }}</a></h4>
                  <p><a href="{{ rating }}">{{ text_rate_downloads_desc }}</a></p>
                </div>
              </div>
            </div>
          </div>

          <h2>{{ text_extensions_section }}</h2>
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ extension }}"><img src="application/view/image/account/icons/manage_your_extentions.svg" alt="{{ text_manage_extensions }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ extension }}">{{ text_manage_extensions }}</a></h4>
                  <p><a href="{{ extension }}">{{ text_manage_extensions_desc }}</a></p>
                </div>
              </div>
            </div>

            {% if not seller_status %}
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ seller }}"><img src="application/view/image/account/icons/apply_to_become_a_seller.svg" alt="{{ text_apply_seller }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ seller }}">{{ text_apply_seller }}</a></h4>
                    <p><a href="{{ seller }}">{{ text_apply_seller_desc }}</a></p>
                  </div>
                </div>
              </div>
            {% else %}
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ seller }}"><img src="application/view/image/account/icons/apply_to_become_a_seller.svg" alt="{{ text_edit_seller }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ seller }}">{{ text_edit_seller }}</a></h4>
                    <p><a href="{{ seller }}">{{ text_edit_seller_desc }}</a></p>
                  </div>
                </div>
              </div>
            {% endif %}

          </div>

          {% if seller_status %}
            <div class="row">
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ sale }}"><img src="application/view/image/account/icons/sales.svg" alt="{{ text_sales }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ sale }}">{{ text_sales }}</a></h4>
                    <p><a href="{{ sale }}">{{ text_sales_desc }}</a></p>
                  </div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ transaction }}"><img src="application/view/image/account/icons/transactions.svg" alt="{{ text_transactions }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ transaction }}">{{ text_transactions }}</a></h4>
                    <p><a href="{{ transaction }}">{{ text_transactions_desc }}</a></p>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

          {% if false %}
            <div class="row">
              <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ promotion }}"><img src="application/view/image/account/icons/promote-extensions.png" alt="{{ text_promote_extensions }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ promotion }}">{{ text_promote_extensions }}</a></h4>
                    <p></p>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}

          {% if comment %}
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ comment }}"><img src="application/view/image/account/icons/manage_your_extensions_comments.svg" alt="{{ text_manage_comments }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ comment }}">{{ text_manage_comments }}</a></h4>
                  <p><a href="{{ comment }}">{{ text_manage_comments_desc }}</a></p>
                </div>
              </div>
            </div>
          </div>
          {% endif %}
          
          {% if cloud %}
          <h2>{{ text_cloud_stores_section }}</h2>
          <div class="row">
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ subscription }}"><img src="application/view/image/account/icons/cloud_stores.svg" alt="{{ text_cloud_stores }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ subscription }}">{{ text_cloud_stores }}</a></h4>
                  <p><a href="{{ subscription }}">{{ text_cloud_stores_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="media">
                <div class="media-left"><a href="{{ subscription_domain }}"><img src="application/view/image/account/icons/cloud_stores.svg" alt="{{ text_cloud_domains }}" class="media-object"/></a></div>
                <div class="media-body">
                  <h4 class="media-heading"><a href="{{ subscription_domain }}">{{ text_cloud_domains }}</a></h4>
                  <p><a href="{{ subscription_domain }}">{{ text_cloud_domains_desc }}</a></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
                <div class="media">
                  <div class="media-left"><a href="{{ subscription_invoice }}"><img src="application/view/image/account/icons/invoices.svg" alt="{{ text_invoices }}" class="media-object"/></a></div>
                  <div class="media-body">
                    <h4 class="media-heading"><a href="{{ subscription_invoice }}">{{ text_invoices }}</a></h4>
                    <p><a href="{{ subscription_invoice }}">{{ text_invoices_desc }}</a></p>
                  </div>
                </div>
              </div>
          </div>
          {% endif %}
        </div>
      
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}
      <p><a href="/index.php?route=marketplace/extension/info&extension_id=38358"><img width="100%" src="application/view/image/banner/paypal_banner.jpg" alt="paypal"/></a></p>
      </div>
    </div>
  </div>
</div>
{{ footer }}
