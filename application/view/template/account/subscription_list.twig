{{ header }}
<div id="account-subscription">
    <div class="page-header">
        <div class="container">
            <h1>{{ heading_title }}</h1>
            <p>{{ text_lead }}</p>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-md-9">
                <h2>{{ heading_title }}</h2>
                <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ text_cloud_unavailable }}</div>
                {% if error_warning %}
                    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
                {% endif %}
                {% if success %}
                    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
                {% endif %}
                <div class="table-responsive">
                    <table id="subscription-table" class="table table-bordered table-hover">
                        {% if subscriptions %}
                            <thead>
                            <tr>
                                <th class="text-left">{{ column_store_name }}</th>
                                <th class="text-left">{{ column_plan }}</th>
                                <th class="text-center">{{ column_status }}</th>
                                <th class="text-left">{{ column_created }}</th>
                                <th class="text-right">{{ column_action }}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for subscription in subscriptions %}
                                <tr>
                                    <td class="text-left">{{ subscription.name }}</td>
                                    <td class="text-left">{{ subscription.subscription_plan }}</td>
                                    <td class="text-center">
                                        <span {% if subscription.subscription_status_id == subscription_active_status %}class="label label-success"{% else %}class="label label-danger"{% endif %}>{{ subscription.subscription_status }}</span>
                                    </td>
                                    <td class="text-left">{{ subscription.date_added }}</td>
                                    <td class="text-right">
                                        <div class="btn-group dropdown">
                                            <button class="btn btn-default"
                                                type="button"
                                                data-toggle="dropdown">
                                                <span>{{ button_actions }} <span class="caret"></span></span>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a href="{{ subscription.backup }}"><i class="fa fa-file" aria-hidden="true"></i> {{ button_filebase_backup }}</a></li>
                                                <li><a href="{{ subscription.database_backup }}"><i class="fa fa-database" aria-hidden="true"></i> {{ button_database_backup }}</a></li>
                                                <li><a href="{{ subscription.history_url }}"><i class="fa fa-list" aria-hidden="true"></i> {{ button_view_log }}</a></li>
                                            </ul>
                                        </div>
                                        <a href="{{ subscription.view }}" class="btn btn-info button-click-load"
                                           data-toggle="tooltip" data-placement="top" title="{{ button_edit_store }}">{{ button_edit }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        {% else %}
                            <tbody>
                            <tr>
                                <td class="text-center">{{ text_no_stores }}</td>
                            </tr>
                            </tbody>
                        {% endif %}
                    </table>
                </div>
                <nav>{{ pagination }}</nav>
                <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
                </div>
            </div>
            <div class="col-md-3 hidden-xs">{{ menu }}</div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $('.table-responsive').on('show.bs.dropdown', function () {
     $('.table-responsive').css( "overflow", "inherit" );
    });

    $('.table-responsive').on('hide.bs.dropdown', function () {
        $('.table-responsive').css( "overflow", "auto" );
    })
</script>
{{ footer }}
