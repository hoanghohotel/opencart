{{ header }}
<div id="account-edit">
	<div class="container">
		<div class="row">
			<div class="col-sm-9">
				<h1>{{ heading_title }}</h1>
				{% if error_warning %}
					<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
						<button type="button" class="close" data-dismiss="alert">&times;</button>
					</div>
				{% endif %}
				<form action="{{ action }}" method="post" enctype="multipart/form-data">
					<fieldset>
						<legend>{{ text_account_details }}</legend>
						<div class="form-group">
							<label for="input-username">{{ entry_username }}</label> <input type="text" name="username" value="{{ username }}" placeholder="{{ entry_username }}" id="input-username" class="form-control"/>
							{% if error_username %}
								<div class="text-danger">{{ error_username }}</div>
							{% endif %}
						</div>
						<div class="row">
							<div class="col-sm-6">
								<div class="form-group required">
									<label class="control-label" for="input-firstname">{{ entry_firstname }}</label> <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control"/>
									{% if error_firstname %}
										<div class="text-danger">{{ error_firstname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group required">
									<label class="control-label" for="input-lastname">{{ entry_lastname }}</label> <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control"/>
									{% if error_lastname %}
										<div class="text-danger">{{ error_lastname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group">
									<label class="control-label" for="input-company">{{ entry_company }}</label> <input type="text" name="company" value="{{ company }}" placeholder="{{ entry_company_placeholder }}" id="input-company" class="form-control"/>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group">
									<label class="control-label" for="input-tax-id">{{ entry_tax_id }}</label> <input type="text" name="tax_id" value="{{ tax_id }}" placeholder="{{ entry_tax_id }}" id="input-tax-id" class="form-control"/>
								</div>
							</div>
						</div>
						<div class="form-group required">
							<label for="input-email">{{ entry_email }}</label> <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control"/>
							{% if error_email %}
								<div class="text-danger">{{ error_email }}</div>
							{% endif %}
						</div>

						<div class="form-group required">
							<label class="control-label" for="input-country">{{ entry_country }}</label> <select name="country_id" id="input-country" class="form-control">
								<option value=""></option>
								{% for country in countries %}
									{% if country.country_id == country_id %}
										<option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
									{% else %}
										<option value="{{ country.country_id }}">{{ country.name }}</option>
									{% endif %}
								{% endfor %}
							</select>
							{% if error_country %}
								<div class="text-danger">{{ error_country }}</div>
							{% endif %}
						</div>
					</fieldset>
					<fieldset>
						<legend>{{ text_profile_picture }}</legend>
						<div class="form-group">
							<div class="row">
								<div class="col-sm-4">
									<div class="thumbnail"><img src="{{ thumb }}" alt="" title="" id="thumb-image"/> <input type="hidden" name="image" value="{{ image }}" id="input-image"/></div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-2">
									<button type="button" data-toggle="image" data-target="#input-image" data-thumb="#thumb-image" class="btn btn-success btn-block">{{ button_browse }}</button>
								</div>
								<div class="col-sm-2">
									<button type="button" data-toggle="clear" data-target="#input-image" data-thumb="#thumb-image" data-placeholder="{{ placeholder }}" class="btn btn-default btn-block">{{ button_clear }}</button>
								</div>
							</div>
						</div>
					</fieldset>
					<fieldset>
						<legend>{{ text_notification }}</legend>
						<div class="form-group">
							<div class="row">
								<div class="col-sm-6">
									<p class="form-control-static control-label">{{ text_notify_updates }}</p>
								</div>
								<div class="col-sm-6 text-right">
									<div class="radio">
										{% if notify %}
											<label class="radio-inline"><input type="radio" name="notify" value="1" checked="checked"/> {{ text_yes }}</label>
										{% else %}
											<label class="radio-inline"><input type="radio" name="notify" value="1"/> {{ text_yes }}</label>
										{% endif %}
										{% if not notify %}
											<label class="radio-inline"><input type="radio" name="notify" value="0" checked="checked"/> {{ text_no }}</label>
										{% else %}
											<label class="radio-inline"><input type="radio" name="notify" value="0"/> {{ text_no }}</label>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</fieldset>
					<div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
						<button type="submit" class="btn btn-primary">{{ button_submit }}</button>
					</div>
				</form>
			</div>
			<div class="col-sm-3 hidden-xs">{{ menu }}</div>
		</div>
	</div>
</div>
{{ footer }}
