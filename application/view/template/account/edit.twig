{{ header }}
<div id="account-edit">
	<div class="container">
		<div class="row">
			<div class="col-sm-9">
				<h1>Edit My Information</h1>
				{% if error_warning %}
					<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
						<button type="button" class="close" data-dismiss="alert">&times;</button>
					</div>
				{% endif %}
				<form action="{{ action }}" method="post" enctype="multipart/form-data">
					<fieldset>
						<legend>Edit your account details</legend>
						<div class="form-group">
							<label for="input-username">Username</label> <input type="text" name="username" value="{{ username }}" placeholder="Username" id="input-username" class="form-control"/>
							{% if error_username %}
								<div class="text-danger">{{ error_username }}</div>
							{% endif %}
						</div>
						<div class="row">
							<div class="col-sm-6">
								<div class="form-group required">
									<label class="control-label" for="input-firstname">First Name</label> <input type="text" name="firstname" value="{{ firstname }}" placeholder="First Name" id="input-firstname" class="form-control"/>
									{% if error_firstname %}
										<div class="text-danger">{{ error_firstname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group required">
									<label class="control-label" for="input-lastname">Last Name</label> <input type="text" name="lastname" value="{{ lastname }}" placeholder="Last Name" id="input-lastname" class="form-control"/>
									{% if error_lastname %}
										<div class="text-danger">{{ error_lastname }}</div>
									{% endif %}
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group">
									<label class="control-label" for="input-company">Company</label> <input type="text" name="company" value="{{ company }}" placeholder="Company Name" id="input-company" class="form-control"/>
								</div>
							</div>
							<div class="col-sm-6">
								<div class="form-group">
									<label class="control-label" for="input-tax-id">Tax ID</label> <input type="text" name="tax_id" value="{{ tax_id }}" placeholder="Tax ID" id="input-tax-id" class="form-control"/>
								</div>
							</div>
						</div>
						<div class="form-group required">
							<label for="input-email">E-Mail</label> <input type="text" name="email" value="{{ email }}" placeholder="E-Mail" id="input-email" class="form-control"/>
							{% if error_email %}
								<div class="text-danger">{{ error_email }}</div>
							{% endif %}
						</div>

						<div class="form-group required">
							<label class="control-label" for="input-country">Country</label> <select name="country_id" id="input-country" class="form-control">
								<option value=""></option>
								{% for country in countries %}
									{% if country.country_id == country_id %}
										<option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
									{% else %}
										<option value="{{ country.country_id }}">{{ country.name }}</option>
									{% endif %}
								{% endfor %}
							</select>
							{% if error_country %}
								<div class="text-danger">{{ error_country }}</div>
							{% endif %}
						</div>
					</fieldset>
					<fieldset>
						<legend>Profile Picture</legend>
						<div class="form-group">
							<div class="row">
								<div class="col-sm-4">
									<div class="thumbnail"><img src="{{ thumb }}" alt="" title="" id="thumb-image"/> <input type="hidden" name="image" value="{{ image }}" id="input-image"/></div>
								</div>
							</div>
							<div class="row">
								<div class="col-sm-2">
									<button type="button" data-toggle="image" data-target="#input-image" data-thumb="#thumb-image" class="btn btn-success btn-block">Browse</button>
								</div>
								<div class="col-sm-2">
									<button type="button" data-toggle="clear" data-target="#input-image" data-thumb="#thumb-image" data-placeholder="{{ placeholder }}" class="btn btn-default btn-block">Clear</button>
								</div>
							</div>
						</div>
					</fieldset>
					<fieldset>
						<legend>Notification Preferences</legend>
						<div class="form-group">
							<div class="row">
								<div class="col-sm-6">
									<p class="form-control-static control-label">Notify Extension Updates</p>
								</div>
								<div class="col-sm-6 text-right">
									<div class="radio">
										{% if notify %}
											<label class="radio-inline"><input type="radio" name="notify" value="1" checked="checked"/> Yes</label>
										{% else %}
											<label class="radio-inline"><input type="radio" name="notify" value="1"/> Yes</label>
										{% endif %}
										{% if not notify %}
											<label class="radio-inline"><input type="radio" name="notify" value="0" checked="checked"/> No</label>
										{% else %}
											<label class="radio-inline"><input type="radio" name="notify" value="0"/> No</label>
										{% endif %}
									</div>
								</div>
							</div>
						</div>
					</fieldset>
					<div class="text-right"><a href="{{ cancel }}" class="btn btn-link">Cancel</a>
						<button type="submit" class="btn btn-primary">Submit</button>
					</div>
				</form>
			</div>
			<div class="col-sm-3 hidden-xs">{{ menu }}</div>
		</div>
	</div>
</div>
{{ footer }}
