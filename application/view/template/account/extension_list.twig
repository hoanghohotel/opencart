{{ header }}
<div id="account-extension">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_header }}</h1>
      <p>{{ text_lead }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <h2>{{ heading_title }}</h2>
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i>{{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        {% if not seller_approved %}
          <div class="alert alert-warning"><i class="fa fa-clock-o"></i> {{ text_seller_pending_notice }} <a href="{{ seller_apply_href }}" class="alert-link">{{ text_seller_account_link }}</a></div>
        {% endif %}
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-extension">
          <div class="table-responsive">
            <table id="extension-list" class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th class="text-left">{{ column_name }}</th>
                  <th class="text-left">{{ column_status }}</th>
                  <th class="text-left">{{ column_date_added }}</th>
                  <th class="text-right">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
                {% if extensions %}
                  {% for extension in extensions %}
                    <tr>
                      <td class="text-left">{{ extension.name }}</td>
                      <td class="text-left">{% if extension.publish and extension.status and seller_approved %}<span class="label label-success">{{ text_enabled }}</span>{% elseif extension.publish %}<span class="label label-warning">{{ text_pending_approval }}</span>{% else %}<span class="label label-danger">{{ text_disabled }}</span>{% endif %}</td>
                      <td class="text-left">{{ extension.date_added }}</td>
                      <td class="text-right"><a href="{{ extension.view }}" class="btn btn-info">{{ button_view }}</a> <a href="{{ extension.edit }}" class="btn btn-primary">{{ button_edit }}</a> <button type="submit" formaction="{{ extension.delete }}" data-csrf-post="{{ extension.delete }}" onclick="return confirm('{{ text_confirm }}')" class="btn btn-danger">{{ button_delete }}</button></td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr>
                    <td class="text-center" colspan="4">{{ text_no_results }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          <nav>{{ pagination }}</nav>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> <a href="{{ add }}" class="btn btn-primary">{{ button_add }}</a></div>
        </form>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
