{{ header }}
<div id="account-pin">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <h3>{{ heading_title }}</h3>
        <p>{{ text_pin_desc }}</p>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label for="input-pin">{{ entry_pin }}</label> <input type="password" name="pin" value="{{ pin }}" placeholder="{{ entry_pin }}" id="input-pin" class="form-control"/>
            {% if error_pin %}
              <div class="text-danger">{{ error_pin }}</div>
            {% endif %}
          </div>
          <input type="hidden" name="redirect" value="{{ redirect }}"/>
          <button type="submit" class="btn btn-primary btn-lg">{{ button_submit }}</button>
        </form>
      </div>
      <div class="col-md-4">
        <div id="side-banner">{{ banner }}</div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
