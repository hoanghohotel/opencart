{{ header }}
<div id="account-edit">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_your_domains }}</h1>
      <p>{{ text_register_domain_lead }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-9">
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <div class="alert alert-info">
         <p>
         <i class="fa fa-info-circle"></i> 
          {{ text_domain_info_1 }}
         </p>
         <p>
          {{ text_domain_info_2 }}
         </p>
         <p>
          {{ text_domain_info_3 }}
         </p>
         <p>
          {{ text_domain_connect_prefix }} <a href="{{ subscription_list }}">{{ text_here }}</a>
         </p>
				</div>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <fieldset>
            <legend>{{ text_add_your_domain }}</legend>
            <div class="form-group">
              <label for="input-domain">{{ entry_domain_name_example }}</label><input type="text" name="cloud_domain" value="{{ cloud_domain }}" placeholder="{{ entry_domain_placeholder }}" id="input-cloud-domain" class="form-control"/>
              {% if error_cloud_domain %}
                <div class="text-danger">{{ error_cloud_domain }}</div>
              {% endif %}</div>
          </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
            <button type="submit" class="btn btn-primary">{{ button_submit }}</button>
          </div>
        </form>
      </div>
      <div class="col-sm-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
