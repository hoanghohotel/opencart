{{ header }}
<div id="account-seller">
  <div class="page-header">
    <div class="container">
      {% if route == 'account/seller/add' %}
        <h1>{{ heading_add }}</h1>
        <p>{{ text_subtitle_add }}</p>
      {% else %}
        <h1>{{ heading_title }}</h1>
        <p>{{ text_subtitle_edit }}</p>
      {% endif %}</div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-9">
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
              <button type="button" class="close" data-dismiss="alert">&times;</button>
            </div>
          {% endif %}
          {% if seller_pending %}
            <div class="alert alert-warning"><i class="fa fa-clock-o"></i> {{ text_pending_approval }}</div>
          {% endif %}
          {% if route == 'account/seller/add' %}
            <fieldset>
              <legend>{{ text_register_seller }}</legend>
              <p>{{ text_register_seller_desc }}</p>
              <h4><strong>{{ text_how_it_works }}</strong></h4>

            </fieldset>
          {% endif %}
          <fieldset>
            {% if route == 'account/seller/add' %}
              <legend>{{ text_fill_details }}</legend>
            {% else %}
              <legend>{{ text_edit_details }}</legend>
            {% endif %}

            <div class="alert alert-info">
              <ol>
                <li>{{ text_rule_1 }}</li>
                <li>{{ text_rule_2 }}</li>
                <li>{{ text_rule_3 }}</li>
                <li>{{ text_rule_4 }}</li>
                <li>{{ text_rule_5 }}</li>
                <li>{{ text_rule_6 }}</li>
              </ol>
            </div>

            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-firstname">{{ entry_firstname }}</label> <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control"/>
                  {% if error_firstname %}
                    <div class="text-danger">{{ error_firstname }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-lastname">{{ entry_lastname }}</label> <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control"/>
                  {% if error_lastname %}
                    <div class="text-danger">{{ error_lastname }}</div>
                  {% endif %}</div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-email">{{ entry_email }}</label> <input type="text" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control"/>
                  {% if error_email %}
                    <div class="text-danger">{{ error_email }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-email">{{ entry_support_email }}</label> <input type="text" name="support_email" value="{{ support_email }}" placeholder="{{ entry_support_email }}" id="input-support-email" class="form-control"/>
                  {% if error_support_email %}
                    <div class="text-danger">{{ error_support_email }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-telephone">{{ entry_telephone }}</label> <input type="text" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control"/>
                  <div class="help-block">{{ help_telephone }}</div>
                  {% if error_telephone %}
                    <div class="text-danger">{{ error_telephone }}</div>
                  {% endif %}</div>
              </div>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label class="control-label" for="input-website">{{ entry_website }}</label> <input type="text" name="website" value="{{ website }}" placeholder="{{ entry_website }}" id="input-website" class="form-control"/>
                </div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_payment_info }}</legend>
            <p>{{ text_payment_info_desc }}</p>
            <div class="row hidden">
              <div class="col-sm-6 text-center">
                <p><a href="https://www.paypal.com/uk/mrb/pal=V4T754QB63XXL" target="_blank" class="thumbnail"><img src="application/view/image/account/paypal-logo.png" alt="PayPal" title="PayPal"/></a></p>
              </div>
              <div class="col-sm-6 text-center">
                <p><a href="https://share.payoneer.com/nav/AHlXyQ3JFmbjVlbUgLbWuERqzrcggDlctg_tnsHl3_oAgDZNkqXK0whqGuElt0n-fnats8u-rZqbzefA9ShMMw2" target="_blank" class="thumbnail"><img src="application/view/image/account/payoneer-logo.png" alt="Payoneer" title="Payoneer"/></a></p>
              </div>
            </div>
            <br/>
            <div class="row payment-method">
              <div class="col-sm-12">
                <label class="control-label">{{ entry_payment_method }}</label>
                <div class="row">
                  <div class="col-sm-6">
                    {% if payment_method == 'paypal' %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="paypal" checked="checked"/> <img src="application/view/image/account/paypal-logo.png" alt="PayPal" title="PayPal"/></label>
                      </div>
                    {% else %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="paypal"/> <img src="application/view/image/account/paypal-logo.png" alt="PayPal" title="PayPal"/></label>
                      </div>
                    {% endif %}
                  </div>
                  <div class="col-sm-6">
                    <div class="text-right">
                      <small>({{ text_signup_before }} <a href="https://www.paypal.com/uk/mrb/pal=V4T754QB63XXL" target="_blank">{{ text_paypal_account }}</a> {{ text_signup_after }})</small>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-sm-6">
                    {% if payment_method == 'payoneer' %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="payoneer" checked="checked"/> <img src="application/view/image/account/payoneer-logo.png" alt="Payoneer" title="Payoneer"/></label>
                      </div>
                    {% else %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="payoneer"/> <img src="application/view/image/account/payoneer-logo.png" alt="Payoneer" title="Payoneer"/></label>
                      </div>
                    {% endif %}
                  </div>
                  <div class="col-sm-6">
                    <div class="text-right">
                      <small>({{ text_signup_before }} <a href="{{ payoneer }}" target="_blank">{{ text_payoneer_account }}</a> {{ text_signup_after }})</small>
                    </div>
                  </div>
                </div>
                <div class="row">
                  <div class="col-sm-8">
                    {% if payment_method == 'advcash' %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="advcash" checked="checked"/> <img src="application/view/image/account/advcash-logo.png" alt="AdvCash" title="AdvCash"/><span class="text-danger"> {{ text_advcash_note }}</span></label>
                      </div>
                    {% else %}
                      <div class="radio">
                        <label><input type="radio" name="payment_method" value="advcash"/> <img src="application/view/image/account/advcash-logo.png" alt="AdvCash" title="AdvCash"/><span class="text-danger"> {{ text_advcash_note }}</span></label>
                      </div>
                    {% endif %}
                  </div>
                  <div class="col-sm-4">
                    <div class="text-right">
                      <small>({{ text_signup_before }} <a href="https://wallet.advcash.com/register" target="_blank">{{ text_advcash_account }}</a> {{ text_signup_after }})</small>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            {% if payoneer_token %}
            <div class="row">
              <div class="col-sm-6">
                <label class="control-label" for="input-payment-email">{{ entry_payoneer_token }}</label> 
                <input type="text" value="{{ payoneer_token }}" disabled class="form-control"/>
              </div>
            </div>
            {% endif %}
            <div class="row">
              <div class="col-sm-6">
                <label class="control-label" for="input-payment-email">{{ entry_payment_email }}</label> <input type="text" name="payment_email" value="{{ payment_email }}" placeholder="{{ entry_payment_placeholder }}" id="input-payment-email" class="form-control"/>
                <div class="help-block">{{ help_payment_email }}</div>
                {% if error_payment_email %}
                  <div class="text-danger">{{ error_payment_email }}</div>
                {% endif %}
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_address }}</legend>
            <div class="form-group">
              <label class="control-label" for="input-company">{{ entry_company }}</label> <input type="text" name="company" value="{{ company }}" placeholder="{{ entry_company }}" id="input-company" class="form-control"/>
            </div>
            <div class="form-group required">
              <label class="control-label" for="input-address-1">{{ entry_address_1 }}</label> <input type="text" name="address_1" value="{{ address_1 }}" placeholder="{{ entry_address_1 }}" id="input-address-1" class="form-control"/>
              {% if error_address_1 %}
                <div class="text-danger">{{ error_address_1 }}</div>
              {% endif %}</div>
            <div class="form-group">
              <label class="control-label" for="input-address-2">{{ entry_address_2 }}</label> <input type="text" name="address_2" value="{{ address_2 }}" placeholder="{{ entry_address_2 }}" id="input-address-2" class="form-control"/>
            </div>
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-city">{{ entry_city }}</label> <input type="text" name="city" value="{{ city }}" placeholder="{{ entry_city }}" id="input-city" class="form-control"/>
                  {% if error_city %}
                    <div class="text-danger">{{ error_city }}</div>
                  {% endif %}</div>
              </div>
              <div class="col-sm-6">
                <div class="form-group required">
                  <label class="control-label" for="input-postcode">{{ entry_postcode }}</label> <input type="text" name="postcode" value="{{ postcode }}" placeholder="{{ entry_postcode }}" id="input-postcode" class="form-control"/>
                  {% if error_postcode %}
                    <div class="text-danger">{{ error_postcode }}</div>
                  {% endif %}</div>
              </div>
            </div>
            <div class="form-group required">
              <label class="control-label" for="input-country">{{ entry_country }}</label> <select name="country_id" id="input-country" class="form-control">
                <option value=""></option>
                {% for country in countries %}
                  {% if country.country_id == country_id %}
                    <option value="{{ country.country_id }}" selected="selected">{{ country.name }}</option>
                  {% else %}
                    <option value="{{ country.country_id }}">{{ country.name }}</option>
                  {% endif %}
                {% endfor %}
              </select>
              {% if error_country %}
                <div class="text-danger">{{ error_country }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-zone">{{ entry_zone }}</label> <select name="zone_id" id="input-zone" class="form-control"></select>
              {% if error_zone %}
                <div class="text-danger">{{ error_zone }}</div>
              {% endif %}</div>
          </fieldset>
          <fieldset>
            <legend>{{ text_seller_preferences }}</legend>
            <div class="row">
              <div class="col-sm-6">
                <dl>
                  <dt>{{ text_notify_purchase }}</dt>
                  <dd>{{ text_notify_purchase_desc }}</dd>
                </dl>
              </div>
              <div class="col-sm-6 text-right">
                <div class="radio">
                  <label class="radio-inline">
                    {% if notify %}
                      <input type="radio" name="notify" value="1" checked="checked"/>
                      {{ text_yes }}
                    {% else %}
                      <input type="radio" name="notify" value="1"/>
                      {{ text_yes }}
                    {% endif %}
                  </label> <label class="radio-inline">
                    {% if not notify %}
                      <input type="radio" name="notify" value="0" checked="checked"/>
                      {{ text_no }}
                    {% else %}
                      <input type="radio" name="notify" value="0"/>
                      {{ text_no }}
                    {% endif %}
                  </label>
                </div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_seller_api }}</legend>
            <div class="form-group required">
              <label class="control-label" for="input-api-url">{{ entry_api_status }}</label>
              <div class="radio">
                <label class="radio-inline">
                  {% if api_status %}
                    <input type="radio" name="api_status" value="1" checked="checked"/>
                    {{ text_yes }}
                  {% else %}
                    <input type="radio" name="api_status" value="1"/>
                    {{ text_yes }}
                  {% endif %}
                </label> <label class="radio-inline">
                  {% if not api_status %}
                    <input type="radio" name="api_status" value="0" checked="checked"/>
                    {{ text_no }}
                  {% else %}
                    <input type="radio" name="api_status" value="0"/>
                    {{ text_no }}
                  {% endif %}
                </label>
              </div>
            </div>
            <div class="form-group required">
              <label class="control-label" for="input-api-url">{{ entry_api_url }}</label> <input type="text" name="api_url" value="{{ api_url }}" placeholder="{{ entry_api_url }}" id="input-api-url" class="form-control"/>
              {% if error_api_url %}
                <div class="text-danger">{{ error_api_url }}</div>
              {% endif %}
            </div>
          </fieldset>
            <fieldset>
              <legend>{{ text_terms }}</legend>
              <textarea class="form-control" rows="8" readonly="readonly">
  {{ text_terms_intro }}

  {{ text_terms_1 }}

  {{ text_terms_2 }}

  {{ text_terms_3 }}

  {{ text_terms_4 }}

  {{ text_terms_5 }}

  {{ text_terms_6 }}

  {{ text_terms_7 }}
  
  {{ text_terms_8 }}

  {{ text_terms_9 }}

  {{ text_terms_10 }}
  </textarea>
              {% if route == 'account/seller/add' %}
              <div class="checkbox">
                <label>
                  {% if agree %}
                    <input type="checkbox" name="agree" value="1" checked="checked"/>
                  {% else %}
                    <input type="checkbox" name="agree" value="1"/>
                  {% endif %}
                  {{ text_agree }}</label>
              </div>
              {% endif %}
            </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
            <button type="submit" class="btn btn-primary">{{ button_submit }}</button>
          </div>
        </form>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('select[name=\'country_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=localisation/country&country_id=' + this.value,
		dataType: 'json',
		beforeSend: function() {
			$('select[name=\'zone_id\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'zone_id\']').prop('disabled', false);
		},
		success: function(json) {
			if (json['postcode_required'] == '1') {
				$('input[name=\'postcode\']').parent().addClass('required');
			} else {
				$('input[name=\'postcode\']').parent().removeClass('required');
			}

			html = '<option value=""></option>';

			if (json['zone'] && json['zone'] != '') {
				for (i = 0; i < json['zone'].length; i++) {
					html += '<option value="' + json['zone'][i]['zone_id'] + '"';

					if (json['zone'][i]['zone_id'] == '{{ zone_id }}') {
						html += ' selected="selected"';
					}

					html += '>' + json['zone'][i]['name'] + '</option>';
				}
			} else {
				html += '<option value="0" selected="selected">{{ text_none|e('js') }}</option>';
			}

			$('select[name=\'zone_id\']').html(html);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name=\'country_id\']').trigger('change');
//--></script>
{{ footer }}
