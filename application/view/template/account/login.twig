{{ header }}
<div id="account-login">
  <div class="page-header">
    <div class="container">
      <h1>Log in to your OpenCart account</h1>
    </div>
  </div>
  <div class="container">
    {% if error_warning %}
      <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="row">
      <div class="col-sm-6 col-md-6">
        <h3>Login</h3>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <div class="form-group">
            <label for="input-email">Email</label> <input type="text" name="email" value="{{ email }}" placeholder="Email" id="input-email" class="form-control"/>
          </div>
          <div class="form-group">
            <label for="input-password">Password</label> <input type="password" name="password" value="{{ password }}" placeholder="Password" id="input-password" class="form-control"/>
          </div>
          <div class="row">
            <div class="col-sm-6">
              <button type="submit" class="btn btn-primary btn-lg hidden-xs">Login</button>
              <button type="submit" class="btn btn-primary btn-lg btn-block visible-xs-block">Login</button>
            </div>
            <div class="col-sm-6 text-right"><a href="{{ forgotten }}" class="btn-link">Forgot your password?</a></div>
          </div>
          <input type="hidden" name="redirect" value="{{ redirect }}"/>
        </form>
      </div>
      <div class="col-sm-6 col-md-6">
        <h3 class="right">Do not have an account?</h3>
        <p><a href="{{ register }}">Create an OpenCart account</a>. By creating an account with our store, you will be able to download more features through marketplace, uploading showcase and become Partner and Seller.
          <br/>
        </p>
        <div id="need-help" class="media">
          <div class="media-left"><img src="application/view/image/account/icon_ds_star.png" alt="" title=""/></div>
          <div class="media-body">Looking for professional support for your project?
            <br/>
            OpenCart now offers dedicated technical support.
            <p><a href="https://dedicated.opencart.com/">Learn more about Dedicated Support</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
