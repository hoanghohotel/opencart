{{ header }}
<div id="account-password">
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <h2>{{ heading_title }}</h2>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <fieldset>
            <legend>{{ text_password }}</legend>
            <div class="form-group required">
              <label class="control-label" for="input-current">{{ entry_current }}</label>
              <input type="password" name="current" value="{{ current }}" placeholder="{{ entry_current }}" id="input-current" class="form-control" />
              {% if error_current %}
              <div class="text-danger">{{ error_current }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-password">{{ entry_password }}</label>
              <input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password_placeholder }}" id="input-password" class="form-control" />
              {% if error_password %}
              <div class="text-danger">{{ error_password }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-confirm">{{ entry_confirm }}</label>
              <input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm_placeholder }}" id="input-confirm" class="form-control" />
              {% if error_confirm %}
              <div class="text-danger">{{ error_confirm }}</div>
              {% endif %}</div>
          </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
            <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
          </div>
        </form>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
