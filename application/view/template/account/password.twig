{{ header }}
<div id="account-password">
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <h2>Change My Password</h2>
        <form action="{{ action }}" method="post" enctype="multipart/form-data">
          <fieldset>
            <legend>Reset password</legend>
            <div class="form-group required">
              <label class="control-label" for="input-current">Old Password</label>
              <input type="password" name="current" value="{{ current }}" placeholder="Old Password" id="input-current" class="form-control" />
              {% if error_current %}
              <div class="text-danger">{{ error_current }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-password">New Password</label>
              <input type="password" name="password" value="{{ password }}" placeholder="Password" id="input-password" class="form-control" />
              {% if error_password %}
              <div class="text-danger">{{ error_password }}</div>
              {% endif %}</div>
            <div class="form-group required">
              <label class="control-label" for="input-confirm">New Password Confirm</label>
              <input type="password" name="confirm" value="{{ confirm }}" placeholder="Password Confirm" id="input-confirm" class="form-control" />
              {% if error_confirm %}
              <div class="text-danger">{{ error_confirm }}</div>
              {% endif %}</div>
          </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">Cancel</a>
            <button type="submit" class="btn btn-primary">Continue</button>
          </div>
        </form>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
