{{ header }}
<div id="account-showcase">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p></p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">

        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i>{{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}

        <h2>{{ heading_title }}</h2>

        <fieldset>
          <legend>{{ text_submit_store }}</legend>

          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th class="text-left">{{ column_name }}</th>
                  <th class="text-left">{{ column_type }}</th>
                  <th class="text-left">{{ column_status }}</th>
                  <th class="text-left">{{ column_date_added }}</th>
                  <th class="text-right">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
                {% if showcases %}
                  {% for showcase in showcases %}
                    <tr>
                      <td class="text-left">{{ showcase.name }}</td>
                      <td class="text-left">{{ showcase.category }}</td>
                      <td class="text-left"> {% if showcase.status %}<span class="label label-success">{{ text_enabled }}</span>{% else %}<span class="label label-danger">{{ text_disabled }}</span>{% endif %}</td>
                      <td class="text-left">{{ showcase.date_added }}</td>
                      <td class="text-right"><a href="{{ showcase.delete }}" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fa fa-times"></i></a></td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr>
                    <td class="text-center" colspan="5">{{ text_no_results }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          <nav>{{ pagination }}</nav>
        </fieldset>
        <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> <a href="{{ add }}" class="btn btn-primary">{{ button_add }}</a></div>

      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
