{{ header }}
<div id="account-order">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_domains }}</h1>
      <p>{{ text_domains_lead }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <div class="alert alert-info">
         <p>
         <i class="fa fa-info-circle"></i> 
          {{ text_domain_info_1 }}
         </p>
         <p>
          {{ text_domain_info_2 }}
         </p>
         <p>
          {{ text_domain_connect_prefix }} <a href="{{ subscription_list }}">{{ text_here }}</a>
         </p>
         <p>
          <strong>{{ text_domain_initializing_info }}</strong>
         </p>
				</div>
        <fieldset>
          <legend>{{ heading_your_domains }}</legend>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>{{ column_domain }}</th>
                  <th>{{ column_status }}</th>
                  <th class="text-right">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
                {% if domains %}
                  {% for domain in domains %}
                    <tr>
                      <td>{{ domain.name }}</td>
                      <td class="text-center">
                        {% if domain.status == 'initalizing' %}
                          <span class="label label-warning text-uppercase">{{ domain.status }}</span>
                        {% elseif domain.status == 'pending' %}
                          <span class="label label-primary text-uppercase">{{ domain.status }}</span>
                        {% elseif domain.status == 'active' %}
                          <span class="label label-success text-uppercase">{{ domain.status }}</span>
                        {% endif %}</td>
                      <td class="text-right">
                        {% if domain.status != 'initalizing' %}
                        <a href="{{ domain.href }}" data-toggle="tooltip" title="{{ button_get_settings }}" class="btn btn-primary">{{ button_get_settings }}</a>
                        {% endif %}
                        <a href="{{ domain.delete }}" data-toggle="tooltip" title="{{ button_delete_domain }}" class="btn btn-danger"><i class="fa fa-trash-o"></i></a>
                      </td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr>
                    <td class="text-center" colspan="3">{{ text_no_results }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          <nav>{{ pagination }}</nav>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> 
          </div>
        </fieldset>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}

{% if refresh %}
<script>
setTimeout(function() { 
    location.reload();
}, 15000);
</script>
{% endif %}
