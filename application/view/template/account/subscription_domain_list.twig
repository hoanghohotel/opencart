{{ header }}
<div id="account-order">
  <div class="page-header">
    <div class="container">
      <h1>Cloud Domains</h1>
      <p>View the cloud domains you have previously registered</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <div class="alert alert-info">
         <p>
         <i class="fa fa-info-circle"></i> 
          As soon as you add a domain, you will receive DNS records that must be added to your domain's DNS. You can find them by clicking the <strong>"Get Settings"</strong> button in the list of your domains.
         </p>
         <p>
          After the DNS records are added, our system will need time to validate the domain and once the process is completed, its status will change to "Active". This means that the domain is completely ready.
         </p>
         <p>
          You can connect a domain to the store by clicking <a href="{{ subscription_list }}">here</a>
         </p>
         <p>
          <strong>In case your domain status is "initalizing" you should visit this page in few minutes and after it becomes "pending" you would be able to get it's settings.</strong>
         </p>
				</div>
        <fieldset>
          <legend>Your Cloud Domains</legend>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>Domain</th>
                  <th>Status</th>
                  <th class="text-right">Action</th>
                </tr>
              </thead>
              <tbody>
                {% if domains %}
                  {% for domain in domains %}
                    <tr>
                      <td>{{ domain.name }}</td>
                      <td class="text-center">
                        {% if domain.status == 'initalizing' %}
                          <span class="label label-warning text-uppercase">{{ domain.status }}</span>
                        {% elseif domain.status == 'pending' %}
                          <span class="label label-primary text-uppercase">{{ domain.status }}</span>
                        {% elseif domain.status == 'active' %}
                          <span class="label label-success text-uppercase">{{ domain.status }}</span>
                        {% endif %}</td>
                      <td class="text-right">
                        {% if domain.status != 'initalizing' %}
                        <a href="{{ domain.href }}" data-toggle="tooltip" title="Get Settings" class="btn btn-primary">Get Settings</a>
                        {% endif %}
                        <a href="{{ domain.delete }}" data-toggle="tooltip" title="Delete Domain" class="btn btn-danger"><i class="fa fa-trash-o"></i></a>
                      </td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr>
                    <td class="text-center" colspan="3">No results!</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          <nav>{{ pagination }}</nav>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">Cancel</a> 
          {# <a href="{{ add }}" class="btn btn-primary">Add Domain</a> #}
          </div>
        </fieldset>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}

{% if refresh %}
<script>
setTimeout(function() { 
    location.reload();
}, 15000);
</script>
{% endif %}
