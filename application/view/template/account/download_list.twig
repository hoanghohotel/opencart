{{ header }}
<div id="account-download">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_lead }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <h1>{{ heading_title }}</h1>
        {% if downloads %}

          {% for download in downloads %}
            <div id="downloads-list">
              <div class="row">
                <div class="col-sm-4"><img src="{{ download.image }}" alt="{{ download.name }}" title="{{ download.name }}" class="img-responsive"/></div>
                <div class="col-sm-8">
                  <h3>{{ download.name }}</h3>
                  <ul>
                    <li>{{ text_purchased_on }} <strong>{{ download.date_added }}</strong></li>
                    <li>{{ text_last_updated }} <strong>{{ download.date_modified }}</strong></li>
                  </ul>
                  <p id="download-buttons"><a href="{{ download.href }}" class="btn btn-primary btn-sm">{{ button_download_ext }}</a> <a href="{{ download.extension }}" class="btn btn-link">{{ text_extension_page }}</a></p>
                  {% if download.license %}
                    {% if download.valid %}
                      <div class="support-valid-date">
                        <p>{{ text_support_valid }}</p>
                        <h4>{{ download.date_valid }}</h4>
                      </div>
                    {% else %}
                      <div class="support-valid-date support-valid-date-expired">
                        <p>{{ text_support_valid }}</p>
                        <h4>{{ download.date_valid }}</h4>
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}

          <nav>{{ pagination }}</nav>
        {% else %}
        <table class="table table-bordered table-hover">
          <tbody>
            <tr>
              <td class="text-center">{{ text_no_purchases }}</td>
            </tr>
          </tbody>
        </table>
        {% endif %}
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
