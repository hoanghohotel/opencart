<div class="table-responsive">
    <table id="comments-table" class="table table-bstoreed">
    <thead>
        <tr>
            <th>Extension</th>
            <th>Comment</th>
            <th>Member</th>
            <th>Date Added</th>
            <th class="text-right">Action</th>
        </tr>
    </thead>
    <tbody>
        {% if comments %}
        {% for comment in comments %}
            <tr {{ comment.replied ? 'class="success"' : default }}>
                <td><a href="{{ comment.view_extension }}" target="_blank">{{ comment.extension|length > 25 ? comment.extension|slice(0, 22) ~ '...' : comment.extension  }}</a></td>
                <td>{{ comment.text|length > 35 ? comment.text|slice(0, 32) ~ '...' : comment.text  }}</td>
                <td>{{ comment.member }}</td>
                <td>{{ comment.date_added  }}</td>
                <td class="text-right">
                    <a href="{{ comment.reply }}" data-toggle="tooltip" title="Reply" class="btn btn-info btn-sm"><i class="fa fa-reply"></i></a>
                    <a href="{{ comment.delete }}" type="button" id="delete-comment" data-toggle="tooltip" title="Delete Comment" class="btn btn-danger btn-sm"><i class="fa fa-times"></i></a>
                </td>
            </tr>
        {% endfor %}
        {% else %}
        <tr>
            <td class="text-center" colspan="5">No results!</td>
        </tr>
        {% endif %}
    </tbody>
    </table>
</div>
<nav>{{ pagination }}</nav>