{{ header }}
<div id="account-edit">
  <div class="page-header">
    <div class="container">
      <h1>Your Cloud Domains</h1>
      <p>Check the status of your domain for Cloud Store</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-9">
        <div id="validate-alert"></div>
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
          <fieldset>
            <legend>Domain Settings</legend>
            <div class="form-group">
              <label for="input-domain">Domain Name</label>
              <input type="text" disabled value="{{ domain.name }}" class="form-control"/>
            </div>
            <div class="form-group">
              <label for="input-domain">Domain Status</label>
              <div id="domain-status">
                {% if domain.status == 'initalizing' %}
                <span class="badge progress-bar-warning text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% elseif domain.status == 'pending' %}
                <span class="badge progress-bar-info text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% elseif domain.status == 'active' %}
                <span class="badge progress-bar-success text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% endif %}
              </div>
            </div>
            {% if domain.challenge %}
            <div class="form-group">
              <label for="input-domain">Challenge</label>
              <div class="alert alert-info">
                To get ready your domain to be used with your Cloud Store you should add this A records to domain DNS Settings:<br>
                <strong>Type:</strong> A<br>
                <strong>Records:</strong> {% for server in domain.challenge.servers %} {{ server }}{{ not loop.last ? ',' }} {% endfor %}<br>
              </div>
            </div>
            {% endif %}
          </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">Cancel</a>
          </div>
      </div>
      <div class="col-sm-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}

<script>
{# setInterval(function() {
    $.ajax({
        url: '{{ validate }}',
        dataType: 'json',
        method: "get",
        beforeSend: function () {
            $('#validate-alert').html('<div class="alert alert-info"><i class="fa fa-exclamation-circle"></i> Sending validation request...</div>');
        },
        success: function (json) {
            if(json['success']) {
                $('#validate-alert').html('<div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> ' + json['success'] + '</div>');
                console.log(json['status'])
                if(json['status'] == 'active') {
                   $('#domain-status').html('<span class="badge progress-bar-success text-uppercase" style="padding: 10px; 20px;">' + json['status'] + '</span>');
                }
            }

            if(json['error']) {
                $('#validate-alert').html('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + '</div>');
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
}, 1000 * 60 * 0.1); #}

</script>