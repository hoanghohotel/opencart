{{ header }}
<div id="account-edit">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_your_domains }}</h1>
      <p>{{ text_check_domain_lead }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-sm-9">
        <div id="validate-alert"></div>
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
          <fieldset>
            <legend>{{ heading_domain_settings }}</legend>
            <div class="form-group">
              <label for="input-domain">{{ entry_domain_name }}</label>
              <input type="text" disabled value="{{ domain.name }}" class="form-control"/>
            </div>
            <div class="form-group">
              <label for="input-domain">{{ entry_domain_status }}</label>
              <div id="domain-status">
                {% if domain.status == 'initalizing' %}
                <span class="badge progress-bar-warning text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% elseif domain.status == 'pending' %}
                <span class="badge progress-bar-info text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% elseif domain.status == 'active' %}
                <span class="badge progress-bar-success text-uppercase" style="padding: 10px; 20px;">{{ domain.status }}</span>
                {% endif %}
              </div>
            </div>
            {% if domain.challenge %}
            <div class="form-group">
              <label for="input-domain">{{ entry_challenge }}</label>
              <div class="alert alert-info">
                {{ text_challenge_info }}<br>
                <strong>{{ text_dns_type }}</strong> A<br>
                <strong>{{ text_dns_records }}</strong> {% for server in domain.challenge.servers %} {{ server }}{{ not loop.last ? ',' }} {% endfor %}<br>
              </div>
            </div>
            {% endif %}
          </fieldset>
          <div class="text-right"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a>
          </div>
      </div>
      <div class="col-sm-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
