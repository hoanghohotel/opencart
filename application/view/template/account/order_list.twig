{{ header }}
<div id="account-order">
  <div class="page-header">
    <div class="container">
      <h1>{{ heading_title }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">{% if success %}
          <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
            <button type="button" class="close" data-dismiss="alert">&times;</button>
          </div>
        {% endif %}
        <fieldset>
          <legend>{{ text_orders }}</legend>
          <div class="table-responsive">
            <table class="table table-bordered">
              <thead>
                <tr>
                  <th>{{ column_order_id }}</th>
                  <th>{{ column_extension }}</th>
                  <th>{{ column_amount }}</th>
                  <th class="text-center">{{ column_status }}</th>
                  <th>{{ column_date_added }}</th>
                  <th class="text-right">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
                {% if orders %}
                  {% for order in orders %}
                    <tr>
                      <td>{{ order.order_id }}</td>
                      <td>{{ order.extension }}</td>
                      <td>{{ order.total }}</td>
                      <td class="text-center">{% if order.order_status_id == config_download_status_id %}
                          <span class="label label-success">{{ order.status }}</span>
                        {% elseif order.order_status_id == config_order_status_id %}
                          <span class="label label-warning">{{ order.status }}</span>
                        {% else %}
                          <span class="label label-danger">{{ order.status }}</span>
                        {% endif %}</td>
                      <td>{{ order.date_added }}</td>
                      <td class="text-right"><a href="{{ order.href }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info"><i class="fa fa-eye"></i></a></td>
                    </tr>
                  {% endfor %}
                {% else %}
                  <tr>
                    <td class="text-center" colspan="6">{{ text_no_results }}</td>
                  </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
          <nav>{{ pagination }}</nav>
        </fieldset>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
