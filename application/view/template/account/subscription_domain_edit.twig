{{ header }}
<div id="account-subscription-info">
	<div class="container">
		<div class="row">
			<div class="col-md-9">

				<h2>{{ heading_edit_store }}</h2>

				{% if error_warning %}
					<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
				{% endif %}

				<form id="store-domain-edit" method="post" action="">
					<fieldset>
						<legend>{{ text_setup_subscription }}</legend>

						<div class="alert alert-info">
							<p>{{ text_domain_change_wait }}</p>
						</div>

						<div class="form-group">
							<p class="form-static">{{ text_select_store_plan_pay }}</p>
						</div>

						<div id="validation-block"></div>

						<div class="form-group">
							<div class="input-group">
								<div class="input-group-addon">https://</div>
								<input type="text" name="url" class="form-control" value="{{ subscription_store_subdomain }}"
								       id="store_domain" placeholder="{{ entry_store_domain }}">
								<div class="input-group-addon">{{ cloud_store_subdomain }}</div>
								<input name="subscription_store_id" type="hidden" value="{{ subscription_store_id }}">
							</div>
						</div>

						<div class="text-right">
							<a href="{{ back_url }}" class="btn btn-link">{{ button_cancel }}</a>
							<button type="button" id="button-update" class="btn btn-primary"><i
									class="fa fa-plus fa-fw"></i> {{ button_update }}
							</button>
						</div>
					</fieldset>
				</form>

			</div>
			<div class="col-md-3 hidden-xs">{{ menu }}</div>
		</div>
	</div>
</div>
<script type="text/javascript">
function clearAlerts() {
    $('.alert').remove();
    $('#validation-block').empty();
}

function showAlert(form_id, json, validation_block) {
    $(form_id + ' .alert, ' + form_id + ' .text-danger').remove();
    $(form_id + ' .form-group').removeClass('has-error');
    $(form_id + ' input.error').removeClass('error');

    if (json['error']) {
        if (json['error']['warning']) {
            $(form_id).prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error']['warning'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        }

        if (Array.isArray(json['error']) || Array.isArray(json['errors'])) {
            for (i in json['error']) {
                var element = $('#input_' + i);
                $(element).addClass('error');
                $(element).after('<div class="text-danger">' + json['error'][i] + '</div>');
            }
        } else {
            $(form_id).find(validation_block).append('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
        }
    }

    if (json['success']) {
        $(form_id).prepend('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + '  <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
    }
}

$('#button-update').on('click', function(e) {
    e.preventDefault();
    var element = this;
    var form_id = "#store-domain-edit";
    var validation_block = '#validation-block';

    $.ajax({
        url: 'index.php?route=cloud/store/update&member_token={{ member_token }}',
        dataType: 'json',
        method: "POST",
        data: $(form_id).serialize(),
        beforeSend: function() {
            clearAlerts();
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            if (json['error'] || json['errors']) {
                showAlert(form_id, json, validation_block);
            }
            if (json['success']) {
                $('#validation-block').prepend('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
            if (json['redirect']) {
                var parser = new DOMParser;
                var dom = parser.parseFromString(
                    '<!doctype html><body>' + json['redirect'],
                    'text/html');
                var decodedRedirectUrl = dom.body.textContent;
                window.location.replace(decodedRedirectUrl);
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
</script>
{{ footer }}
