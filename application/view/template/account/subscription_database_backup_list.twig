{% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
{% endif %}
{% if success %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
{% endif %}
{% if warnings %}
  {% for warning in warnings %}
    <div class="alert alert-warning"><i class="fa fa-info-circle"></i> {{ warning }}</div>
  {% endfor %}
{% endif %}
<div class="table-responsive">
  <table id="backup-cloud" class="table table-bordered table-hover">
    <thead>
      <tr>
        <td class="text-left">Backup ID</td>
        <td class="text-left">Status</td>
        <td class="text-left">Created</td>
        <td class="text-center">Action</td>
      </tr>
    </thead>
    <tbody>
      {% if backups %}
        {% for backup in backups %}
          <tr>
            <td class="text-left">{{ backup.backup_id }}</td>
            <td class="text-center">
              <span {% if backup.status == 'complete' %}class="label label-success"{% elseif backup.status == 'processing' %}class="label label-warning"{% elseif backup.status == 'FAILED' or backup.status == 'ERROR' %}class="label label-danger"{% endif %}>{{ backup.status }}</span>
            </td>
            <td class="text-left">{{ backup.created }}</td>
            <td class="text-right">
              <a href="{{ backup.restore }}" {% if backup.status == 'complete' %}class="btn btn-default"{% else %} class="btn btn-default disabled"  {% endif %} onclick="return confirm('Are you sure?')">RESTORE</a>
              <a href="{{ backup.remove }}" {% if backup.status == 'complete' %}class="btn btn-danger"{% else %} class="btn btn-danger disabled"  {% endif %} onclick="return confirm('Are you sure?')"><i class="fa fa-trash-o fa-fw"></i></a>
            </td>
          </tr>
        {% endfor %}
      {% else %}
        <tr>
          <td class="text-center" colspan="4">No results!</td>
        </tr>
      {% endif %}
    </tbody>
  </table>
</div>
<div class="text-right">
    <a href="{{ cancel }}" class="btn btn-link">Cancel</a>
    {% if create_backup %}
      <button id="create-backup" type="button" class="btn btn-primary">Create Backup</button>
    {% endif %}
</div>
<script>
{% if create_backup %}
$('#create-backup').on('click', function (e) {
        $.ajax({
        url: '{{ create_backup }}',
        dataType: 'json',
        method: "GET",
        beforeSend: function () {
            $('#create-backup').button('loading');
        },
        complete: function () {
            $('#create-backup').button('reset');
        },
        success: function (json) {
            $('#subscription-backup-list').html(json['html']);
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
{% endif %}

$('#backup-cloud .btn-default').on('click', function (e) {
  e.preventDefault();
    if(confirm("Are you sure you want to restore your store database from this backup?")) {
      $.ajax({
        url: $(this).attr('href'),
        dataType: 'json',
        method: "GET",
        beforeSend: function () {
            $('#backup-cloud .btn-danger, #backup-cloud .btn-default').addClass("disabled");
        },
        success: function (json) {
            $('#subscription-backup-list').html(json['html']);
        },
        error: function (xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
      });
    }     
});
</script>