{{ header }}
<div id="account-order-info">
  <div class="container">
    {% if success %}
      <div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="row">
      <div class="col-md-9">
        <div class="row">
          <div class="col-xs-6">
            <div><img src="{{ store_logo_url }}" title="{{ title }}" alt="{{ logo }}"/></div>
            <strong>{{ text_from }}</strong>
            <p>
              <small><strong>{{ store_owner }}</strong>
                <address>
                  {{ store_address }}
                </address>
                {{ text_email }}: {{ contact_support }}
                <br/>
              </small>
            </p>
            <strong>{{ text_to }}</strong>
            <p>
              <small>
                <strong>{% if company %}{{ company }}{% else %}{{ firstname }} {{ lastname }}{% endif %}</strong>
                <br/>
                {% if address_1 %}
                  {{ address_1 }}
                  <br/>
                {% endif %}
                {% if address_2 %}
                  {{ address_2 }}
                  <br/>
                {% endif %}
                {% if city %}
                  {{ city }} {% if postcode %}  - {{ postcode }} {% endif %}
                  <br/>
                {% endif %}
                {% if zone %}
                  {{ zone }}
                  <br/>
                {% endif %}
                {% if country %}
                  {{ country }}
                  <br/>
                {% endif %}
                {% if tax %}
                  {{ text_tax }} {{ tax }}
                {% endif %}
              </small>
            </p>
          </div>
          <div class="col-xs-6">
            <div class="text-right text-uppercase">
              <h2>{{ text_invoice }}</h2>
            </div>
            <ul class="list-group">
              <li class="list-group-item">
                <div class="row">
                  <div class="col-xs-5">{{ text_invoice_no }}</div>
                  <div class="col-xs-7"><strong>INV{{ order_id }}</strong></div>
                </div>
              </li>
              <li class="list-group-item">
                <div class="row">
                  <div class="col-xs-5">{{ text_due_date }}</div>
                  <div class="col-xs-7">{{ date_added }}</div>
                </div>
              </li>
              <li class="list-group-item">
                <div class="row">
                  <div class="col-xs-5">{{ text_account_id }}</div>
                  <div class="col-xs-7">{{ username }}</div>
                </div>
              </li>
              <li class="list-group-item">
                <div class="row">
                  <div class="col-xs-5">{{ text_purchased_via }}</div>
                  <div class="col-xs-7">{{ payment_method }}</div>
                </div>
              </li>
              <li class="list-group-item">
                <div class="row">
                  <div class="col-xs-5">{{ text_transaction_id }}</div>
                  <div class="col-xs-7">{{ transaction_id }}</div>
                </div>
              </li>
              <li class="list-group-item list-group-item-info">
                <div class="row">
                  <div class="col-xs-5">{{ text_total_due }}</div>
                  <div class="col-xs-7"><strong>{{ total }}</strong></div>
                </div>
              </li>
            </ul>
          </div>
        </div>
        <hr/>
        <div>
          <div class="table-responsive">
            <table class="table table-bordered table-striped">
              <thead>
                <tr>
                  <th class="text-right">{{ column_extension_id }}</th>
                  <th class="text-left">{{ column_extension }}</th>
                  <th class="text-right">{{ column_price }}</th>
                  <th class="text-right">{{ column_quantity }}</th>
                  <th class="text-right">{{ column_total }}</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-right">{{ extension_id }}</td>
                  <td class="text-left">{{ extension }}</td>
                  <td class="text-right">{{ price }}</td>
                  <td class="text-right">{{ quantity }}</td>
                  <td class="text-right">{{ total }}</td>
                </tr>
              </tbody>
              <tfoot>
                <tr>
                  <td class="text-right" colspan="5">{{ text_total_due }}: <span class="h2 text-info">{{ total }}</span></td>
                </tr>
              </tfoot>
            </table>
          </div>
        </div>
        <div class="text-center">
          <p>
            <small>{{ text_invoice_question }} <a href="{{ support }}">{{ text_support_team }}</a>.</small>
          </p>
          <h3>{{ text_thank_you }}</h3>
          <hr/>
          <div class="visible-print-block">
            <small>&copy; {{ text_copyright }} {{ 'now'|date('Y') }} {{ store_name }}</small>
          </div>
          <div class="hidden-print"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> <button type="button" onclick="window.print();" class="btn btn-danger btn-lg"><i class="fa fa-print"></i> {{ button_print }}</button></div>
        </div>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
<link rel="stylesheet" type="text/css" href="application/view/stylesheet/print.css" media="print"/>
{{ footer }}
