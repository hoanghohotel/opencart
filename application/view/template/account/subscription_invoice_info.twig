{{ header }}
<div id="account_subscription_invoice">
	<div class="container">
		{% if success %}
			<div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="row">
			<div class="col-md-9">
				<div class="row">
					<div class="col-xs-6">
						<div><img src="application/view/image/icon/opencart-logo.png" title="{{ title }}" alt="{{ logo }}"/></div>
						<strong>From</strong>
						<p>
							<small><strong>OpenCart Limited</strong>
								<br/>
								Unit G, 2/F Tower 2 Avignon,
								<br/>
								1 Kwun Chui Road, So Kwun Wat, Tuen Mun, Hong Kong
								<br/>
								Email: support@opencart.com
							</small>
						</p>
						<strong>To</strong>
						<p>
							<small>
								{% if member.company %}
									<strong>{{ member.company }}</strong>
									<br/>
									{{ member.firstname }} {{ member.lastname }}
									<br/>
								{% else %}
									<strong>{{ member.firstname }} {{ member.lastname }}</strong>
									<br/>
								{% endif %}
								{% if member.tax_id %}
									{{ member.tax_id }}
									<br/>
								{% endif %}

								{% if member.country %}
									{{ member.country }}
									<br/>
								{% endif %}
							</small>
						</p>
					</div>
					<div class="col-xs-6">
						<div class="text-right text-uppercase">
							<h2>Invoice</h2>
						</div>
						<ul class="list-group">
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">Invoice No.</div>
									<div class="col-xs-7"><strong>INV{{ transaction.subscription_transaction_id }}</strong></div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">Due Date</div>
									<div class="col-xs-7">{{ transaction.date_added }}</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">Account ID</div>
									<div class="col-xs-7">{{ member.username }}</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">Purchased Via</div>
									<div class="col-xs-7">Credit Card</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">Transaction ID</div>
									<div class="col-xs-7">{{ transaction.transaction_id }}</div>
								</div>
							</li>
							<li class="list-group-item list-group-item-info">
								<div class="row">
									<div class="col-xs-5">Total Due</div>
									<div class="col-xs-7"><strong>${{ transaction.amount }}</strong></div>
								</div>
							</li>
						</ul>
					</div>
				</div>
				<hr/>
				<div>
					<div class="table-responsive">
						<table class="table table-bordered table-striped">
							<thead>
								<tr>
									<th class="text-left">Cloud Store</th>
									<th class="text-left">Plan</th>
									<th class="text-left">Price</th>
									<th class="text-left">Payment Method</th>
									<th class="text-left">Total</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td class="text-left">{{ subscription.name }}</td>
									<td class="text-left">{{ subscription.plan_name }}</td>
									<td class="text-left">{{ subscription.plan_price }}</td>
									<td class="text-left">
										<img class="subscription-image-table"
										     src="{{ transaction.transaction_card_image }}"
										     alt="{{ transaction.store_name }}">&nbsp; &nbsp;<span>{{ transaction.transaction_card }}</span></td>
									<td class="text-left">${{ subscription.plan_price }}</td>
								</tr>
							</tbody>
							<tfoot>
								<tr>
									<td class="text-right" colspan="5">Total Due: <span class="h2 text-info">${{ transaction.amount }}</span></td>
								</tr>
							</tfoot>
						</table>
					</div>
				</div>
				<div class="text-center">
					<p>
						<small>If you have any question about this invoice, please contact our <a href="{{ support }}">support team</a>.</small>
					</p>
					<h3>Thank You For Your Business!</h3>
					<hr/>
					<div class="visible-print-block">
						<small>&copy; Copyright {{ 'now'|date('Y') }} OpenCart</small>
					</div>
					<div class="hidden-print"><a href="{{ cancel }}" class="btn btn-link">Cancel</a> <button type="button" onclick="window.print();" class="btn btn-danger btn-lg"><i class="fa fa-print"></i> Print</button></div>
				</div>
			</div>
			<div class="col-md-3 hidden-xs">{{ menu }}</div>
		</div>
	</div>
</div>
<link rel="stylesheet" type="text/css" href="application/view/stylesheet/print.css" media="print"/>
{{ footer }}
