{{ header }}
<div id="account_subscription_invoice">
	<div class="container">
		{% if success %}
			<div class="alert alert-success"><i class="fa fa-exclamation-circle"></i> {{ success }}
				<button type="button" class="close" data-dismiss="alert">&times;</button>
			</div>
		{% endif %}
		<div class="row">
			<div class="col-md-9">
				<div class="row">
					<div class="col-xs-6">
						<div><img src="{{ store_logo_url }}" title="{{ title }}" alt="{{ logo }}"/></div>
						<strong>{{ text_from }}</strong>
						<p>
							<small><strong>{{ store_owner }}</strong>
								<address>
								{{ store_address }}
								</address>
								{{ text_email }}: {{ contact_support }}
							</small>
						</p>
						<strong>{{ text_to }}</strong>
						<p>
							<small>
								{% if member.company %}
									<strong>{{ member.company }}</strong>
									<br/>
									{{ member.firstname }} {{ member.lastname }}
									<br/>
								{% else %}
									<strong>{{ member.firstname }} {{ member.lastname }}</strong>
									<br/>
								{% endif %}
								{% if member.tax_id %}
									{{ member.tax_id }}
									<br/>
								{% endif %}

								{% if member.country %}
									{{ member.country }}
									<br/>
								{% endif %}
							</small>
						</p>
					</div>
					<div class="col-xs-6">
						<div class="text-right text-uppercase">
							<h2>{{ heading_invoice }}</h2>
						</div>
						<ul class="list-group">
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">{{ text_invoice_no }}</div>
									<div class="col-xs-7"><strong>INV{{ transaction.subscription_transaction_id }}</strong></div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">{{ text_due_date }}</div>
									<div class="col-xs-7">{{ transaction.date_added }}</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">{{ text_account_id }}</div>
									<div class="col-xs-7">{{ member.username }}</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">{{ text_purchased_via }}</div>
									<div class="col-xs-7">{{ text_credit_card }}</div>
								</div>
							</li>
							<li class="list-group-item">
								<div class="row">
									<div class="col-xs-5">{{ text_transaction_id }}</div>
									<div class="col-xs-7">{{ transaction.transaction_id }}</div>
								</div>
							</li>
							<li class="list-group-item list-group-item-info">
								<div class="row">
									<div class="col-xs-5">{{ text_total_due }}</div>
									<div class="col-xs-7"><strong>${{ transaction.amount }}</strong></div>
								</div>
							</li>
						</ul>
					</div>
				</div>
				<hr/>
				<div>
					<div class="table-responsive">
						<table class="table table-bordered table-striped">
							<thead>
								<tr>
									<th class="text-left">{{ column_cloud_store }}</th>
									<th class="text-left">{{ column_plan }}</th>
									<th class="text-left">{{ column_price }}</th>
									<th class="text-left">{{ column_payment_method }}</th>
									<th class="text-left">{{ column_total }}</th>
								</tr>
							</thead>
							<tbody>
								<tr>
									<td class="text-left">{{ subscription.name }}</td>
									<td class="text-left">{{ subscription.plan_name }}</td>
									<td class="text-left">{{ subscription.plan_price }}</td>
									<td class="text-left">
										<img class="subscription-image-table"
										     src="{{ transaction.transaction_card_image }}"
										     alt="{{ transaction.store_name }}">&nbsp; &nbsp;<span>{{ transaction.transaction_card }}</span></td>
									<td class="text-left">${{ subscription.plan_price }}</td>
								</tr>
							</tbody>
							<tfoot>
								<tr>
									<td class="text-right" colspan="5">{{ text_total_due }}: <span class="h2 text-info">${{ transaction.amount }}</span></td>
								</tr>
							</tfoot>
						</table>
					</div>
				</div>
				<div class="text-center">
					<p>
						<small>{{ text_invoice_question_prefix }} <a href="{{ support }}">{{ text_support_team }}</a>.</small>
					</p>
					<h3>{{ text_thank_you }}</h3>
					<hr/>
					<div class="visible-print-block">
						<small>&copy; {{ text_copyright }} {{ 'now'|date('Y') }} {{ store_name }}</small>
					</div>
					<div class="hidden-print"><a href="{{ cancel }}" class="btn btn-link">{{ button_cancel }}</a> <button type="button" onclick="window.print();" class="btn btn-danger btn-lg"><i class="fa fa-print"></i> {{ button_print }}</button></div>
				</div>
			</div>
			<div class="col-md-3 hidden-xs">{{ menu }}</div>
		</div>
	</div>
</div>
<link rel="stylesheet" type="text/css" href="application/view/stylesheet/print.css" media="print"/>
{{ footer }}
