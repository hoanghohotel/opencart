<fieldset id="payment-credit-card">
	<legend>{{ text_enter_card }}</legend>
	<div class="form-group">
		<label for="input-card-number">{{ entry_card_number }}</label>
		<div id="input-card-number" class="form-control"></div>
	</div>
	<div class="row">
		<div class="col-xs-6">
			<div class="form-group">
				<label>{{ entry_expire_date }}</label>
				<div id="input-card-expire" class="row">
					<div class="col-xs-6">
						<div id="input-card-expire-year" class="form-control"></div>
					</div>
					<div class="col-xs-6">
						<div id="input-card-expire-month" class="form-control"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="col-xs-6">
			<div class="form-group">
				<label for="input-card-cvv">{{ entry_cvv }}</label>
				<div id="input-card-cvv" class="form-control"></div>
			</div>
		</div>
	</div>
	<div class="form-group">
		<label><input type="checkbox" name="vault" value="1" id="input-vault"/> {{ text_remember_card }}</label>
	</div>
</fieldset>
<input type="hidden" name="nonce" value="" id="input-nonce"/>
<div class="text-right">
	{{ text_agree_prefix }} <a href="{{ terms }}" target="_blank">{{ text_terms_conditions }}</a>&nbsp;&nbsp;<input type="checkbox" name="agree" value="1" id="agree"/>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
	<button type="button" id="button-continue" class="btn btn-primary btn-lg">{{ button_continue }}</button>
</div>

<div id="fadeLoader">
	<div id="loader">{{ text_loading }}</div>
</div>

<script type="text/javascript"><!--
var form = document.querySelector('#payment-credit-card');
var button = document.querySelector('#button-continue');

function showLoader() {
    $("#fadeLoader").css("display", "flex");
    $('#loader').css("display", "flex");
}

function closeLoader() {
    $("#fadeLoader").css("display", "none");
    $('#loader').css("display", "none");
}

showLoader();

setTimeout(function() {
    closeLoader()
}, 1500)

// Connect to Braintree
braintree.client.create({
    authorization: '{{ client_token }}'
}, function(clientErr, clientInstance) {
    if (clientErr) {
        console.log(clientErr);

        return;
    }

    // Credit card Payment
    var option = {
        client: clientInstance,
        styles: {
            'input': {
                'font-size': '16pt',
                'color': '#3A3A3A'
            },
            '.valid': {
                'color': 'green'
            },
            '.invalid': {
                'font-family': 'monospace'
            }
        },
        fields: {
            number: {
                selector: '#input-card-number',
                placeholder: '**** **** **** ****'
            },
            cvv: {
                selector: '#input-card-cvv',
                placeholder: '***'
            },
            expirationMonth: {
                container: '#input-card-expire-month',
                placeholder: '{{ text_month }}',
                select: true
            },
            expirationYear: {
                container: '#input-card-expire-year',
                placeholder: '{{ text_year }}',
                select: true
            }
        }
    };

    var callback = function(hostedFieldsErr, hostedFieldsInstance) {
        if (hostedFieldsErr) {
            console.log(hostedFieldsErr);

            return;
        }

        button.removeAttribute('disabled');

        button.addEventListener('click', function(e) {
            e.preventDefault();

            $('.alert, .text-danger').remove();

            var state = hostedFieldsInstance.getState();

            var formValid = Object.keys(state.fields).every(function(key) {
                return state.fields[key].isValid;
            });

            hostedFieldsInstance.tokenize(function(tokenizeErr, payload) {
                if (tokenizeErr) {
                    if (tokenizeErr.code == 'HOSTED_FIELDS_FIELDS_EMPTY') {
                        $('#payment-credit-card').prepend('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_fields_empty }}<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                    }

                    if (tokenizeErr.details) {
                        for (i in tokenizeErr.details.invalidFieldKeys) {
                            key = tokenizeErr.details.invalidFieldKeys[i];

                            if (key == 'number') {
                                $('#input-card-number').after('<div class="text-danger">{{ error_card_number }}</div>');
                            }

                            if (key == 'cvv') {
                                $('#input-card-cvv').after('<div class="text-danger">{{ error_cvv }}</div>');
                            }

                            if (key == 'expirationDate' || key == 'expirationMonth' || key == 'expirationDate') {
                                $('#input-card-expire').after('<div class="text-danger">{{ error_expiration_date }}</div>');
                            }
                        }
                    }

                    return;
                } else {
                    $('#input-nonce').val(payload.nonce);

                    $.ajax({
                        url: 'index.php?route=checkout/payment/prepare&member_token={{ member_token }}&extension_id={{ extension_id }}&quantity={{ quantity }}&type=card&order_id={{ order_id }}',
                        type: 'post',
                        dataType: 'html',
                        data: $('#input-nonce, input[type=\'checkbox\']:checked, select option:selected'),
                        cache: false,
                        beforeSend: function() {
                            $('#button-continue').button('loading');
                        },
                        complete: function(xhr) {
                            $('#button-continue').button('reset');

                            if (xhr.status == 401) {
                                location = xhr.getResponseHeader('Location');
                            }
                        },
                        success: function(html) {
                            $('#modal-checkout .modal-body').html(html);
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                        }
                    });
                }
            });
        }, false);
    }

    braintree.hostedFields.create(option, callback);
});
//--></script>
