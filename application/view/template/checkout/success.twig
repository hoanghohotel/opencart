{{ header }}
<div id="marketplace-contact">
	<div class="page-header">
		<div class="container">
			<h1>{{ text_heading }}</h1>
			<p>{{ text_subtitle }}</p>
		</div>
	</div>
	<div class="container">
		<div class="row">
			<div class="col-sm-10 col-sm-offset-2">
				<h2>{{ text_processed }}</h2>
				<p>{{ text_history_prefix }} <a href="{{ account }}">{{ text_account_link }}</a> {{ text_history_mid }} <a href="{{ history }}">{{ text_history_link }}</a>.</p>
				<p>{{ text_questions_prefix }} <a href="{{ contact }}">{{ text_support_link }}</a>.</p>
				<p>{{ text_thanks }}</p>
				<p>{{ text_regards }}
					<br/>
					<strong>{{ text_team }}</strong></p>
			</div>
		</div>
	</div>
</div>
{{ footer }}
