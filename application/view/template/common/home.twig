{{ header }}
<div id="common-home">
  <div id="hero">
    <div class="container">
      <div class="row">
        <div class="col-xs-12 col-md-7">
          <h1>{{ text_hero_title }}</h1>
          <p>{{ text_hero_subtitle }}</p>
          <div class="hidden-xs hidden-sm" style="display: inline-flex;">
            <div style="margin-right: 15px;">
              <div class="hero-button-description text-center">{{ text_hero_cloud_desc }}</div>
              <a href="{{ cloud_hosting_url }}" target="__blank" class="btn btn-success btn-xl">{{ button_start_now }}</a>
              <a class="hero-demo" href="{{ guide }}">{{ button_quick_guide }}</a>
            </div>
            <div style="padding-left: 15px; border-left: 2px solid white;">
              <div class="hero-button-description text-center">{{ text_hero_install_desc }}</div>
              <a href="{{ download }}" class="btn btn-white btn-xl">{{ button_free_download }}</a>
              <a class="hero-demo" href="{{ demo }}">{{ button_view_demo }}</a>
            </div>
          </div>
          <p class="visible-sm-block">
            <a target="_blank" href="{{ cloud_hosting_url }}" class="btn btn-success">{{ button_signup_cloud }}</a>
            <a href="{{ download }}" class="btn btn-success btn-lg">{{ button_free_download }}</a>
            <a href="{{ demo }}" class="btn btn-white btn-lg">{{ button_view_demo }}</a>
          </p>
          <p class="visible-xs-block">
            <a target="_blank" href="{{ cloud_hosting_url }}" class="btn btn-success btn-block">{{ button_signup_cloud }}</a>
            <a href="{{ download }}" class="btn btn-success btn-lg btn-block">{{ button_free_download }}</a>
            <a href="{{ demo }}" class="btn btn-white btn-lg btn-block">{{ button_view_demo }}</a>
          </p>
        </div>
      </div>
      <div class="hidden-md hidden-lg"><img src="application/view/image/home/hero-image.png" alt="{{ text_hero_image_alt }}" title="{{ text_hero_image_alt }}" class="img-responsive" /> </div>
    </div>
    <div class="device hidden-xs hidden-sm"> <img src="application/view/image/home/hero-image.png" alt="{{ text_hero_image_alt }}" title="{{ text_hero_image_alt }}" class="hidden" /> </div>
  </div>
  <div id="feature" class="container">
    <div class="page-header text-center">
      <h2>{{ text_feature_heading }}</h2>
      <p>{{ text_feature_subheading }}</p>
    </div>
    <div class="row hidden-sm">
      <div class="col-md-3">
        <h4><i class="opencart-icon-opencart-open-source-and-free"></i>
          <div>{{ text_feature_free_title }}</div></h4>
        <p>{{ text_feature_free_desc }}</p>
      </div>
      <div class="col-md-3">
        <h4><i class="opencart-icon-opencart-powerful-store-management"></i>
          <div>{{ text_feature_manage_title }}</div></h4>
        <p>{{ text_feature_manage_desc }}</p>
      </div>
      <div class="col-md-3">
        <h4><i class="opencart-icon-opencart-extension-and-themes"></i>
          <div>{{ text_feature_ext_title }}</div></h4>
        <p>{{ text_feature_ext_desc }}</p>
      </div>
      <div class="col-md-3">
        <h4><i class="opencart-icon-opencart-support-you-can-trust-on"></i>
          <div>{{ text_feature_support_title }}</div></h4>
        <p>{{ text_feature_support_desc }}</p>
      </div>
    </div>
  </div>
  <div id="cloud" class="container">
      <div class="row">
        <div class="col-md-6">
          <h2>{{ text_cloud_heading }}</h2>
          <p>{{ text_cloud_description }}</p>
          <div class="hidden-xs hidden-sm"><a target="_blank" href="{{ cloud_hosting_url }}" class="btn btn-primary btn-xl">{{ button_get_started }}</a></div>
          <div class="text-center visible-xs-block visible-sm-block"><a target="_blank" href="{{ cloud_hosting_url }}" class="btn btn-primary btn-lg btn-block">{{ button_get_started }}</a></div>
        </div>
      <div class="col-md-6"><img src="image/application/cloud/utility-2.png" class="img-responsive" /></div>
    </div>
    <div class="row visible-sm-block">
      <div class="col-sm-6">
        <h4><i class="opencart-icon-opencart-open-source-and-free"></i><div>{{ text_feature_free_title }}</div></h4>
        <p>{{ text_feature_free_desc }}</p>
      </div>
      <div class="col-sm-6">
        <h4><i class="opencart-icon-opencart-powerful-store-management"></i><div>{{ text_feature_manage_title }}</div></h4>
        <p>{{ text_feature_manage_desc }}</p>
      </div>
    </div>
    <div class="row visible-sm-block">
      <div class="col-sm-6">
        <h4><i class="opencart-icon-opencart-extension-and-themes"></i><div>{{ text_feature_ext_title }}</div></h4>
        <p>{{ text_feature_ext_desc }}</p>
      </div>
      <div class="col-sm-6">
        <h4><i class="opencart-icon-opencart-support-you-can-trust-on"></i><div>{{ text_feature_support_title }}</div></h4>
        <p>{{ text_feature_support_desc }}</p>
      </div>
    </div>
  </div>
  <div id="business" class="container-fluid">
    <div class="container">
      <div class="page-header">
        <h2>{{ text_business_heading }}</h2>
        <p>{{ text_business_subheading }}</p>
      </div>
      <ul>
        <li><a href="https://www.cxracing.com/" target="_blank"><img src="application/view/image/home/brand/cxracing.png" alt="" title="" class="img-responsive"/></a></li>
        <li><a href="https://www.rcmart.com/" target="_blank"><img src="application/view/image/home/brand/rcmart.png" alt="" title="" class="img-responsive"/></a></li>
        <li><a href="https://www.dirsalonfurniture.com/" target="_blank"><img src="application/view/image/home/brand/dream-in-reality.png" alt="" title="" class="img-responsive"/></a></li>
        <li><a href="https://www.goodsmileus.com/" target="_blank"><img src="application/view/image/home/brand/good-smile-contact.png" alt="" title="" class="img-responsive"/></a></li>
        <li><a href="https://hobbii.com/" target="_blank"><img src="application/view/image/home/brand/hobbii-logo.png" alt="" title="" class="img-responsive"/></a></li>
        <li><a href="https://pharmacyloreto.com/" target="_blank"><img src="application/view/image/home/brand/pharmacy-loreto.png" alt="" title="" class="img-responsive"/></a></li>
      </ul>
    </div>
  </div>
  <div id="marketplace" class="container">
    <div class="row">
      <div class="col-md-6">
        <h2>{{ text_marketplace_heading }}</h2>
        <p>{{ text_marketplace_description }}</p>
        <div class="hidden-xs hidden-sm"><a href="{{ marketplace }}" class="btn btn-primary btn-xl">{{ button_visit_marketplace }}</a></div>
        <div class="text-center visible-xs-block visible-sm-block"><a href="{{ marketplace }}" class="btn btn-primary btn-lg btn-block">{{ button_visit_marketplace }}</a></div>
      </div>
      <div class="col-md-6"><img src="application/view/image/home/shop-showcase.png" class="img-responsive" /></div>
    </div>
  </div>
  <div id="extension" class="container-fluid">
    <div class="container">
      <div class="page-header text-center">
        <h2>{{ text_payment_heading }}</h2>
        <p>{{ text_payment_subheading }}</p>
      </div>
      <ul class="list-inline">
        <li><img src="application/view/image/home/payment/paypal.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/amazon-payments.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/authorize.net.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/sagapay.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/e-way.png" class="img-responsive"/></li>
      </ul>
      <ul class="list-inline">
        <li><img src="application/view/image/home/payment/skrill.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/2checkout.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/klarna.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/worldpay.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/payment/revolut.png" class="img-responsive"/></li>
      </ul>
      <ul class="list-inline">
        <li><img src="application/view/image/home/shipping/ups.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/shipping/fedex.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/shipping/usps.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/shipping/aust-post.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/shipping/parcel-force.png" class="img-responsive"/></li>
        <li><img src="application/view/image/home/shipping/royal-mail.png" class="img-responsive"/></li>
      </ul>
      <p class="text-center">
        <a href="{{ marketplace }}" class="btn btn-ghost-dark btn-lg hidden-xs">{{ button_visit_all }}</a>
        <a href="{{ marketplace }}" class="btn btn-ghost-dark btn-lg btn-block visible-xs">{{ button_visit_all }}</a>
      </p>
    </div>
  </div>
  <div id="awards" class="container text-center" style="padding-bottom: 30px;">
    <div class="page-header">
      <h2>{{ text_awards_heading }}</h2>
      <p>{{ text_awards_subheading }}</p>
      <div class="row">
        <div class="col-sm-4 col-xs-12">
          <img src="application/view/image/home/fastest_growing.png" alt="{{ text_awards_subheading }}" title="{{ text_awards_subheading }}" />
        </div>
        <div class="col-sm-4 col-xs-12">
          <img src="application/view/image/home/most_popular.png" alt="{{ text_awards_subheading }}" title="{{ text_awards_subheading }}" />
        </div>
        <div class="col-sm-4 col-xs-12">
          <img src="application/view/image/home/most_worthy.png" alt="{{ text_awards_subheading }}" title="{{ text_awards_subheading }}" />
        </div>
      </div>
      <div class="row">
       <div class=" col-sm-offset-2 col-sm-4 col-xs-12">
          <img src="application/view/image/home/software_reviews.png" alt="{{ text_awards_subheading }}" title="{{ text_awards_subheading }}" />
        </div>
        <div class="col-sm-4 col-xs-12">
          <img src="application/view/image/home/ecommerce-winner.svg" alt="{{ text_awards_subheading }}" title="{{ text_awards_subheading }}" />
        </div>
      </div>
    </div>
  </div>
  <div id="support" class="container text-center">
    <div class="page-header">
      <h2>{{ text_support_heading }}</h2>
      <p>{{ text_support_subheading }}</p>
    </div>
    <div class="row">
      <div class="col-sm-6"><img src="application/view/image/home/community-support-icon.png" alt="{{ text_community_support_title }}" title="{{ text_community_support_title }}" />
        <h2>{{ text_community_support_title }}</h2>
        <p>{{ text_community_support_desc }}</p>
        <p>
          <a href="{{ forum }}" class="btn btn-primary btn-lg hidden-xs">{{ button_learn_more }}</a>
          <a href="{{ forum }}" class="btn btn-primary btn-lg btn-block visible-xs">{{ button_learn_more }}</a>
        </p>
      </div>
      <div class="col-sm-6"><img src="application/view/image/home/dedicated-support-icon.png" alt="{{ text_dedicated_support_title }}" title="{{ text_dedicated_support_title }}" />
        <h2>{{ text_dedicated_support_title }}</h2>
        <p>{{ text_dedicated_support_desc }}</p>
        <p>
          <a href="{{ dedicated_support }}" target="_blank" class="btn btn-primary btn-lg hidden-xs">{{ button_learn_more }}</a>
          <a href="{{ dedicated_support }}" target="_blank" class="btn btn-primary btn-lg btn-block visible-xs">{{ button_learn_more }}</a>
        </p>
      </div>
    </div>
  </div>
  <div id="press" class="container-fluid">
  <div class="container">
    <div class="row">
      <div class="col-md-12 text-center">{{ text_press_heading }}</div>
      <div class="col-md-12">
        <ul class="list-unstyled">
          <li><a href="https://www.forbes.com/sites/brentgleeson/2014/09/05/3-steps-to-launch-your-first-ecommerce-website/" target="_blank"><img src="application/view/image/home/featured/forbes.png" alt="Forbes" title="Forbes" class="img-responsive" /></a></li>
          <li><a href="https://www.paypal.com/uk/webapps/mpp/open-cart" target="_blank"><img src="application/view/image/home/featured/paypal.png" alt="PayPal" title="PayPal" class="img-responsive" /></a></li>
          <li><a href="https://www.bbc.co.uk/news/business-26986083" target="_blank"><img src="application/view/image/home/featured/bbc.png" alt="BBC" title="BBC" class="img-responsive" /></a></li>
          <li><a href="https://www.scmp.com/article/1604647/business-mind-daniel-kerr-founder-opencart" target="_blank"><img src="application/view/image/home/featured/south-china-morning-post.png" alt="South China Morning Post" title="South China Morning Post" class="img-responsive" /></a></li>
          <li><a href="https://fixthephoto.com/opencart-review.html" target="_blank"><img src="application/view/image/home/featured/fix-the-photo.png" alt="Fix The Photo" title="Fix The Photo" class="img-responsive" width="150px" /></a></li>
        </ul>
      </div>
    </div>
  </div>
</div>
</div>
{{ footer }}
