<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<base href="{{ base }}" />
{% if description %}
<meta name="description" content="{{ description }}" />
{% endif %}
{% if keywords %}
<meta name="keywords" content="{{ keywords }}" />
{% endif %}
{% if robots %}
<meta name="robots" content="{{ robots }}" />
{% endif %}

<meta name="agentfy_data" content="{{ agentfy_data|e('html_attr') }}" />
<script>
(function() {
  try {
    var savedTheme = localStorage.getItem('oc_theme');
    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
    var theme = savedTheme ? savedTheme : (prefersDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', theme);
  } catch (e) {}
})();
</script>
<link href="application/view/stylesheet/bootstrap.css" rel="stylesheet" />
<link href="application/view/stylesheet/stylesheet.css" rel="stylesheet" />
<link href="application/view/stylesheet/dark-mode.css" rel="stylesheet" />
<link href="application/view/javascript/fontawesome/css/font-awesome.min.css" rel="stylesheet" />
<link href="application/view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.css" type="text/css" rel="stylesheet" media="screen" />
<script src="application/view/javascript/jquery/jquery-3.7.1.min.js"></script>
<script src="application/view/javascript/bootstrap/js/bootstrap.min.js"></script>
<script src="application/view/javascript/jquery/datetimepicker/moment.js" type="text/javascript"></script>
<script src="application/view/javascript/jquery/datetimepicker/bootstrap-datetimepicker.min.js" type="text/javascript"></script>
<script src="application/view/javascript/common.js"></script>
<meta name="csrf-member-token" content="{{ csrf_member_token|escape('html_attr') }}" />
<meta name="csrf-policy" content="{{ csrf_policy|escape('html_attr') }}" />
<meta name="csrf-confirm" content="{{ csrf_confirm|default('Are you sure?')|escape('html_attr') }}" />
<script src="application/view/javascript/csrf.js"></script>

{% for style in styles %}
<link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}" />
{% endfor %}
{% for link in links %}
<link href="{{ link.href }}" rel="{{ link.rel }}" />
{% endfor %}

</head>
<body>
<div id="fb-root"></div>
<script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v15.0" nonce="jXyV7bXV"></script>
<header>
  <nav class="navbar navbar-default navbar-fixed-top">
    <div class="container">
      <div class="navbar-header">
        <button type="button" data-toggle="collapse" data-target="#navbar-collapse-header" class="navbar-toggle collapsed"><span class="icon-bar"></span> <span class="icon-bar"></span> <span class="icon-bar"></span></button>
        <a href="{{ home }}" class="navbar-brand"><img src="application/view/image/icon/opencart-logo.png" title="{{ title }}" alt="{{ logo }}" /></a></div>
      <div class="collapse navbar-collapse" id="navbar-collapse-header">
        <ul class="nav navbar-nav">
          <li><a href="{{ feature }}">{{ text_features }}</a></li>
          <li><a href="{{ demo }}">{{ text_demo }}</a></li>
          <li><a href="{{ marketplace }}">{{ text_marketplace }}</a></li>
          <li><a href="{{ blog }}">{{ text_blog }}</a></li>
          <li><a href="{{ download }}">{{ text_download }}</a></li>
          <li class="dropdown"><a href="#" data-toggle="dropdown">{{ text_resources }} <span class="caret"></span></a>
            <ul class="dropdown-menu">
              <li><a href="{{ showcase }}">{{ text_showcase }}</a></li>
              <li><a href="{{ contact }}">{{ text_contact }}</a></li>
              {# <li><a href="{{ cloud }}">{{ text_cloud }}</a></li> #}
              <li><a href="{{ partner }}">{{ text_partners }}</a></li>
              <li><a href="{{ forum }}">{{ text_forum }}</a></li>
              <li><a href="{{ facebook_community }}" target="_blank">{{ text_facebook_community }}</a></li>
              <li><a href="{{ documentation }}">{{ text_documentation }}</a></li>
              <li><a target="_blank" href="{{ github }}">{{ text_github }}</a></li>
              <li><a href="{{ book }}">{{ text_books }}</a></li>
              <li><a href="{{ bug_tracker }}">{{ text_bug_tracker }}</a></li>
              <li><a href="{{ developer }}">{{ text_developer }}</a></li>
            </ul>
          </li>
          {% if not logged %}
          <li class="visible-xs"><a href="{{ login }}">{{ text_login }}</a></li>
          <li class="visible-xs"><a href="{{ register }}">{{ text_register }}</a></li>
          {% else %}
          <li class="visible-xs"><a href="{{ account }}">{{ text_account }}</a></li>
          <li class="visible-xs"><a href="{{ logout }}">{{ text_logout }}</a></li>
          {% endif %}
          <li class="visible-xs"><a href="#" class="js-theme-toggle theme-toggle-mobile" title="{{ text_theme_toggle }}"><i class="fa fa-moon-o js-theme-icon"></i> <span class="js-theme-label">{{ text_dark_mode }}</span></a></li>
        </ul>
        <div class="navbar-right hidden-xs">{% if not logged %}<a href="{{ login }}" class="btn btn-link navbar-btn">{{ text_login }}</a> <a href="{{ register }}" class="btn btn-black navbar-btn">{{ text_register }}</a>{% else %}<a href="{{ account }}" class="btn btn-link navbar-btn">{{ text_account }}</a> <a href="{{ logout }}" class="btn btn-black navbar-btn">{{ text_logout }}</a>{% endif %} <button type="button" class="btn navbar-btn theme-toggle-btn js-theme-toggle" title="{{ text_theme_toggle }}" aria-label="{{ text_theme_toggle }}" data-dark-label="{{ text_dark_mode }}" data-light-label="{{ text_light_mode }}"><i class="fa fa-moon-o js-theme-icon"></i></button></div>
      </div>
    </div>
  </nav>
</header>
<script>
$(document).ready(function() {
  function syncThemeUI(theme) {
    var $btn = $('.js-theme-toggle');
    var darkLabel = $btn.data('dark-label') || 'Dark Mode';
    var lightLabel = $btn.data('light-label') || 'Light Mode';
    if (theme === 'dark') {
      $('.js-theme-icon').removeClass('fa-moon-o').addClass('fa-sun-o');
      $('.js-theme-label').text(lightLabel);
    } else {
      $('.js-theme-icon').removeClass('fa-sun-o').addClass('fa-moon-o');
      $('.js-theme-label').text(darkLabel);
    }
  }
  var currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
  syncThemeUI(currentTheme);
  $(document).on('click', '.js-theme-toggle', function(e) {
    e.preventDefault();
    var nextTheme = (document.documentElement.getAttribute('data-theme') === 'dark') ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', nextTheme);
    try { localStorage.setItem('oc_theme', nextTheme); } catch (err) {}
    syncThemeUI(nextTheme);
  });
});
</script>
