
<footer>
  <div class="container">
    <div class="row">
      <div class="col-sm-2">
        <section>
          <h5>{{ text_store_heading }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ feature }}">{{ text_features }}</a></li>
            {% if cloud %}
            <li><a href="{{ cloud }}">{{ text_cloud }}</a></li>
            {% endif %}
            <li><a href="{{ showcase }}">{{ text_showcase }}</a></li>
            <li><a href="{{ demo }}">{{ text_demo }}</a></li>
            <li><a href="{{ download }}">{{ text_download }}</a></li>
            <li><a href="{{ marketplace }}">{{ text_marketplace }}</a></li>
            <li><a href="{{ login }}">{{ text_login }}</a></li>
          </ul>
        </section>
      </div>
      <div class="col-sm-2">
        <section>
          <h5>{{ text_company }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ contact }}">{{ text_contact }}</a></li>
            <li><a href="{{ advertise }}">{{ text_extension_advertising }}</a></li>
            <li><a href="{{ advertise }}">{{ text_marketplace_advertising }}</a></li>
            <li><a href="{{ company }}">{{ text_about }}</a></li>
            <li><a href="{{ terms }}">{{ text_terms }}</a></li>
            <li><a href="{{ privacy }}">{{ text_privacy }}</a></li>
            <li><a href="{{ refund }}">{{ text_refund }}</a></li>
            <li><a href="{{ gdpr }}">{{ text_gdpr }}</a></li>
            {% for information in informations %}
            <li><a href="{{ information.href }}">{{ information.title }}</a></li>
            {% endfor %}
          </ul>
        </section>
      </div>
      <div class="col-sm-2">
        <section>
          <h5>{{ text_support }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ forum }}">{{ text_forum }}</a></li>
            <li><a href="{{ dedicated_support }}">{{ text_dedicated_support }}</a></li>
            <li><a href="{{ partner }}">{{ text_partners }}</a></li>
            <li><a href="{{ support }}">{{ text_marketplace_support }}</a></li>
            <li><a href="{{ cart2cart }}">{{ text_migrate }}</a></li>
          </ul>
        </section>
      </div>
      <div class="col-sm-2">
        <section>
          <h5>{{ text_resources }}</h5>
          <ul class="list-unstyled">
            <li><a href="{{ blog }}">{{ text_blog }}</a></li>
            <li><a href="{{ documentation }}">{{ text_documentation }}</a></li>
            <li><a target="_blank" href="{{ github }}">{{ text_github }}</a></li>
            <li><a href="{{ book }}">{{ text_books }}</a></li>
            <li><a href="{{ bug_tracker }}">{{ text_bug_tracker }}</a></li>
            <li><a href="{{ developer }}">{{ text_developer }}</a></li>
          </ul>
        </section>
      </div>
      <div class="col-sm-2 col-md-4">
        <section id="newsletter">
          <h5>{{ text_newsletter }}</h5>
          <p>{{ text_newsletter_description }}</p>
            <div class="input-group newsletter">
              <input type="text" name="newsletter" value="" placeholder="{{ entry_newsletter }}" class="form-control">
              <div class="input-group-btn">
                <button type="button" class="btn btn-primary subscribe"><i class="fa fa-angle-right"></i></button>
              </div>
            </div>
        </section>
      </div>
    </div>
    <div class="row">
      <div class="col-sm-6 col-md-6">
        <div id="copyright">
          <ul class="list-unstyled">
            <li class="company-logo"><img src="application/view/image/icon/opencart-logo-white.png" alt="{{ store_name }}" title="{{ store_name }}" /></li>
            <li class="copyright-text">&copy; {{ text_copyright }} {{ 'now'|date('Y') }} {{ store_name }}</li>
          </ul>
        </div>
      </div>
      <div class="col-sm-6 col-md-6">
        <div id="social">
          <ul class="list-unstyled">
            <li class="facebook-marketing-partner-logo"><a href="https://www.facebook.com/fmp/commerce/partner-badge" target="_blank"><img src="application/view/image/icon/facebook_marketing_partner.png" alt="{{ text_facebook_partner }}" title="{{ text_facebook_partner }}" /></a></li>
            <li><a href="{{ linkedin_url }}" target="_blank">{{ text_linkedin }}</a></li>
            <li><a href="{{ facebook_url }}" target="_blank">{{ text_facebook }}</a></li>
            <li><a href="{{ twitter_url }}" target="_blank">{{ text_twitter }}</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
{% for script in scripts %}
<script src="{{ script }}" type="text/javascript"></script>
{% endfor %}

<script src='https://js.braintreegateway.com/web/3.106.0/js/client.min.js'></script>
<script src='https://js.braintreegateway.com/web/3.106.0/js/three-d-secure.min.js'></script>
<script src='https://js.braintreegateway.com/web/3.106.0/js/hosted-fields.min.js'></script>
<script src="https://js.braintreegateway.com/web/3.106.0/js/data-collector.min.js"></script>
<script src="https://js.braintreegateway.com/web/3.106.0/js/paypal-checkout.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.21/js/intlTelInput.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.21/js/utils.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cleave.js/1.6.0/cleave.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cleave.js/1.6.0/addons/cleave-phone.i18n.js"></script>
</body></html>
