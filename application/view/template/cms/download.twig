                  <div class="col-md-12">
                    <h4 style="margin-bottom: 0px;" class="text-center">Download &amp; host your own</h4>
                    <p class="text-center">v{{ name }} {{ date_added }}. <a href=" {{ history }} ">Release notes</a></p>
