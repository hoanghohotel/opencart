{{ header }}
<div id="cms-download">
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <div class="row">
          <div class="col-md-12">
            <div class="row">
            <div class="col-md-2"></div>
            <div class="col-md-4">
                <div class="row">
                  <div class="col-md-12"><a href="https://www.scalahosting.com/opencart-hosting.html#67c83d5d66431"
                      style="display: flex; position: relative; float: left; text-align:center; height: 74px;" target="_blank"
                      onclick="ga('send', 'event', 'Downloads', 'Referral image', 'Scalahosting');"> <img
                        src="application/view/image/partner/a2_hosting/scalahosting.svg" alt="{{ text_get_started_now }}"
                        style="width: 255px; margin-top:5px; margin-left:10px;"></a></div>
                </div>
                <div class="row">
                  <div class="col-md-12">
                    <h4 style="margin-bottom: 0px;" class="text-center">{{ text_hosting_setup }}</h4>
                    <p class="text-center"><a
                        href="https://www.scalahosting.com/opencart-hosting.html#67c83d5d66431" target="_blank"
                        onclick="ga('send', 'event', 'Downloads', 'Referral link', 'Scalahosting');">{{ text_click_get_started }}</a></p>
                    <ul style="padding-left:15px;">
                      <li>{{ text_scala_item_1 }}</li>
                      <li>{{ text_scala_item_2 }}</li>
                      <li>{{ text_scala_item_3 }}</li>
                      <li>{{ text_scala_item_4 }}</li>
                    </ul>
                  </div>
                </div>
              </div>
              
              {# <div class="col-md-2">
                <div class="row">
                  <h2 class="text-center media-middle">{{ text_or }}</h2>
                </div>
              </div> #}
              <div class="col-md-4">
                <div class="row">
                  <div class="col-md-12 text-center"> <a title="{{ text_download_opencart }}" href="{{ download }}"
                      onclick="ga('send', 'event', 'Downloads', 'Download link', '{{ name }}');"><img
                        src="application/view/image/partner/a2_hosting/download_now_button.png"
                        alt="{{ text_download_now_alt }}" style="width: 220px;top: 12px;position: relative;"></a> </div>
                </div>
                <div class="row">
                  <div class="col-md-12">
                    <h4 style="margin-bottom: 0px;" class="text-center">{{ text_download_host_own }}</h4>
                    <p class="text-center">v{{ name }} {{ date_added }}. <a href=" {{ history }} ">{{ text_release_notes }}</a></p>
                    <ul>
                      <li>{{ text_download_free_prefix }} <strong>{{ store_name }} {{ name }}</strong> {{ text_for_free }}</li>
                      <li><a target="_blank"
                          href="https://www.scalahosting.com/opencart-hosting.html#67c83d5d66431">{{ text_customise_hosting }}</a></li>
                      <li>{{ text_install_configure }}</li>
                      <li>{{ text_paid_support_from }} <a
                          href="index.php?route=support/partner&filter_type_id=1">{{ text_approved_partners }}</a></li>
                      <li>{{ text_or_clone_prefix }} <a href="https://github.com/opencart/opencart">{{ text_github_repo }}</a>
                      </li>
                    </ul>
                  </div>
                </div>
              </div>
              {# <div class="col-md-4">
                <div class="row">
                  <div class="col-md-12"><a href="https://www.a2hosting.com/opencart-hosting?aid=cfa73f26&bid=75dbf1c0"
                      style="display: block; position: relative; float: left; text-align:center" target="_blank"
                      onclick="ga('send', 'event', 'Downloads', 'Referral image', 'A2 Hosting');"> <img
                        src="application/view/image/partner/a2_hosting/a2hosting_logo.png" alt="{{ text_get_started_now }}"
                        style="width: 255px; margin-top:5px; margin-left:10px;"></a></div>
                </div>
                <div class="row">
                  <div class="col-md-12">
                    <h4 style="margin-bottom: 0px;" class="text-center">{{ text_hosting_setup }}</h4>
                    <p class="text-center"><a
                        href="https://www.a2hosting.com/opencart-hosting?aid=cfa73f26&bid=75dbf1c0" target="_blank"
                        onclick="ga('send', 'event', 'Downloads', 'Referral link', 'A2 Hosting');">{{ text_click_get_started }}</a></p>
                    <ul style="padding-left:15px;">
                      <li>{{ text_a2_item_1 }}</li>
                      <li>{{ text_a2_item_2 }}</li>
                      <li>{{ text_a2_item_3_prefix }} <a
                          href="index.php?route=support/partner&filter_type_id=2">{{ text_a2_item_3_link }}</a></li>
                      <li>{{ text_a2_item_4 }}</li>
                      <li>{{ text_a2_item_5 }}</li>
                    </ul>
                  </div>
                </div>
              </div> #}
            </div>
            <div class="row">
              <div class="col-md-12 text-center"> {{ text_check_out_the }} <a href=" {{ history }} ">{{ text_previous_releases }}</a> </div>
            </div>
            <hr />
          </div>
        </div>
        <div class="row">
          <div class="col-md-12">
            <div id="steps">
              <h2>{{ text_how_to_install }}</h2>
              <div class="tutorial-video">
                <iframe width="100%" height="315" src="https://www.youtube.com/embed/v02DwbbQAFU?si=D60t0exG8oESKJGM" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>              
              </div>
              <ul>
                <li>
                  <h2>1</h2>
                  <h4>{{ text_step_1_title }}</h4>
                  <p>{{ text_step_1_desc }}</p>
                  <div class="arrow arrow-color"></div>
                  <div class="arrow arrow-border"></div>
                </li>
                <li>
                  <h2>2</h2>
                  <h4>{{ text_step_2_title }}</h4>
                  <p>{{ text_step_2_desc }}</p>
                  <div class="arrow arrow-color"></div>
                  <div class="arrow arrow-border"></div>
                </li>
                <li>
                  <h2>3</h2>
                  <h4>{{ text_step_3_title }}</h4>
                  <p>{{ text_step_3_desc }}</p>
                </li>
              </ul>
            </div>
            <div id="extension-list"> {% if extensions %}
              <h2>{{ text_add_extensions }}</h2>
              <div class="row"> {% for extension in extensions %}
                <div class="col-md-4">
                  <section>
                    <div class="extension-preview"><a href="{{ extension.href }}">
                        <div class="extension-description">{{ extension.description }}</div>
                        <img src="{{ extension.image }}" alt="{{ extension.name }}" title="{{ extension.name }}"
                          class="img-responsive" />
                      </a> </div>
                    <div class="extension-name">
                      <p><a href="{{ extension.href }}">{{ extension.name }}</a></p>
                      <p><span>{{ extension.price }}</span></p>
                    </div>
                    <div>
                      <div class="row">
                        <div class="col-xs-6">
                          <div>{% for i in 1..4 %}
                            {% if i >= rating %}<i class="opencart-icon-star-light-o"></i>{% else %}<i
                              class="opencart-icon-star-light"></i>{% endif %}
                            {% endfor %}</div>
                        </div>
                        <div class="col-xs-6">
                          <div class="text-right"><span>{{ extension.rating_total }} {{ text_reviews }}</span></div>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
                {% endfor %}
              </div>
              {% endif %}

              {% if themes %}
              <h2>{{ text_choose_theme }}</h2>
              {% for row in themes|batch(3, '') %}
              <div class="row">
                {% for theme in row %}
                {% if theme %}
                <div class="col-md-4">
                  <section>
                    <div class="extension-preview">
                      <a href="{{ theme.href }}">
                        <div class="extension-description">{{ theme.description }}</div>
                        <img src="{{ theme.image }}" alt="{{ theme.name }}" title="{{ theme.name }}"
                          class="img-responsive" />
                      </a>
                    </div>
                    <div class="extension-name">
                      <p><a href="{{ theme.href }}">{{ theme.name }}</a></p>
                      <p><span>{{ theme.price }}</span></p>
                    </div>
                    <div>
                      <div class="row">
                        <div class="col-xs-6">
                          <div>
                            {% for i in 1..5 %}
                            {% if theme.rating >= i %}<i class="opencart-icon-star-light"></i>{% else %}<i
                              class="opencart-icon-star-light-o"></i>{% endif %}
                            {% endfor %}
                          </div>
                        </div>
                        <div class="col-xs-6">
                          <div class="text-right"><span>{{ theme.rating_total }} {{ text_reviews }}</span></div>
                        </div>
                      </div>
                    </div>
                  </section>
                </div>
                {% endif %}
                {% endfor %}
              </div>
              {% endfor %}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <div class="well">
          <h3>{{ text_other_options }}</h3>
          <div><img src="application/view/image/partner/github.png" alt="GitHub" title="GitHub"
              class="img-responsive" />
            <p>{{ text_github_desc }} <a href="https://github.com/opencart/opencart">{{ text_visit_repo }}</a>.</p>
          </div>
          <div><img src="application/view/image/partner/softaculous.gif" alt="Softaculous" title="Softaculous"
              class="img-responsive" />
            <p>{{ text_softaculous_desc }} <a
                href="https://www.softaculous.com/softaculous/apps/ecommerce/OpenCart">{{ text_learn_more }}</a>.</p>
          </div>
          <div><img src="application/view/image/partner/amazon-webservices.png" class="img-responsive" />
            <p>{{ text_aws_desc }} <a
                href="https://aws.amazon.com/marketplace/search/results?x=0&y=0&searchTerms=opencart&page=1&ref_=nav_search_box">{{ text_learn_more }}</a>.</p>
          </div>
        </div>
        <div class="well">
          <h3>{{ text_requirements }}</h3>
          <p>{{ text_requirements_desc }}</p>
          <ul class="list-check list-color-blue">
            <li>{{ text_req_webserver }}</li>
            <li>{{ text_req_php }}</li>
            <li>{{ text_req_curl }}</li>
            <li>{{ text_req_db }}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="container-fluid">
    <div class="container">
      <h2>{{ text_partner_cta_title }}</h2>
      <h3>{{ text_partner_cta_subtitle }}</h3>
      <p> <a href="{{ partner }}" class="btn btn-primary btn-lg hidden-xs">{{ button_view_partners }}</a> <a href="{{ partner }}"
          class="btn btn-primary btn-lg btn-block visible-xs-block">{{ button_view_partners }}</a> </p>
    </div>
  </div>
</div>
{{ footer }}
