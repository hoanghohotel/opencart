{{ header }}
<div id="cms-information">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_page_title }}</h1>
    </div>
  </div>
  <div id="information-details">
    <div id="policy">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
                <article>
                  <h2>{{ text_gdpr_title }}</h2>
                  <hr/>
                  <h3>{{ text_what_is_title }}</h3>
                  <p>{{ text_what_is_desc }}</p>

                  <h3>{{ text_how_affect_title }}</h3>
                  <p>{{ text_how_affect_p1 }}</p>

                  <p>{{ text_how_affect_p2 }}</p>

                  <h3>{{ text_changes_title }}</h3>
                  <p>{{ text_changes_desc }}</p>
                  <ul>
                    <li>{{ text_changes_item_1 }}</li>
                    <li>{{ text_changes_item_2 }}</li>
                    <li>{{ text_changes_item_3 }}</li>
                    <li>{{ text_changes_item_4 }}</li>
                  </ul>

                  <h3>{{ text_data_apply_title }}</h3>
                  <p>{{ text_data_apply_desc }}</p>
                  <ul>
                    <li>{{ text_data_apply_item_1 }}</li>
                    <li>{{ text_data_apply_item_2 }}</li>
                    <li>{{ text_data_apply_item_3 }}</li>
                    <li>{{ text_data_apply_item_4 }}</li>
                    <li>{{ text_data_apply_item_5 }}</li>
                  </ul>
                  <p>{{ text_data_apply_footer }}</p>
                  <p><br/></p>
                  <p class="text-right"><small><i>{{ text_last_updated }}</i></small></p>
                </article>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{{ footer }}
