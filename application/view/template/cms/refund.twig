{{ header }}
<div id="cms-information">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_page_title }}</h1>
    </div>
  </div>
  <div id="information-details">
    <div id="policy">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
                <article>
                  <h2>{{ text_page_title }}</h2>
                  <hr/>
                  <p>{{ text_refund_intro }}</p>
                  <h3>{{ text_period_title }}</h3>
                  <p>{{ text_period_desc }}</p>
                  <h3>{{ text_reasons_title }}</h3>
                  <p>{{ text_reasons_intro }}</p>
                  <ul>
                    <li>{{ text_reasons_item_1 }}</li>
                    <li>{{ text_reasons_item_2 }}</li>
                    <li>{{ text_reasons_item_3 }}</li>
                  </ul>
                  <p>{{ text_reasons_outro }}</p>
                  <h3>{{ text_access_title }}</h3>
                  <p>{{ text_access_intro }}</p>
                  <ul>
                    <li>{{ text_access_item_1 }}</li>
                    <li>{{ text_access_item_2 }}</li>
                  </ul>
                  <p>{{ text_access_outro }}</p>
                  <h3>{{ text_processed_title }}</h3>
                  <p>{{ text_processed_intro }}</p>
                  <ul>
                    <li>{{ text_processed_item_1 }}</li>
                    <li>{{ text_processed_item_2 }}</li>
                    <li>{{ text_processed_item_3 }}</li>
                  </ul>
                  <p>{{ text_processed_outro }}</p>
                  <h3>{{ text_help_title }}</h3>
                  <p>{{ text_help_desc }}</p>
                  <p><br/></p>
                  <p class="text-right"><small><i>{{ text_last_updated }}</i></small></p>
                </article>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{{ footer }}
