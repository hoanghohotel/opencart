{{ header }}
<div id="cms-blog-info">
  <div class="container-fluid">
    <div id="category" class="container">
      <ul class="nav navbar-nav">
        {% for blog_category in blog_categories %}
          {% if blog_category.blog_category_id == filter_blog_category_id %}
            <li class="active"><a href="{{ blog_category.href }}">{{ blog_category.name }}</a></li>
          {% else %}
            <li><a href="{{ blog_category.href }}">{{ blog_category.name }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <div class="blog-item">
          <section>
            <h2>{{ title }}</h2>

            <div class="pull-right socials">
              <div class="btn-group btn-group-justified visible-xs-block"><a href="https://www.facebook.com/" id="share-facebook" class="btn btn-facebook"><i class="opencart-icon-social-facebook"></i> {{ text_facebook }}</a> <a href="https://twitter.com/" id="share-twitter" class="btn btn-twitter"><i class="opencart-icon-social-twitter"></i> {{ text_twitter }}</a></div>
              <div class="hidden-xs"><a href="https://www.facebook.com/" id="share-facebook" class="btn btn-facebook"><i class="opencart-icon-social-facebook"></i> {{ text_facebook }}</a> <a href="https://twitter.com/" id="share-twitter" class="btn btn-twitter"><i class="opencart-icon-social-twitter"></i> {{ text_twitter }}</a></div>
            </div>
            <ul class="list-unstyled">
              <li>{{ text_by }} <a href="{{ filter_author }}">{{ author }}</a></li>
              <li>{{ date_added }}</li>
              <li><a onclick="document.getElementById('comment-box').scrollIntoView(true);" href="javascript:void(0);">{{ comment_total }} {{ text_comments_lower }}</a></li>
            </ul>

            {% if image_status == 1 %}
              <figure><img src="{{ image }}" class="img-responsive"/></figure>
            {% endif %}

            <div class="main">{{ description }}</div>
            <div class="btn-group btn-group-justified visible-xs-block"><a href="https://www.facebook.com/" id="share-facebook" class="btn btn-facebook"><i class="opencart-icon-social-facebook"></i> {{ text_facebook }}</a> <a href="https://twitter.com/" id="share-twitter" class="btn btn-twitter"><i class="opencart-icon-social-twitter"></i> {{ text_twitter }}</a> <a href="https://www.reddit.com/" id="share-reddit" class="btn btn-reddit"><i class="opencart-icon-social-reddit"></i> {{ text_reddit }}</a></div>
            <div id="social-button" class="hidden-xs"><a href="https://www.facebook.com/" id="share-facebook" class="btn btn-facebook"><i class="opencart-icon-social-facebook"></i> {{ text_facebook }}</a> <a href="https://twitter.com/" id="share-twitter" class="btn btn-twitter"><i class="opencart-icon-social-twitter"></i> {{ text_twitter }}</a> <a href="https://www.reddit.com/" id="share-reddit" class="btn btn-reddit"><i class="opencart-icon-social-reddit"></i> {{ text_reddit }}</a></div>
          </section>
          <section>
            <div id="blog-newsletter-bottom" class="newsletter">
              <h4>{{ text_newsletter_title }}</h4>
              <div class="text-center">
                <p><img src="application/view/image/icon/newsletter-subscribe-icon.png" class="img-responsive"/></p>
                <p>{{ text_newsletter_desc }}</p>
              </div>
              <div>
                <div class="input-group newsletter">
                  <input type="text" name="newsletter" value="" placeholder="{{ entry_newsletter }}" class="form-control">
                  <div class="input-group-btn">
                    <button class="btn btn-primary" type="button"><i class="fa fa-angle-right"></i></button>
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
        <div id="comment-input-box">{% if not logged %}
            <div class="login-layer">
              <p>{{ text_login_comment }}</p>
              <p><a href="{{ login }}" class="btn btn-primary">{{ button_login_account }}</a></p>
            </div>
          {% endif %}
          <div class="media">
            <div class="media-left"><img src="{{ comment_image }}" alt="{{ comment_username }}" title="{{ comment_username }}" class="media-object"/></div>
            <div class="media-body">
              <div class="form-group">
                <label for="input-comment">{{ entry_comment }}</label> <textarea name="comment" placeholder="{{ entry_comment_placeholder }}" id="input-comment" class="form-control"></textarea>
              </div>
              <div class="text-right">
                <button type="button" id="button-comment" class="btn btn-primary btn-sm">{{ button_comment }}</button>
              </div>
            </div>
          </div>
        </div>
        <br/>
        <div id="comment-box"></div>
        <br/>
      </div>
      <div class="col-md-3">
        <div id="blog-search">
          <h4>{{ text_search_articles }}</h4>
          <form id="form-search">
            <div class="input-group">
              <input type="text" name="filter_search" value="{{ filter_search }}" class="form-control"/>
              <div class="input-group-btn">
                <button type="button" id="button-search" class="btn btn-default btn-xs"><i class="fa fa-search"></i></button>
              </div>
            </div>
          </form>
        </div>
        <div id="blog-newsletter">
          <h4>{{ text_newsletter_title }}</h4>
          <div class="text-center">
            <p><img src="application/view/image/icon/newsletter-subscribe-icon.png" class="img-responsive"/></p>
            <p>{{ text_newsletter_desc }}</p>
          </div>
          <div>
            <div class="input-group newsletter">
              <input type="text" name="newsletter" value="" placeholder="{{ entry_newsletter }}" class="form-control"/>
              <div class="input-group-btn">
                <button type="button" class="btn btn-primary"><i class="fa fa-angle-right"></i></button>
              </div>
            </div>
          </div>
        </div>
        <div id="side-banner">{{ banner }}</div>
        <div id="blog-trending">
          <h4>{{ text_trending }}</h4>
          <ul class="list-unstyled">
            {% for trending in trendings %}
              <li><a href="{{ trending.href }}">{{ trending.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-search').on('click', function(e) {
    var url = 'index.php?route=cms/blog';

    var filter_search = $('input[name="filter_search"]').val();

    if (filter_search != '') {
        url += '&filter_search=' + filter_search;
    }

    location = url;
});

$('input[name="filter_search"]').keydown(function(e) {
    if (e.keyCode == 13) {
        e.preventDefault();

        $('#button-search').trigger('click');
    }
});
//--></script>
<script type="text/javascript"><!--


//Start
$('#comment-box').load('index.php?route=cms/blog/comment&blog_id={{ blog_id }}');

// Page
$('#comment-box').on('click', '.pagination a', function(e) {
    e.preventDefault();

    $('#comment-box').load(this.href);
});

{% if logged %}
// Add comment
$('#button-comment').on('click', function() {
    $.ajax({
        url: 'index.php?route=cms/blog/addcomment&member_token={{ member_token }}&blog_id={{ blog_id }}',
        type: 'post',
        dataType: 'json',
        data: 'comment=' + encodeURIComponent($('textarea[name=\'comment\']').val()),
        beforeSend: function() {
            $('#button-comment').button('loading');
        },
        complete: function() {
            $('#button-comment').button('reset');
        },
        success: function(json) {
            $('.alert').remove();

            if (json['error']) {
                $('#comment-input-box').before('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }

            if (json['success']) {
                $('#comment-input-box').before('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                $('#comment-box').load('index.php?route=cms/blog/comment&blog_id={{ blog_id }}');

                $('textarea[name=\'comment\']').val('');
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
{% endif %}

// Next replies
$('#comment-box').on('click', '.btn-block', function(e) {
    e.preventDefault();

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        dataType: 'html',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(html) {
            $(element).parent().parent().parent().append(html);
            $(element).parent().remove();
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

// Reply
$('#comment-box').on('click', '.btn-link', function(e) {
    e.preventDefault();

    $(this).parent().parent().find('.reply-input-box').toggle();
});

// Add reply
$('#comment-box').on('click', '.btn-primary', function(e) {
    e.preventDefault();

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        type: 'post',
        dataType: 'json',
        data: 'comment=' + encodeURIComponent($(element).parents('.reply-input-box').find('textarea[name=\'comment\']').val()),
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            $('.alert').remove();

            if (json['error']) {
                $(element).parents('.reply-input-box').before('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }

            if (json['success']) {
                $(element).parents('.reply-input-box').before('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                $(element).parents('.reply-input-box').parents('.media').find('.reply-refresh').last().trigger('click');

                $(element).parents('.reply-input-box').find('textarea[name=\'comment\']').val('');
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

// Remove
$('#comment-box').on('click', '.comment-remove, .reply-remove', function(e) {
    e.preventDefault();

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        dataType: 'json',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(json) {
            $('.alert').remove();

            if (json['error']) {
                $(element).parent().before('<div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }

            if (json['success']) {
                $(element).parent().before('<div class="alert alert-success"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');

                $(element).parents('.media:first').remove();
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

// Refresh
$('#comment-box').on('click', '.reply-refresh', function(e) {
    e.preventDefault();

    var element = this;

    $.ajax({
        url: $(element).attr('href'),
        dataType: 'html',
        beforeSend: function() {
            $(element).button('loading');
        },
        complete: function() {
            $(element).button('reset');
        },
        success: function(html) {
            $(element).parent().replaceWith(html);
        },
        error: function(xhr, ajaxOptions, thrownError) {
            alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
