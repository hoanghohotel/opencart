{{ header }}
<div id="cms-blog">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_welcome }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container-fluid">
    <div id="category" class="container">
      <ul class="nav navbar-nav">
        {% for blog_category in blog_categories %}
        {% if blog_category.blog_category_id == filter_blog_category_id %}
        <li class="active"><a href="{{ blog_category.href }}">{{ blog_category.name }}</a></li>
        {% else %}
        <li><a href="{{ blog_category.href }}">{{ blog_category.name }}</a></li>
        {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">

        {% if is_search and not has_search_results %}
        <h3>{{ text_no_search_results }}</h3>
        <hr />
        {% endif %}   

        {% for blog in blogs %}
        <div class="blog-item">
          <a href="{{ blog.href }}"><h2 class="blog-title">{{ blog.title }}</h2></a>
          <ul class="list-unstyled">
            <li>{{ text_by }} <a href="{{ blog.filter_author }}">{{ blog.author }}</a></li>
            <li>{{ blog.date_added }}</li>
            <li>{{ blog.comment_total }} {{ text_comments }}</li>
          </ul>
          <div class="blog-image"><a href="{{ blog.href }}"><img src="{{ blog.image }}" title="{{ blog.title }}" alt="{{ blog.title }}" class="img-responsive" /></a></div>
          <div class="blog-excerpt">{{ blog.description }}</div>
          <a href="{{ blog.href }}" class="btn btn-primary hidden-xs">{{ button_continue_reading }}</a> <a href="{{ blog.href }}" class="btn btn-primary btn-block visible-xs-block">{{ button_continue_reading }}</a>
        </div>
        {% endfor %}

        <div id="paypal-banner-ad">
          <a href="index.php?route=cloud/landing">
            <img src="application/view/image/cloud/subscription_create.png" alt="" title="" class="img-responsive" />
          </a>
        </div>

        <nav>{{ pagination }}</nav>
      </div>
      <div class="col-md-3">
        <div id="blog-search">
          <h4>{{ text_search_articles }}</h4>
          <form id="form-search">
            <div class="input-group">
              <input type="text" name="filter_search" value="{{ filter_search }}" class="form-control" />
              <div class="input-group-btn">
                <button type="button" id="button-search" class="btn btn-default btn-xs"><i class="fa fa-search"></i></button>
              </div>
            </div>
          </form>
        </div>

        <div id="paypal-banner-ad">
          <a href="index.php?route=cloud/landing">
            <img src="application/view/image/cloud/subscription_create.png" alt="" title="" class="img-responsive" />
          </a>
        </div>
        <div id="blog-newsletter">
          <h4>{{ text_newsletter_title }}</h4>
          <div class="text-center">
            <p><img src="application/view/image/icon/newsletter-subscribe-icon.png" class="img-responsive" /></p>
            <p>{{ text_newsletter_desc }}</p>
          </div>
          <div>
            <div class="input-group newsletter">
              <input type="text" name="newsletter" value="" placeholder="{{ entry_newsletter }}" class="form-control">
              <div class="input-group-btn">
                <button class="btn btn-primary" type="button"><i class="fa fa-angle-right"></i></button>
              </div>
            </div>
          </div>
        </div>
        <div id="side-banner">{{ banner }}</div>
        <div id="blog-trending">
          <h4>{{ text_trending }}</h4>
          <ul class="list-unstyled">
            {% for trending in trendings %}
            <li><a href="{{ trending.href }}">{{ trending.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
  <script type="text/javascript"><!--
  $('#button-search').on('click', function(e) {
  	var url = 'index.php?route=cms/blog';

  	var filter_search = $('input[name="filter_search"]').val();

  	if (filter_search != '') {
  		url += '&filter_search=' + filter_search;
  	}

  	location = url;
  });

  $('input[name="filter_search"]').keydown(function(e) {
  	if (e.keyCode == 13) {
  		e.preventDefault();

  		$('#button-search').trigger('click');
  	}
  });
  //--></script>
{{ footer }}
