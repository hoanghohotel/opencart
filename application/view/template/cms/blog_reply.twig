<div>{% if replies %}
  {% for reply in replies %}
  <div class="media">
    <div class="media-left"><img src="{{ reply.image }}" alt="{{ reply.member }}" title="{{ reply.member }}" class="media-object" /></div>
    <div class="media-body"><div class="pull-right"><a href="{{ reply.remove }}" class="btn btn-link btn-xs reply-remove">{{ button_remove }}</a></div>
      <p class="media-heading">{{ reply.member }} <span>{{ reply.date_added }}</span> </p>
      <p>{{ reply.comment }}</p>
      {% if reply.remove %}
      <p></p>{% endif %}
    </div>
  </div>
  {% endfor %}
  {% if next %}
  <div class="text-center"><a href="{{ next }}" class="btn btn-block">{{ text_more_replies }}</a></div>
  {% endif %} 
  {% endif %}<a href="{{ refresh }}" class="reply-refresh hide">{{ text_refresh }}</a></div>
