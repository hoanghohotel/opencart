{{ header }}
<div id="cms-information">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_page_title }}</h1>
    </div>
  </div>
  <div id="information-details">
    <div id="policy">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
                <article>
                  <h2>{{ text_page_title }}</h2>
                  <hr/>
                  <p>{{ text_privacy_intro }}</p>
                  <h3>{{ text_collection_title }}</h3>
                  <p>{{ text_collection_desc }}</p>
                  <ol>
                    <li>{{ text_collection_item_1 }}</li>
                    <li>{{ text_collection_item_2 }}</li>
                    <li>{{ text_collection_item_3 }}</li>
                    <li>{{ text_collection_item_4 }}</li>
                    <li>{{ text_collection_item_5 }}</li>
                    <li>{{ text_collection_item_6 }}</li>
                  </ol>

                  <h3>{{ text_use_title }}</h3>
                  <p>{{ text_use_p1 }}</p>
                  <p>{{ text_use_p2 }}</p>
                  <ol>
                    <li>{{ text_use_item_1 }}</li>
                    <li>{{ text_use_item_2 }}</li>
                    <li>{{ text_use_item_3 }}</li>
                    <li>{{ text_use_item_4 }}</li>
                    <li>{{ text_use_item_5 }}</li>
                  </ol>
                  <h3>{{ text_deletion_title }}</h3>
                  <p>{{ text_deletion_desc_1 }} <a href="mailto:{{ contact_support }}">{{ contact_support }}</a> {{ text_deletion_desc_2 }}</p>
                  <p><br/></p>
                  <p class="text-right"><small><i>{{ text_last_updated }}</i></small></p>
                </article>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
{{ footer }}
