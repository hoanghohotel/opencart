  <div class="container">
    <ul class="nav nav-tabs">
      {% for showcase_category in showcase_categories %}
      {% if showcase_category.showcase_category_id == filter_showcase_category_id %}
      <li class="active"><a href="{{ showcase_category.href }}">{{ showcase_category.name }}</a></li>
      {% else %}
      <li><a href="{{ showcase_category.href }}">{{ showcase_category.name }}</a></li>
      {% endif %}
      {% endfor %}
    </ul>
    {% for row in showcases|batch(3, '') %}
    <div class="row">
       {% for showcase in row %}
       <div class="col-sm-4">

         <div class="showcase-link">
           <div>
             <a href="{{ showcase.link }}" target="_blank">{{ text_view_project }}</a>
           </div>
            <a href="{{ showcase.link }}" target="_blank"><img src="{{ showcase.image }}" alt="{{ showcase.name }}"  title="{{ showcase.name }}" class="img-responsive" /></a>
        </div>
         <h4>{{ showcase.name }}</h4>
         <h6>{{ showcase.category }}</h6>
       </div>
       {% endfor %}
     </div>
    {% endfor %}
    <nav>{{ pagination }}</nav>
  </div>
