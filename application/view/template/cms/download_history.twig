{{ header }}
<div id="cms-download-history">
  <div class="container">
    <section>
      <div class="row">
        <div class="col-md-9">
          <div id="steps">
            <h2>{{ text_how_to_install }}</h2>
            <ul>
              <li>
                <h2>1</h2>
                <h4>{{ text_step_1_title }}</h4>
                <p>{{ text_step_1_desc }}</p>
                <div class="arrow arrow-color"></div>
                <div class="arrow arrow-border"></div>
              </li>
              <li>
                <h2>2</h2>
                <h4>{{ text_step_2_title }}</h4>
                <p>{{ text_step_2_desc }}</p>
                <div class="arrow arrow-color"></div>
                <div class="arrow arrow-border"></div>
              </li>
              <li>
                <h2>3</h2>
                <h4>{{ text_step_3_title }}</h4>
                <p>{{ text_step_3_desc }}</p>
              </li>
            </ul>
          </div>

          <div>
            <h2>{{ text_previous_notes_title }}</h2>
            <ul class="nav nav-tabs">
              <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_previous }}</a></li>
              <li><a href="#tab-history" data-toggle="tab">{{ tab_release_notes }}</a></li>
            </ul>
            <div class="tab-content">
              <div id="tab-general" class="tab-pane active">
                <div class="table-responsive">
                  <table class="table table-bordered">
                    <thead>
                      <tr>
                        <th>{{ column_version }}</th>
                        <th>{{ column_date_added }}</th>
                        <th class="text-right">{{ column_action }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% if downloads %}
                        {% for download in downloads %}
                          <tr>
                            <td>{{ download.name }}</td>
                            <td>{{ download.date_added }}</td>
                            <td class="text-right"><a href="{{ download.href }}" data-toggle="tooltip" title="{{ button_download }} {{ download.name }}" class="btn btn-primary"><i class="fa fa-download"></i></a></td>
                          </tr>
                        {% endfor %}
                      {% else %}
                        <tr>
                          <td class="text-center" colspan="3">{{ text_no_results }}</td>
                        </tr>
                      {% endif %}
                    <tbody>
                  </table>
                </div>
                <nav>{{ pagination }}</nav>
              </div>
              <div id="tab-history" class="tab-pane">
                <div class="table-responsive">
                  <table class="table table-bordered">
                    <thead>
                      <tr>
                        <th>{{ column_version }}</th>
                        <th>{{ column_release_notes }}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {% if downloads %}
                        {% for download in downloads %}
                          <tr>
                            <td>{{ download.name }}</td>
                            <td>{{ download.description }}</td>
                          </tr>
                        {% endfor %}
                      {% else %}
                        <tr>
                          <td class="text-center" colspan="2">{{ text_no_results }}</td>
                        </tr>
                      {% endif %}
                    <tbody>
                  </table>
                </div>
                <nav>{{ pagination }}</nav>
              </div>
            </div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="well">
            <h3>{{ text_other_options }}</h3>
            <p><img src="application/view/image/partner/github.png" height="40" alt="" title=""/>
              <br/>
              {{ text_github_desc }} <a href="https://github.com/opencart/opencart">{{ text_visit_repo }}</a>.
            </p>
            <p><img src="application/view/image/partner/softaculous.gif" height="40" alt="" title=""/>
              <br/>
              {{ text_softaculous_desc }} <a href="https://www.softaculous.com/softaculous/apps/ecommerce/OpenCart">{{ text_learn_more }}</a>.
            </p>
            <p><img src="application/view/image/partner/amazon-webservices.png" height="40" alt="" title=""/>
              <br/>
              {{ text_aws_desc }} <a href="https://aws.amazon.com/marketplace/search/results?x=0&y=0&searchTerms=opencart&page=1&ref_=nav_search_box">{{ text_learn_more }}</a>.
            </p>
          </div>
          <div id="side-banner">{{ banner }}</div>
          <div class="well">
            <h3>{{ text_requirements }}</h3>
            {{ text_requirements_desc }}
            <ul class="list-check  list-color-blue">
              <li>{{ text_req_webserver }}</li>
              <li>{{ text_req_php_history }}</li>
              <li>{{ text_req_curl }}</li>
              <li>{{ text_req_db }}</li>
            </ul>
          </div>
        </div>
      </div>
  </div>
  <div class="container-fluid">
    <div class="container">
      <h2>{{ text_partner_cta_title }}</h2>
      <h3>{{ text_partner_cta_subtitle }}</h3>
      <p>
        <a href="{{ partner }}" class="btn btn-primary btn-lg hidden-xs">{{ button_view_partners }}</a> <a href="{{ partner }}" class="btn btn-primary btn-lg btn-block visible-xs-block">{{ button_view_partners }}</a>
      </p>
    </div>
  </div>
</div>
{{ footer }}
