{{ header }}
<div id="account-account">
  <div class="page-header">
    <div class="container">
      <h1>Cloud Invoice</h1>
      <p>Check your invoice(s)</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <fieldset>
          <legend>Invoice #INV190318OCC</legend>

          <table class="table table-bordered">
            <thead>
              <tr>
                <th>Item</th>
                <th>Qty.</th>
                <th class="text-right">Amount</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>OpenCart Cloud Bronze Service</td>
                <td>1 YR</td>
                <td class="text-right">US$350.00</td>
              </tr>
            </tbody>
          </table>

          <div class="row">
            <div class="col-sm-6"><label>Total Amount</label></div>
            <div class="col-sm-6"><p class="text-right">US$350.00</p></div>
          </div>
          <div class="row">
            <div class="col-sm-6"><label>Invoice Date</label></div>
            <div class="col-sm-6"><p class="text-right">01 JAN, 2017</p></div>
          </div>
          <div class="row">
            <div class="col-sm-6"><label>Payment Method</label></div>
            <div class="col-sm-6"><p class="text-right">Paypal (example@gmail.com)</p></div>
          </div>

        </fieldset>

        <fieldset>
          <legend>Bill To</legend>

          <div class="row">
            <div class="col-sm-3"><label>Company</label></div>
            <div class="col-sm-9">N/A</div>
          </div>
          <div class="row">
            <div class="col-sm-3"><label>Name</label></div>
            <div class="col-sm-9">John Don</div>
          </div>
          <div class="row">
            <div class="col-sm-3"><label>Billing Address</label></div>
            <div class="col-sm-9">237 Ferry Street Anniston Alabama, 36201</div>
          </div>

          <div class="row">
            <div class="col-sm-3"><label>Contact</label></div>
            <div class="col-sm-9">256-770-7845</div>
          </div>

        </fieldset>

        <div class="text-right">
          <a href="#" class="btn btn-link">Cancel</a>
          <a href="#" class="btn btn-default"><i class="fa fa-print fa-fw"></i> Print</a>
        </div>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
