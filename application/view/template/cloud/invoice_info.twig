{{ header }}
<div id="account-account">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_heading }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <fieldset>
          <legend>{{ text_invoice }} #INV190318OCC</legend>

          <table class="table table-bordered">
            <thead>
              <tr>
                <th>{{ column_item }}</th>
                <th>{{ column_qty }}</th>
                <th class="text-right">{{ column_amount }}</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>{{ text_service_bronze }}</td>
                <td>1 YR</td>
                <td class="text-right">US$350.00</td>
              </tr>
            </tbody>
          </table>

          <div class="row">
            <div class="col-sm-6"><label>{{ text_total_amount }}</label></div>
            <div class="col-sm-6"><p class="text-right">US$350.00</p></div>
          </div>
          <div class="row">
            <div class="col-sm-6"><label>{{ text_invoice_date }}</label></div>
            <div class="col-sm-6"><p class="text-right">01 JAN, 2017</p></div>
          </div>
          <div class="row">
            <div class="col-sm-6"><label>{{ text_payment_method }}</label></div>
            <div class="col-sm-6"><p class="text-right">Paypal (example@gmail.com)</p></div>
          </div>

        </fieldset>

        <fieldset>
          <legend>{{ text_bill_to }}</legend>

          <div class="row">
            <div class="col-sm-3"><label>{{ text_company }}</label></div>
            <div class="col-sm-9">N/A</div>
          </div>
          <div class="row">
            <div class="col-sm-3"><label>{{ text_name }}</label></div>
            <div class="col-sm-9">John Don</div>
          </div>
          <div class="row">
            <div class="col-sm-3"><label>{{ text_billing_address }}</label></div>
            <div class="col-sm-9">237 Ferry Street Anniston Alabama, 36201</div>
          </div>

          <div class="row">
            <div class="col-sm-3"><label>{{ text_contact }}</label></div>
            <div class="col-sm-9">256-770-7845</div>
          </div>

        </fieldset>

        <div class="text-right">
          <a href="#" class="btn btn-link">{{ button_cancel }}</a>
          <a href="#" class="btn btn-default"><i class="fa fa-print fa-fw"></i> {{ button_print }}</a>
        </div>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
