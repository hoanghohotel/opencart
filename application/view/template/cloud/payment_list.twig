{{ header }}
<div id="account-account">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_heading }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <fieldset>
          <legend>{{ text_payment_methods }}</legend>
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th class="text-left">{{ column_gateway }}</th>
                  <th class="text-left">{{ column_account }}</th>
                  <th class="text-left">{{ column_status }}</th>
                  <th class="text-right">{{ column_action }}</th>
                </tr>
              </thead>
              <tbody>
              <tr>
                <td class="text-left">Paypal</td>
                <td class="text-left">example@gmail.com</td>
                <td class="text-left"><span class="label label-success">{{ text_enabled }}</span></td>
                <td class="text-right">
                <a href="#" class="btn btn-primary"><i class="fa fa-pencil fa-fw"></i> {{ button_edit }}</a>
                </td>
              </tr>


              <tr>
                <td class="text-left">Braintree</td>
                <td class="text-left">example2@gmail.com</td>
                <td class="text-left"><span class="label label-danger">{{ text_disabled }}</span></td>
                <td class="text-right">
                <a href="#" class="btn btn-primary"><i class="fa fa-pencil fa-fw"></i> {{ button_edit }}</a>
                </td>
              </tr>


              <tr class="hidden">
                <td class="text-center" colspan="5">{{ text_no_results }}</td>
              </tr>

              </tbody>

            </table>
          </div>
        </fieldset>

        <div class="buttons">
          <div class="text-right">
            <a href="#" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> {{ button_add_payment }}</a>
          </div>
        </div>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
