{{ header }}
<div id="account-account">
  <div class="page-header">
    <div class="container">
      <h1>Cloud Invoice</h1>
      <p>Check your invoice(s)</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <fieldset>
          <legend>Your Cloud Invoice(s)</legend>
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <th class="text-left">Invoice No.</th>
                  <th class="text-left">Amount</th>
                  <th class="text-left">Add Date</th>
                  <th class="text-right">Action</th>
                </tr>
              </thead>
              <tbody>
              <tr>
                <td class="text-left">INV190318OCC</td>
                <td class="text-left">US$350.00</td>
                <td class="text-left">01 JAN, 2017</td>
                <td class="text-right">
                  <a href="" class="btn btn-primary"><i class="fa fa-eye fa-fw"></i> View details</a>
                </td>
              </tr>

              <tr>
                <td class="text-left">INV197568OCC</td>
                <td class="text-left">US$35.00</td>
                <td class="text-left">11 FEB, 2017</td>
                <td class="text-right">
                  <a href="" class="btn btn-primary"><i class="fa fa-eye fa-fw"></i> View details</a>
                </td>
              </tr>

              <tr class="hidden">
                <td class="text-center" colspan="3">No record!</td>
              </tr>

              </tbody>

            </table>
          </div>
        </fieldset>
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
