							<span class="cloud-pricing--card-block_price__amount">199</span>
							<span class="cloud-pricing--card-block_price__monthly">{{ text_per_month }}</span>
						</span>
						</div>
						<div class="col-md-12 col-md-12 cloud-pricing--card-block_description-block text-center">
							<span class="cloud-pricing--card-block_description">{{ text_plan_gold_desc }}</span>
						</div>
