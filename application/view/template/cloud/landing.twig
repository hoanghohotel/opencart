						<div class="col-md-12 col-md-12 cloud-pricing--card-block_description-block text-center">
							<span class="cloud-pricing--card-block_description">{{ text_plan_silver_desc }}</span>
						</div>
					</div>
				</div>
				<div class="col-md-4 col-sm-4 cloud-pricing--card-block" style="height: 280px;">
					<div class="row">
						<div class="col-md-12 cloud-pricing--card-block_heading-block text-center">
							<span class="cloud-pricing--card-block_heading">{{ text_plan_gold }}</span>
						</div>
						<div class="col-md-12 cloud-pricing--card-block_price-block text-center">
