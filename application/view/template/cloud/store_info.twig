{{ header }}
<div id="account-subscription-info">
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
        {% endif %}
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}
        <!--
        {% if "now"|date('Y-m-d') < store.date_trial_expire|date('Y-m-d') %}
            <div class="alert alert-info">Your Cloud Store is free on the trial plan until {{ store.date_trial_expire|date('Y-m-d') }}</div>
        {% else %}
          {% if store.plan_id == 1 %}
            <div class="alert alert-warning">Your Cloud Store trial has now expired. Please <a href="{{ link_change_plan }}" title="Choose a new plan for your Cloud Store">choose a new plan</a></div>
          {% endif %}
        {% endif %}
        -->
        {% if store is not empty %}
          {% if store.status_code == "ACTIVE" %}
            <ul class="nav nav-tabs">
              <li class="active"><a data-toggle="tab" href="#info-tab">Store info</a></li>
              <li><a data-toggle="tab" href="#domain-tab">Domains</a></li>
              <li><a data-toggle="tab" href="#backup-tab">Backups</a></li>
              <!--<li><a data-toggle="tab" href="#plan-tab">Plan</a></li>-->
            </ul>

            <!-- Tab-pane content -->
            <div class="tab-content">
              <div id="info-tab" class="tab-pane fade in active">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>Store Information</h4>
                  </div>
                  <div class="panel-body">
                    <div class="row">
                      <div class="col-sm-3"><strong>Cloud Store ID #</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.store_id }}</p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>Store Created</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.date_added|date("d/m/Y") }}</p>
                      </div>
                    </div>
                    {% if "now"|date('Y-m-d') < store.date_trial_expire|date('Y-m-d') %}
                      <div class="row">
                        <div class="col-sm-3"><strong>Trial Expires</strong></div>
                        <div class="col-sm-9">
                          <p class="form-static">{{ store.date_trial_expire|date("d/m/Y") }}</p>
                        </div>
                      </div>
                    {% endif %}
                    <div class="row">
                      <div class="col-sm-3"><strong>Store Name</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.store_name }}</p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>Store URL</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static"><a href="http://{{ store.url_temp }}" target="_blank">{{ store.url_temp }} <i class="fa fa-external-link"></i></a></p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>Store Admin URL</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static"><a href="http://{{ store.url_temp }}/admin" target="_blank">{{ store.url_temp }}/admin <i class="fa fa-external-link"></i></a></a></p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>Admin user</strong></div>
                      <div class="col-sm-3"><p class="form-static">{{ store.config.store_user }}</p></div>
                      <div class="col-sm-3"><strong>Admin password</strong> <a style="margin-left:15px; vertical-align:middle;" class="label label-info" id="password-view">View</a></div>
                      <div class="col-sm-3"><p class="form-static"><span id="store-admin-password">**********</span></p></div>
                    </div>
                    <div class="row">
                      <div class="col-sm-12">
                        <p class="form-static">* You may have changed your username and/or password in the store admin area, they will not update here</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div id="domain-tab" class="tab-pane fade">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>Domains / URLs
                      <span class="btn-group pull-right">
                        <a class="btn btn-primary" href="{{ link_add_url }}"><i class="fa fa-plus fa-fw"></i> Add URL</a>
                      </span>
                    </h4>
                  </div>
                  <div class="panel-body">
                    <div class="row">
                      <div class="col-sm-12">
                        {% if store.urls is empty %}
                          <p class="form-static">You don't have any urls setup yet</p>
                        {% else %}
                          <div class="table-responsive margin-top">
                            <table class="table table-bordered">
                              <thead>
                              <tr>
                                <th class="col-sm-7">URL</th>
                                <th class="text-center col-sm-1">SSL</th>
                                <th class="text-center col-sm-1">Verified</th>
                                <th class="text-center col-sm-1">Default</th>
                                <th class="text-right col-sm-2">Actions</th>
                              </tr>
                              </thead>
                              <tbody>
                              <tr>
                                <td><a href="{% if store.url_temp_ssl == 1 %}https://{% else %}http://{% endif %}{{ store.url_temp }}" target="_blank" title="Click to view store">{{ store.url_temp }}</a></td>
                                <td class="text-center">{% if store.url_temp_ssl == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                <td class="text-center"><i class="fa fa-check fa-fw"></i></td>
                                <td class="text-center"></td>
                                <td class="text-right"></td>
                              </tr>
                              {% for url in store.urls %}
                                <tr>
                                  <td><a href="{% if url.ssl_enabled == 1 %}https://{% else %}http://{% endif %}{{ url.url }}" target="_blank" data-toggle="tooltip" data-placement="top" title="Click to view store">{{ url.url }}</a></td>
                                  <td class="text-center">{% if url.ssl_pending == 1 %}<h6><span class="label label-warning">Updating</span></h6>{% else %}{% if url.ssl_enabled == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i>{% endif %}{% endif %}</td>
                                  <td class="text-center">{% if url.dns_check == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                  <td class="text-center">{% if url.default == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                  <td class="text-right">
                                    <button class="btn btn-sm btn-info" title="Edit URL" data-toggle="modal" data-target="#url-modal-{{ url.store_url_id }}"><i class="fa fa-pencil fa-fw"></i></button>
                                    <a class="btn btn-sm btn-danger button-click-load button-use-confirm" href="{{ link_delete_url }}{{ url.store_url_id }}" data-toggle="tooltip" data-placement="top" title="Delete URL"><i class="fa fa-trash-o fa-fw"></i></a>
                                  </td>
                                </tr>
                              {% endfor %}
                              </tbody>
                            </table>
                          </div>
                        {% endif %}
                      </div>
                    </div>

                  </div>
                </div>
              </div>
              <div id="backup-tab" class="tab-pane fade">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>Manual Backups
                      <span class="btn-group pull-right">
                        <a href="{{ link_request_backup }}" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> New backup</a>
                      </span>
                    </h4>
                  </div>
                  <div class="panel-body">
                    <p>Before making changes to your store you should take a manual backup.</p>
                    <div class="row">
                      <div class="col-sm-12">
                        {% if store.manual_backups is empty %}
                          <p class="form-static">You don't have any manual backups</p>
                        {% else %}
                          <div class="table-responsive margin-top">
                            <table class="table table-bordered table-condensed">
                              <thead>
                              <tr>
                                <th class="text-center col-sm-2">Started</th>
                                <th class="text-center col-sm-2">Completed</th>
                                <th class="text-left col-sm-6">Comment</th>
                                <th class="text-right col-sm-2">Actions</th>
                              </tr>
                              </thead>
                              <tbody>
                              {% for backup in store.manual_backups %}
                                <tr>
                                  <td class="text-center small">{{ backup.date_started|date("d/m/Y H:i") }}</td>
                                  <td class="text-center small">
                                    {% if backup.date_completed == '0000-00-00 00:00:00' %}
                                      <label class="label label-success">Running</label>
                                    {% else %}
                                      {{ backup.date_completed|date("d/m/Y H:i") }}
                                    {% endif %}
                                  </td>
                                  <td class="text-left small">{{ backup.comment }}</td>
                                  <td class="text-right">
                                    {% if backup.delete_requested == 1 %}
                                      <label class="label label-danger">Deleting</label>
                                    {% else %}
                                      <a class="btn btn-sm btn-danger button-click-load button-use-confirm" href="{{ link_delete_backup }}{{ backup.store_backup_id }}" data-toggle="tooltip" data-placement="top" title="Delete Backup"><i class="fa fa-trash-o fa-fw"></i></a>
                                    {% endif %}
                                  </td>
                                </tr>
                              {% endfor %}
                              </tbody>
                            </table>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>Automated Backups</h4>
                  </div>
                  <div class="panel-body">
                    <p>If you have not taken a manual backup yet, but you can use an automated one instead.</p>
                    <form action="{{ backup_restore_action }}" method="post" enctype="multipart/form-data" id="restore-backup-form">
                      <div class="row">
                        <div class="col-sm-5">
                          <select id="input-restore-backup" class="form-control col-sm-4">
                            <option value="" selected disabled>View backups</option>
                            {% for backup in store.automatic_backups %}
                              {% if backup.date_completed != '0000-00-00 00:00:00' %}
                                <option value="{{ backup.store_backup_id }}">{{ backup.date_completed|date("d/m/Y H:i") }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                        <!--<div class="col-sm-2"><button type="submit" class="btn btn-primary" id="backup-submit-button">Restore</button></div>-->
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            <!--
              <div id="plan-tab" class="tab-pane fade">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>Plan information
                      <span class="btn-group pull-right">
                        <a href="{{ link_change_plan }}" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> Change plan</a>
                      </span>
                    </h4>
                  </div>
                  <div class="panel-body">
                    <div class="row">
                      <div class="col-sm-12">
                        <div class="table-responsive margin-top">
                          <table class="table table-striped">
                            <tbody>
                            <tr>
                              <td><strong>Name</strong></td>
                              <td>{{ store.plan.name }}</td>
                            </tr>
                            {% if store.plan.plan_id == 1 %}
                              <tr>
                                <td><strong>Cost</strong></td>
                                <td>FREE</td>
                              </tr>
                            {% else %}
                              {% if store.plan.billing_option %}
                                <tr>
                                  <td><strong>Price</strong></td>
                                  <td>&pound;{{ store.plan.billing_option.cost|number_format(2, '.') }}</td>
                                </tr>
                                <tr>
                                  <td><strong>Period</strong></td>
                                  <td>{{ store.plan.billing_option.period_months }}</td>
                                </tr>
                              {% endif %}
                            {% endif %}

                            {% for plan_attribute in store.plan.attributes %}
                                <tr>
                                  <td><strong>{{ plan_attribute.name }}</strong></td>
                                  <td>{{ plan_attribute.value_display }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                          </table>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            -->
            </div>
            <div class="buttons">
              <div class="text-left">
                <a href="{{ link_store_list }}" class="btn btn-default"><i class="fa fa-arrow-left"></i>&nbsp;&nbsp;Cloud Stores</a>
              </div>
            </div>

            <!-- Modal Windows -->
            {% for url in store.urls %}
              <div class="modal fade" id="url-modal-{{ url.store_url_id }}" tabindex="-1" role="dialog" aria-labelledby="url-modal-{{ url.store_url_id }}-label">
                <div class="modal-dialog" role="document">
                  <div class="modal-content">
                    <div class="modal-header">
                      <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                      <h4 class="modal-title" id="url-modal-{{ url.store_url_id }}-label">Edit store URL</h4>
                    </div>
                    <div class="modal-body">
                      <div class="row">
                        <div class="col-sm-12">
                            {% if url.dns_check == 0 %}
                            <div id="dns-status-alert-{{ url.store_url_id }}"><div class="alert alert-danger"><i class="fa fa-times fa-fw"></i> This URL is not pointing at your Cloud Store yet</div></div>
                              <p class="dns-status-{{ url.store_url_id }}">Add this CNAME to your domains DNS, it can take a few hours to work</p>
                              <div class="form-horizontal dns-status-{{ url.store_url_id }}">
                                <div class="form-group">
                                  <label class="col-sm-2">CNAME</label>
                                  <div class="col-sm-7">
                                      <input type="text" class="form-control text-center" value="mystore.stores-1.opencartcloud.com" />
                                  </div>
                                  <label class="col-sm-3"><button class="btn btn-info test-dns" value="{{ url.store_url_id }}">Test DNS</button></label>
                                </div>
                              </div>
                            {% else %}
                              <div class="alert alert-success"><i class="fa fa-check"></i> Your url is setup correctly</div>
                            {% endif %}
                        </div>
                      </div>

                      <div id="dns-verified-{{ url.store_url_id }}" {% if url.dns_check == 0 %}style="display:none;"{% endif %}>
                        <div class="row">
                          <div class="col-sm-7"><label class="control-label form-control-static">Set this domain as the main URL?</label></div>
                          <div class="col-sm-5" id="default-url-update-{{ url.store_url_id }}">
                            {% if url.default == 1 %}
                              <h6><span class="label label-success"><i class="fa fa-check fa-fw"></i></span></h6>
                            {% else %}
                              <div class="radio">
                                <input class="default-url" type="checkbox" value="{{ url.store_url_id }}" />
                              </div>
                            {% endif %}
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-sm-7"><label class="control-label form-control-static">Enable SSL on the domain?</label></div>
                          <div class="col-sm-5" id="ssl-update-{{ url.store_url_id }}">
                            {% if url.ssl_pending == 1 %}
                              <h6><span class="label label-warning">Updating</span></h6>
                            {% else %}
                              <div class="radio">
                                {% if url.ssl_enabled == 1 %}
                                  <h6><span class="label label-success"><i class="fa fa-check fa-fw"></i></span></h6>
                                {% else %}
                                    <input class="enable-ssl" type="checkbox" value="{{ url.store_url_id }}" />
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-sm-12">
                            <div class="help-block">SSL certificates are <u>FREE</u> and provided by <a href="https://letsencrypt.org/" rel="nofollow" target="_blank">LetsEncrypt.org</a></div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% elseif store.status_code == "SETUP_REQUESTED" or store.status_code == "SETUP_QUEUED" or store.status_code == "SETUP_STARTED" %}
            <div class="alert alert-info">Store setup is still in process. <a href="{{ link_creating_url }}">Click here</a> to view the progress.</div>
          {% else %}
            <div class="alert alert-warning">Unable to load store information</div>
          {% endif %}
        {% else %}
          <div class="alert alert-warning">Unable to load account information</div>
        {% endif %}
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
<script type="text/javascript"><!--
  $('body').on('click', '.default-url', function (event) {
    var store_url_id = $(this).val();

    if (confirm("Are you sure?")) {
      $.ajax({
          url: 'index.php?route=cloud/store/defaulturl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
          type: 'get',
          dataType: 'json',
          beforeSend: function() {
            $('#default-url-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> Updating</span></h6>');
          },
          success: function(json) {
              if (json.success) {
                $('#default-url-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
              } else {
                $('#default-url-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
              }
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
    } else {
        $(this).prop("checked", false);
    }
  });

  $('body').on('click', '.test-dns', function (event) {
  var store_url_id = $(this).val();

  $.ajax({
      url: 'index.php?route=cloud/store/testurl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
      type: 'get',
      dataType: 'json',
      beforeSend: function() {
        $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-info" id="testing-dns-' + store_url_id + '"><i class="fa fa-refresh fa-spin fa-fw"></i> Checking domain status</div>');
      },
      success: function(json) {
          if (json.header_code == 200) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-success"><i class="fa fa-check fa-fw"></i> The URL is now working perfectly!</div>');
            $('.dns-status-' + store_url_id).hide();
            $('#dns-verified-' + store_url_id).show();
          } else if (json.header_code == 404) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-times fa-fw"></i> The URL is not pointing at your Cloud Store yet</div>');
          } else if (json.header_code > 0) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-question fa-fw"></i> Unable to check the status, response header code was "'+json.header_code+'"</div>');
          } else {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-question fa-fw"></i> Unable to check the status, please try later</div>');
          }

          $('#testing-dns-' + store_url_id).remove();
      },
      error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
  });
  });

  $('body').on('change', '.enable-ssl', function (event) {
    var store_url_id = $(this).val();

    if (confirm("Are you sure?")) {
        if ($(this).is(":checked")) {
            $.ajax({
                url: 'index.php?route=cloud/store/addssl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
                type: 'get',
                dataType: 'json',
                beforeSend: function () {
                    $('#ssl-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> Requesting SSL</span></h6>');
                    //$('#ssl-update-' + store_url_id).html('<div class="alert alert-info"><i class="fa fa-refresh fa-spin fa-fw"></i> Requesting SSL</div>');
                },
                success: function (json) {
                    if (json.success) {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
                    } else {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        } else {
            $.ajax({
                url: 'index.php?route=cloud/store/deletessl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
                type: 'get',
                dataType: 'json',
                beforeSend: function () {
                    $('#ssl-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> Removing SSL</span></h6>');
                },
                success: function (json) {
                    if (json.success) {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
                    } else {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        }
    } else {
        // some backwards logic here
        if ($(this).is(":checked")) {
            $(this).prop("checked", false);
        } else {
            $(this).prop("checked", true);
        }
    }
  });

  $('body').on('click', '.button-click-load', function (event) {
    $(this).html('<i class="fa fa-refresh fa-spin fa-fw"></i>').prop("disabled", "disabled");
  });

  $('body').on('click', '#password-view', function (event) {
    event.preventDefault();

    if ($('#store-admin-password').text() == '**********') {
        $('#store-admin-password').text('{{ store.config.store_password }}');
        $('#password-view').text('Hide');
    } else {
        $('#store-admin-password').text('**********');
        $('#password-view').text('View');
    }
  });

  $('.button-use-confirm').on('click', function () {
    return confirm('Are you sure?');
  });
//--></script>
