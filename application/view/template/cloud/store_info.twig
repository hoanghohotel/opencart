{{ header }}
<div id="account-subscription-info">
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        {% if error_warning %}
          <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
        {% endif %}
        {% if success %}
          <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}</div>
        {% endif %}
        {% if store is not empty %}
          {% if store.status_code == "ACTIVE" %}
            <ul class="nav nav-tabs">
              <li class="active"><a data-toggle="tab" href="#info-tab">{{ tab_info }}</a></li>
              <li><a data-toggle="tab" href="#domain-tab">{{ tab_domain }}</a></li>
              <li><a data-toggle="tab" href="#backup-tab">{{ tab_backup }}</a></li>
            </ul>

            <!-- Tab-pane content -->
            <div class="tab-content">
              <div id="info-tab" class="tab-pane fade in active">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>{{ text_store_information }}</h4>
                  </div>
                  <div class="panel-body">
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_cloud_store_id }}</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.store_id }}</p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_store_created }}</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.date_added|date("d/m/Y") }}</p>
                      </div>
                    </div>
                    {% if "now"|date('Y-m-d') < store.date_trial_expire|date('Y-m-d') %}
                      <div class="row">
                        <div class="col-sm-3"><strong>{{ text_trial_expires }}</strong></div>
                        <div class="col-sm-9">
                          <p class="form-static">{{ store.date_trial_expire|date("d/m/Y") }}</p>
                        </div>
                      </div>
                    {% endif %}
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_store_name_label }}</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static">{{ store.store_name }}</p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_store_url }}</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static"><a href="http://{{ store.url_temp }}" target="_blank">{{ store.url_temp }} <i class="fa fa-external-link"></i></a></p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_store_admin_url }}</strong></div>
                      <div class="col-sm-9">
                        <p class="form-static"><a href="http://{{ store.url_temp }}/admin" target="_blank">{{ store.url_temp }}/admin <i class="fa fa-external-link"></i></a></a></p>
                      </div>
                    </div>
                    <div class="row">
                      <div class="col-sm-3"><strong>{{ text_admin_user }}</strong></div>
                      <div class="col-sm-3"><p class="form-static">{{ store.config.store_user }}</p></div>
                      <div class="col-sm-3"><strong>{{ text_admin_password }}</strong> <a style="margin-left:15px; vertical-align:middle;" class="label label-info" id="password-view">{{ text_view }}</a></div>
                      <div class="col-sm-3"><p class="form-static"><span id="store-admin-password">**********</span></p></div>
                    </div>
                    <div class="row">
                      <div class="col-sm-12">
                        <p class="form-static">{{ text_password_notice }}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              <div id="domain-tab" class="tab-pane fade">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>{{ text_domains_urls }}
                      <span class="btn-group pull-right">
                        <a class="btn btn-primary" href="{{ link_add_url }}"><i class="fa fa-plus fa-fw"></i> {{ button_add_url }}</a>
                      </span>
                    </h4>
                  </div>
                  <div class="panel-body">
                    <div class="row">
                      <div class="col-sm-12">
                        {% if store.urls is empty %}
                          <p class="form-static">{{ text_no_urls }}</p>
                        {% else %}
                           <div class="table-responsive margin-top">
                            <table class="table table-bordered">
                              <thead>
                              <tr>
                                <th class="col-sm-7">{{ column_url }}</th>
                                <th class="text-center col-sm-1">{{ column_ssl }}</th>
                                <th class="text-center col-sm-1">{{ column_verified }}</th>
                                <th class="text-center col-sm-1">{{ column_default }}</th>
                                <th class="text-right col-sm-2">{{ column_actions }}</th>
                              </tr>
                              </thead>
                              <tbody>
                              <tr>
                                <td><a href="{% if store.url_temp_ssl == 1 %}https://{% else %}http://{% endif %}{{ store.url_temp }}" target="_blank" title="{{ text_click_view_store }}">{{ store.url_temp }}</a></td>
                                <td class="text-center">{% if store.url_temp_ssl == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                <td class="text-center"><i class="fa fa-check fa-fw"></i></td>
                                <td class="text-center"></td>
                                <td class="text-right"></td>
                              </tr>
                              {% for url in store.urls %}
                                <tr>
                                  <td><a href="{% if url.ssl_enabled == 1 %}https://{% else %}http://{% endif %}{{ url.url }}" target="_blank" data-toggle="tooltip" data-placement="top" title="{{ text_click_view_store }}">{{ url.url }}</a></td>
                                  <td class="text-center">{% if url.ssl_pending == 1 %}<h6><span class="label label-warning">{{ text_updating }}</span></h6>{% else %}{% if url.ssl_enabled == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i>{% endif %}{% endif %}</td>
                                  <td class="text-center">{% if url.dns_check == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                  <td class="text-center">{% if url.default == 1 %} <i class="fa fa-check fa-fw"></i> {% else %} <i class="fa fa-times fa-fw"></i> {% endif %}</td>
                                  <td class="text-right">
                                    <button class="btn btn-sm btn-info" title="{{ button_edit_url }}" data-toggle="modal" data-target="#url-modal-{{ url.store_url_id }}"><i class="fa fa-pencil fa-fw"></i></button>
                                    <a class="btn btn-sm btn-danger button-click-load button-use-confirm" href="{{ link_delete_url }}{{ url.store_url_id }}" data-toggle="tooltip" data-placement="top" title="{{ button_delete_url }}"><i class="fa fa-trash-o fa-fw"></i></a>
                                  </td>
                                </tr>
                              {% endfor %}
                              </tbody>
                            </table>
                          </div>
                        {% endif %}
                      </div>
                    </div>

                  </div>
                </div>
              </div>
              <div id="backup-tab" class="tab-pane fade">
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>{{ text_manual_backups }}
                      <span class="btn-group pull-right">
                        <a href="{{ link_request_backup }}" class="btn btn-primary"><i class="fa fa-plus fa-fw"></i> {{ button_new_backup }}</a>
                      </span>
                    </h4>
                  </div>
                  <div class="panel-body">
                    <p>{{ text_manual_backup_desc }}</p>
                    <div class="row">
                      <div class="col-sm-12">
                        {% if store.manual_backups is empty %}
                          <p class="form-static">{{ text_no_manual_backups }}</p>
                        {% else %}
                          <div class="table-responsive margin-top">
                            <table class="table table-bordered table-condensed">
                              <thead>
                              <tr>
                                <th class="text-center col-sm-2">{{ column_started }}</th>
                                <th class="text-center col-sm-2">{{ column_completed }}</th>
                                <th class="text-left col-sm-6">{{ column_comment }}</th>
                                <th class="text-right col-sm-2">{{ column_actions }}</th>
                              </tr>
                              </thead>
                              <tbody>
                              {% for backup in store.manual_backups %}
                                <tr>
                                  <td class="text-center small">{{ backup.date_started|date("d/m/Y H:i") }}</td>
                                  <td class="text-center small">
                                    {% if backup.date_completed == '0000-00-00 00:00:00' %}
                                      <label class="label label-success">{{ text_running }}</label>
                                    {% else %}
                                      {{ backup.date_completed|date("d/m/Y H:i") }}
                                    {% endif %}
                                  </td>
                                  <td class="text-left small">{{ backup.comment }}</td>
                                  <td class="text-right">
                                    {% if backup.delete_requested == 1 %}
                                      <label class="label label-danger">{{ text_deleting }}</label>
                                    {% else %}
                                      <a class="btn btn-sm btn-danger button-click-load button-use-confirm" href="{{ link_delete_backup }}{{ backup.store_backup_id }}" data-toggle="tooltip" data-placement="top" title="{{ button_delete_backup }}"><i class="fa fa-trash-o fa-fw"></i></a>
                                    {% endif %}
                                  </td>
                                </tr>
                              {% endfor %}
                              </tbody>
                            </table>
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                </div>
                <br />
                <div class="panel panel-default">
                  <div class="panel-heading">
                    <h4>{{ text_automated_backups }}</h4>
                  </div>
                  <div class="panel-body">
                    <p>{{ text_automated_backup_desc }}</p>
                    <form action="{{ backup_restore_action }}" method="post" enctype="multipart/form-data" id="restore-backup-form">
                      <div class="row">
                        <div class="col-sm-5">
                          <select id="input-restore-backup" class="form-control col-sm-4">
                            <option value="" selected disabled>{{ text_view_backups }}</option>
                            {% for backup in store.automatic_backups %}
                              {% if backup.date_completed != '0000-00-00 00:00:00' %}
                                <option value="{{ backup.store_backup_id }}">{{ backup.date_completed|date("d/m/Y H:i") }}</option>
                              {% endif %}
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            <div class="buttons">
              <div class="text-left">
                <a href="{{ link_store_list }}" class="btn btn-default"><i class="fa fa-arrow-left"></i>&nbsp;&nbsp;{{ button_cloud_stores }}</a>
              </div>
            </div>

            <!-- Modal Windows -->
            {% for url in store.urls %}
              <div class="modal fade" id="url-modal-{{ url.store_url_id }}" tabindex="-1" role="dialog" aria-labelledby="url-modal-{{ url.store_url_id }}-label">
                <div class="modal-dialog" role="document">
                  <div class="modal-content">
                    <div class="modal-header">
                      <button type="button" class="close" data-dismiss="modal" aria-label="{{ button_close }}"><span aria-hidden="true">&times;</span></button>
                      <h4 class="modal-title" id="url-modal-{{ url.store_url_id }}-label">{{ text_edit_store_url }}</h4>
                    </div>
                    <div class="modal-body">
                      <div class="row">
                        <div class="col-sm-12">
                            {% if url.dns_check == 0 %}
                            <div id="dns-status-alert-{{ url.store_url_id }}"><div class="alert alert-danger"><i class="fa fa-times fa-fw"></i> {{ text_url_not_pointing }}</div></div>
                              <p class="dns-status-{{ url.store_url_id }}">{{ text_add_cname }}</p>
                              <div class="form-horizontal dns-status-{{ url.store_url_id }}">
                                <div class="form-group">
                                  <label class="col-sm-2">{{ text_cname }}</label>
                                  <div class="col-sm-7">
                                      <input type="text" class="form-control text-center" value="mystore.stores-1.{{ store_domain }}" />
                                  </div>
                                  <label class="col-sm-3"><button class="btn btn-info test-dns" value="{{ url.store_url_id }}">{{ button_test_dns }}</button></label>
                                </div>
                              </div>
                            {% else %}
                              <div class="alert alert-success"><i class="fa fa-check"></i> {{ text_url_setup_ok }}</div>
                            {% endif %}
                        </div>
                      </div>

                      <div id="dns-verified-{{ url.store_url_id }}" {% if url.dns_check == 0 %}style="display:none;"{% endif %}>
                        <div class="row">
                          <div class="col-sm-7"><label class="control-label form-control-static">{{ text_set_main_url }}</label></div>
                          <div class="col-sm-5" id="default-url-update-{{ url.store_url_id }}">
                            {% if url.default == 1 %}
                              <h6><span class="label label-success"><i class="fa fa-check fa-fw"></i></span></h6>
                            {% else %}
                              <div class="radio">
                                <input class="default-url" type="checkbox" value="{{ url.store_url_id }}" />
                              </div>
                            {% endif %}
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-sm-7"><label class="control-label form-control-static">{{ text_enable_ssl }}</label></div>
                          <div class="col-sm-5" id="ssl-update-{{ url.store_url_id }}">
                            {% if url.ssl_pending == 1 %}
                              <h6><span class="label label-warning">{{ text_updating }}</span></h6>
                            {% else %}
                              <div class="radio">
                                {% if url.ssl_enabled == 1 %}
                                  <h6><span class="label label-success"><i class="fa fa-check fa-fw"></i></span></h6>
                                {% else %}
                                    <input class="enable-ssl" type="checkbox" value="{{ url.store_url_id }}" />
                                {% endif %}
                              </div>
                            {% endif %}
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-sm-12">
                            <div class="help-block">{{ text_ssl_free_notice }}</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-default" data-dismiss="modal">{{ button_close }}</button>
                    </div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% elseif store.status_code == "SETUP_REQUESTED" or store.status_code == "SETUP_QUEUED" or store.status_code == "SETUP_STARTED" %}
            <div class="alert alert-info">{{ text_setup_in_process }} <a href="{{ link_creating_url }}">{{ text_click_here }}</a> {{ text_to_view_progress }}</div>
          {% else %}
            <div class="alert alert-warning">{{ text_unable_load_store }}</div>
          {% endif %}
        {% else %}
          <div class="alert alert-warning">{{ text_unable_load_account }}</div>
        {% endif %}
      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
<script type="text/javascript"><!--
  $('body').on('click', '.default-url', function (event) {
    var store_url_id = $(this).val();

    if (confirm("{{ text_confirm }}")) {
      $.ajax({
          url: 'index.php?route=cloud/store/defaulturl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
          type: 'get',
          dataType: 'json',
          beforeSend: function() {
            $('#default-url-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> {{ text_updating }}</span></h6>');
          },
          success: function(json) {
              if (json.success) {
                $('#default-url-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
              } else {
                $('#default-url-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
              }
          },
          error: function(xhr, ajaxOptions, thrownError) {
              alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
          }
      });
    } else {
        $(this).prop("checked", false);
    }
  });

  $('body').on('click', '.test-dns', function (event) {
  var store_url_id = $(this).val();

  $.ajax({
      url: 'index.php?route=cloud/store/testurl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
      type: 'get',
      dataType: 'json',
      beforeSend: function() {
        $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-info" id="testing-dns-' + store_url_id + '"><i class="fa fa-refresh fa-spin fa-fw"></i> {{ text_checking_domain }}</div>');
      },
      success: function(json) {
          if (json.header_code == 200) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-success"><i class="fa fa-check fa-fw"></i> {{ text_url_working }}</div>');
            $('.dns-status-' + store_url_id).hide();
            $('#dns-verified-' + store_url_id).show();
          } else if (json.header_code == 404) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-times fa-fw"></i> {{ text_url_not_pointing }}</div>');
          } else if (json.header_code > 0) {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-question fa-fw"></i> {{ text_unable_check_code }} "'+json.header_code+'"</div>');
          } else {
            $('#dns-status-alert-' + store_url_id).html('<div class="alert alert-warning"><i class="fa fa-question fa-fw"></i> {{ text_unable_check_later }}</div>');
          }

          $('#testing-dns-' + store_url_id).remove();
      },
      error: function(xhr, ajaxOptions, thrownError) {
          alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
      }
  });
  });

  $('body').on('change', '.enable-ssl', function (event) {
    var store_url_id = $(this).val();

    if (confirm("{{ text_confirm }}")) {
        if ($(this).is(":checked")) {
            $.ajax({
                url: 'index.php?route=cloud/store/addssl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
                type: 'get',
                dataType: 'json',
                beforeSend: function () {
                    $('#ssl-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> {{ text_requesting_ssl }}</span></h6>');
                },
                success: function (json) {
                    if (json.success) {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
                    } else {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        } else {
            $.ajax({
                url: 'index.php?route=cloud/store/deletessl&store_id={{ store.store_id }}&store_url_id=' + store_url_id + '&member_token={{ member_token }}',
                type: 'get',
                dataType: 'json',
                beforeSend: function () {
                    $('#ssl-update-' + store_url_id).html('<h6><span class="label label-info"><i class="fa fa-refresh fa-spin fa-fw"></i> {{ text_removing_ssl }}</span></h6>');
                },
                success: function (json) {
                    if (json.success) {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-success"><i class="fa fa-check fa-fw"></i> ' + json.success + '</span></h6>');
                    } else {
                        $('#ssl-update-' + store_url_id).empty().html('<h6><span class="label label-warning"><i class="fa fa-question fa-fw"></i> ' + json.error + '</span></h6>');
                    }
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        }
    } else {
        if ($(this).is(":checked")) {
            $(this).prop("checked", false);
        } else {
            $(this).prop("checked", true);
        }
    }
  });

  $('body').on('click', '.button-click-load', function (event) {
    $(this).html('<i class="fa fa-refresh fa-spin fa-fw"></i>').prop("disabled", "disabled");
  });

  $('body').on('click', '#password-view', function (event) {
    event.preventDefault();

    if ($('#store-admin-password').text() == '**********') {
        $('#store-admin-password').text('{{ store.config.store_password }}');
        $('#password-view').text('{{ text_hide }}');
    } else {
        $('#store-admin-password').text('**********');
        $('#password-view').text('{{ text_view }}');
    }
  });

  $('.button-use-confirm').on('click', function () {
    return confirm('{{ text_confirm }}');
  });
//--></script>
