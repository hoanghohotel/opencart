{{ header }}
<div id="cloud-subscription">
  <div class="page-header">
    <div class="container">
      <h1>{{ text_heading }}</h1>
      <p>{{ text_subtitle }}</p>
    </div>
  </div>
  <div class="container">
    <div class="row">
      <div class="col-md-9">
        <div class="panel panel-default">
          <div class="panel-body">
            <div class="row">
              <div class="col-sm-12 text-center"><strong>{{ text_cloud_store_id }}</strong> #{{ store.store_id }} / <strong>{{ text_store_name_label }} </strong> {{ store.store_name }}</div>
            </div>
            {% if "now"|date('Y-m-d') < store.date_trial_expire|date('Y-m-d') %}
              <div class="row">
                <div class="col-sm-12 text-center"><strong>{{ text_trial_expires }}</strong> {{ store.date_trial_expire|date("d/m/Y") }}</div>
              </div>
            {% endif %}
          </div>
        </div>

          <div class="row">
            <div class="col-md-4">
              <div class="panel panel-default">
                <div class="feature-plan">
                  <i class="opencart-icon-cart icon-bronze"></i>
                  <div class="panel-body text-center">
                    <h3>{{ text_bronze }}</h3>
                    <hr />
                    <h5>{{ text_bronze_storage }}</h5>
                    <h5>{{ text_priority_support }}</h5>
                    <p>{{ text_compare_features }}</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="panel panel-default">
                <div class="feature-plan">
                  <i class="opencart-icon-cart icon-silver"></i>
                  <div class="panel-body text-center">
                    <h3>{{ text_silver }}</h3>
                    <hr />
                    <h5>{{ text_silver_storage }}</h5>
                    <h5>{{ text_priority_support }}</h5>
                    <p>{{ text_compare_features }}</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="col-md-4">
              <div class="panel panel-default">
                <div class="feature-plan">
                  <i class="opencart-icon-cart icon-gold"></i>
                  <div class="panel-body text-center">
                    <h3>{{ text_gold }}</h3>
                    <hr />
                    <h5>{{ text_gold_storage }}</h5>
                    <h5>{{ text_priority_support }}</h5>
                    <p>{{ text_compare_features }}</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

      </div>
      <div class="col-md-3 hidden-xs">{{ menu }}</div>
    </div>
  </div>
</div>
{{ footer }}
