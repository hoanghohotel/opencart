{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-shopping-cart"></i> {{ text_order_detail }}</h3>
          </div>
          <table class="table">
            <tbody>
              <tr>
                <td><strong>{{ column_order_id }}</strong></td>
                <td>#{{ order_id }}</td>
              </tr>
              <tr>
                <td><strong>{{ entry_payment_method }}</strong></td>
                <td>{{ payment_method }}</td>
              </tr>
              <tr>
                <td><strong>{{ entry_transaction_id }}</strong></td>
                <td><code>{{ transaction_id }}</code></td>
              </tr>
              <tr>
                <td><strong>{{ column_date_added }}</strong></td>
                <td>{{ date_added }}</td>
              </tr>
              <tr>
                <td><strong>IP Address</strong></td>
                <td>{{ ip }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-user"></i> {{ text_buyer_detail }}</h3>
          </div>
          <table class="table">
            <tbody>
              <tr>
                <td><strong>{{ column_buyer }}</strong></td>
                <td><a href="{{ buyer_href }}">{{ buyer_name }} ({{ buyer_username }})</a></td>
              </tr>
              <tr>
                <td><strong>Buyer E-Mail</strong></td>
                <td>{{ buyer_email }}</td>
              </tr>
              <tr>
                <td><strong>{{ column_seller }}</strong></td>
                <td><a href="{{ seller_href }}">{{ seller_name }} ({{ seller_username }})</a></td>
              </tr>
              <tr>
                <td><strong>{{ column_status }}</strong></td>
                <td><span class="label {{ status_class ? status_class : 'label-success' }}">{{ order_status }}</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-info-circle"></i> {{ text_order }}</h3>
      </div>
      <div class="panel-body">
        <table class="table table-bordered">
          <thead>
            <tr>
              <td class="text-left">{{ column_extension }}</td>
              <td class="text-right">{{ entry_quantity }}</td>
              <td class="text-right">{{ entry_price }}</td>
              <td class="text-right">{{ column_total }}</td>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="text-left"><a href="{{ extension_href }}"><strong>{{ extension }}</strong></a></td>
              <td class="text-right">{{ quantity }}</td>
              <td class="text-right">{{ price }}</td>
              <td class="text-right"><strong>{{ total }}</strong></td>
            </tr>
          </tbody>
        </table>

        <hr/>
        <form action="{{ action }}" method="post" class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-order-status">{{ entry_order_status }}</label>
            <div class="col-sm-6">
              <select name="order_status_id" id="input-order-status" class="form-control">
                {% for status in order_statuses %}
                {% if status.order_status_id == order_status_id %}
                <option value="{{ status.order_status_id }}" selected="selected">{{ status.name }}</option>
                {% else %}
                <option value="{{ status.order_status_id }}">{{ status.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="col-sm-4">
              <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> {{ button_save }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
