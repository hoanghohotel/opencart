{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-payment" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div id="api-test-alert"></div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-credit-card"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-payment" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-stripe" data-toggle="tab"><i class="fa fa-cc-stripe"></i> {{ tab_stripe }}</a></li>
            <li><a href="#tab-braintree" data-toggle="tab"><i class="fa fa-credit-card-alt"></i> {{ tab_braintree }}</a></li>
            <li><a href="#tab-paypal" data-toggle="tab"><i class="fa fa-paypal"></i> {{ tab_paypal }}</a></li>
            <li><a href="#tab-general" data-toggle="tab"><i class="fa fa-cog"></i> {{ tab_general }}</a></li>
          </ul>
          <div class="tab-content">
            <!-- STRIPE TAB -->
            <div class="tab-pane active" id="tab-stripe">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-stripe-status">{{ entry_stripe_status }}</label>
                <div class="col-sm-10">
                  <select name="payment_stripe_status" id="input-stripe-status" class="form-control">
                    {% if payment_stripe_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-stripe-environment"><span data-toggle="tooltip" title="{{ help_api_mode }}">{{ entry_api_mode }}</span></label>
                <div class="col-sm-10">
                  <select name="payment_stripe_environment" id="input-stripe-environment" class="form-control">
                    {% if payment_stripe_environment == 'live' %}
                    <option value="test">{{ text_mode_test }}</option>
                    <option value="live" selected="selected">{{ text_mode_live }}</option>
                    {% else %}
                    <option value="test" selected="selected">{{ text_mode_test }}</option>
                    <option value="live">{{ text_mode_live }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <fieldset>
                <legend><span class="label label-warning">{{ text_badge_test }}</span> {{ text_stripe_test_legend }} (<code>https://api.stripe.com/v1</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-test-pk">{{ entry_stripe_test_pk }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_stripe_test_publishable_key" value="{{ payment_stripe_test_publishable_key }}" placeholder="pk_test_..." id="input-stripe-test-pk" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-test-sk">{{ entry_stripe_test_sk }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_stripe_test_secret_key" value="{{ payment_stripe_test_secret_key }}" placeholder="sk_test_..." id="input-stripe-test-sk" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-warning btn-test-stripe" data-env="test" data-target="#input-stripe-test-sk"><i class="fa fa-plug"></i> {{ button_test_stripe_test }}</button>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-test-wh">{{ entry_stripe_test_wh }}</label>
                  <div class="col-sm-10">
                    <input type="password" name="payment_stripe_test_webhook_secret" value="{{ payment_stripe_test_webhook_secret }}" placeholder="whsec_..." id="input-stripe-test-wh" class="form-control" />
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend><span class="label label-success">{{ text_badge_live }}</span> {{ text_stripe_live_legend }} (<code>https://api.stripe.com/v1</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-live-pk">{{ entry_stripe_live_pk }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_stripe_live_publishable_key" value="{{ payment_stripe_live_publishable_key }}" placeholder="pk_live_..." id="input-stripe-live-pk" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-live-sk">{{ entry_stripe_live_sk }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_stripe_live_secret_key" value="{{ payment_stripe_live_secret_key }}" placeholder="sk_live_..." id="input-stripe-live-sk" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-success btn-test-stripe" data-env="live" data-target="#input-stripe-live-sk"><i class="fa fa-plug"></i> {{ button_test_stripe_live }}</button>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-live-wh">{{ entry_stripe_live_wh }}</label>
                  <div class="col-sm-10">
                    <input type="password" name="payment_stripe_live_webhook_secret" value="{{ payment_stripe_live_webhook_secret }}" placeholder="whsec_..." id="input-stripe-live-wh" class="form-control" />
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_stripe_options }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-currency">{{ entry_currency }}</label>
                  <div class="col-sm-10">
                    <select name="payment_stripe_currency" id="input-stripe-currency" class="form-control">
                      {% for currency in currencies %}
                      <option value="{{ currency.code }}"{% if currency.code == payment_stripe_currency %} selected="selected"{% endif %}>{{ currency.title }} ({{ currency.code }})</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-capture">{{ entry_capture_method }}</label>
                  <div class="col-sm-10">
                    <select name="payment_stripe_capture_method" id="input-stripe-capture" class="form-control">
                      {% if payment_stripe_capture_method == 'manual' %}
                      <option value="automatic">{{ text_capture_auto }}</option>
                      <option value="manual" selected="selected">{{ text_capture_manual }}</option>
                      {% else %}
                      <option value="automatic" selected="selected">{{ text_capture_auto }}</option>
                      <option value="manual">{{ text_capture_manual }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-stripe-3ds">{{ entry_three_d_secure }}</label>
                  <div class="col-sm-10">
                    <select name="payment_stripe_three_d_secure" id="input-stripe-3ds" class="form-control">
                      {% if payment_stripe_three_d_secure %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </fieldset>
            </div>

            <!-- BRAINTREE TAB -->
            <div class="tab-pane" id="tab-braintree">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-bt-status">{{ entry_braintree_status }}</label>
                <div class="col-sm-10">
                  <select name="payment_braintree_status" id="input-bt-status" class="form-control">
                    {% if payment_braintree_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-bt-environment">{{ entry_environment }}</label>
                <div class="col-sm-10">
                  <select name="payment_braintree_environment" id="input-bt-environment" class="form-control">
                    {% if payment_braintree_environment == 'production' %}
                    <option value="sandbox">{{ text_mode_test }}</option>
                    <option value="production" selected="selected">{{ text_mode_live }}</option>
                    {% else %}
                    <option value="sandbox" selected="selected">{{ text_mode_test }}</option>
                    <option value="production">{{ text_mode_live }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <fieldset>
                <legend><span class="label label-warning">{{ text_badge_sandbox }}</span> {{ text_braintree_sb_legend }} (<code>https://payments.sandbox.braintree-api.com/graphql</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-sb-mid">{{ entry_bt_sb_mid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_sandbox_merchant_id" value="{{ payment_braintree_sandbox_merchant_id }}" placeholder="{{ entry_bt_sb_mid }}" id="input-bt-sb-mid" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-sb-pub">{{ entry_bt_sb_pub }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_sandbox_public_key" value="{{ payment_braintree_sandbox_public_key }}" placeholder="{{ entry_bt_sb_pub }}" id="input-bt-sb-pub" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-sb-priv">{{ entry_bt_sb_priv }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_braintree_sandbox_private_key" value="{{ payment_braintree_sandbox_private_key }}" placeholder="{{ entry_bt_sb_priv }}" id="input-bt-sb-priv" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-warning btn-test-braintree" data-env="sandbox" data-mid="#input-bt-sb-mid" data-pub="#input-bt-sb-pub" data-priv="#input-bt-sb-priv"><i class="fa fa-plug"></i> {{ button_test_bt_sandbox }}</button>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-sb-maid">{{ entry_bt_sb_maid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_sandbox_merchant_account_id" value="{{ payment_braintree_sandbox_merchant_account_id }}" placeholder="{{ entry_bt_sb_maid }}" id="input-bt-sb-maid" class="form-control" />
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend><span class="label label-success">{{ text_badge_production }}</span> {{ text_braintree_prod_legend }} (<code>https://payments.braintree-api.com/graphql</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-prod-mid">{{ entry_bt_prod_mid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_production_merchant_id" value="{{ payment_braintree_production_merchant_id }}" placeholder="{{ entry_bt_prod_mid }}" id="input-bt-prod-mid" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-prod-pub">{{ entry_bt_prod_pub }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_production_public_key" value="{{ payment_braintree_production_public_key }}" placeholder="{{ entry_bt_prod_pub }}" id="input-bt-prod-pub" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-prod-priv">{{ entry_bt_prod_priv }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_braintree_production_private_key" value="{{ payment_braintree_production_private_key }}" placeholder="{{ entry_bt_prod_priv }}" id="input-bt-prod-priv" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-success btn-test-braintree" data-env="production" data-mid="#input-bt-prod-mid" data-pub="#input-bt-prod-pub" data-priv="#input-bt-prod-priv"><i class="fa fa-plug"></i> {{ button_test_bt_live }}</button>
                      </span>
                    </div>
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-prod-maid">{{ entry_bt_prod_maid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_braintree_production_merchant_account_id" value="{{ payment_braintree_production_merchant_account_id }}" placeholder="{{ entry_bt_prod_maid }}" id="input-bt-prod-maid" class="form-control" />
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_braintree_options }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-bt-3ds">{{ entry_three_d_secure_2 }}</label>
                  <div class="col-sm-10">
                    <select name="payment_braintree_three_d_secure" id="input-bt-3ds" class="form-control">
                      {% if payment_braintree_three_d_secure %}
                      <option value="1" selected="selected">{{ text_enabled }}</option>
                      <option value="0">{{ text_disabled }}</option>
                      {% else %}
                      <option value="1">{{ text_enabled }}</option>
                      <option value="0" selected="selected">{{ text_disabled }}</option>
                      {% endif %}
                    </select>
                  </div>
                </div>
              </fieldset>
            </div>

            <!-- PAYPAL TAB -->
            <div class="tab-pane" id="tab-paypal">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-pp-status">{{ entry_paypal_status }}</label>
                <div class="col-sm-10">
                  <select name="payment_paypal_status" id="input-pp-status" class="form-control">
                    {% if payment_paypal_status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-pp-environment">{{ entry_environment }}</label>
                <div class="col-sm-10">
                  <select name="payment_paypal_environment" id="input-pp-environment" class="form-control">
                    {% if payment_paypal_environment == 'live' %}
                    <option value="sandbox">{{ text_mode_test }}</option>
                    <option value="live" selected="selected">{{ text_mode_live }}</option>
                    {% else %}
                    <option value="sandbox" selected="selected">{{ text_mode_test }}</option>
                    <option value="live">{{ text_mode_live }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>

              <fieldset>
                <legend><span class="label label-warning">{{ text_badge_sandbox }}</span> {{ text_paypal_sb_legend }} (<code>https://api-m.sandbox.paypal.com</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-pp-sb-cid">{{ entry_pp_sb_cid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_paypal_sandbox_client_id" value="{{ payment_paypal_sandbox_client_id }}" placeholder="{{ entry_pp_sb_cid }}" id="input-pp-sb-cid" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-pp-sb-sec">{{ entry_pp_sb_sec }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_paypal_sandbox_secret" value="{{ payment_paypal_sandbox_secret }}" placeholder="{{ entry_pp_sb_sec }}" id="input-pp-sb-sec" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-warning btn-test-paypal" data-env="sandbox" data-cid="#input-pp-sb-cid" data-sec="#input-pp-sb-sec"><i class="fa fa-plug"></i> {{ button_test_pp_sandbox }}</button>
                      </span>
                    </div>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend><span class="label label-success">{{ text_badge_production }}</span> {{ text_paypal_live_legend }} (<code>https://api-m.paypal.com</code>)</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-pp-live-cid">{{ entry_pp_live_cid }}</label>
                  <div class="col-sm-10">
                    <input type="text" name="payment_paypal_live_client_id" value="{{ payment_paypal_live_client_id }}" placeholder="{{ entry_pp_live_cid }}" id="input-pp-live-cid" class="form-control" />
                  </div>
                </div>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-pp-live-sec">{{ entry_pp_live_sec }}</label>
                  <div class="col-sm-10">
                    <div class="input-group">
                      <input type="password" name="payment_paypal_live_secret" value="{{ payment_paypal_live_secret }}" placeholder="{{ entry_pp_live_sec }}" id="input-pp-live-sec" class="form-control" />
                      <span class="input-group-btn">
                        <button type="button" class="btn btn-success btn-test-paypal" data-env="live" data-cid="#input-pp-live-cid" data-sec="#input-pp-live-sec"><i class="fa fa-plug"></i> {{ button_test_pp_live }}</button>
                      </span>
                    </div>
                  </div>
                </div>
              </fieldset>

              <fieldset>
                <legend>{{ text_paypal_options }}</legend>
                <div class="form-group">
                  <label class="col-sm-2 control-label" for="input-pp-currency">{{ entry_currency }}</label>
                  <div class="col-sm-10">
                    <select name="payment_paypal_currency" id="input-pp-currency" class="form-control">
                      {% for currency in currencies %}
                      <option value="{{ currency.code }}"{% if currency.code == payment_paypal_currency %} selected="selected"{% endif %}>{{ currency.title }} ({{ currency.code }})</option>
                      {% endfor %}
                    </select>
                  </div>
                </div>
              </fieldset>
            </div>

            <!-- GENERAL ROUTING TAB -->
            <div class="tab-pane" id="tab-general">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-card-gateway">{{ entry_card_gateway }}</label>
                <div class="col-sm-10">
                  <select name="payment_card_gateway" id="input-card-gateway" class="form-control">
                    {% if payment_card_gateway == 'braintree' %}
                    <option value="stripe">{{ text_gateway_stripe }}</option>
                    <option value="braintree" selected="selected">{{ text_gateway_braintree }}</option>
                    {% else %}
                    <option value="stripe" selected="selected">{{ text_gateway_stripe }}</option>
                    <option value="braintree">{{ text_gateway_braintree }}</option>
                    {% endif %}
                  </select>
                  <span class="help-block">{{ help_card_gateway }}</span>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('.btn-test-stripe').on('click', function() {
    var btn = $(this);
    var env = btn.data('env');
    var sk = $(btn.data('target')).val();

    $.ajax({
        url: 'index.php?route=setting/payment/testStripe&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        data: { environment: env, secret_key: sk },
        beforeSend: function() {
            btn.button('loading');
        },
        complete: function() {
            btn.button('reset');
        },
        success: function(json) {
            $('#api-test-alert').empty();
            if (json.error) {
                $('#api-test-alert').html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json.error + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
            if (json.success) {
                $('#api-test-alert').html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json.success + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
        }
    });
});

$('.btn-test-braintree').on('click', function() {
    var btn = $(this);
    var env = btn.data('env');
    var mid = $(btn.data('mid')).val();
    var pub = $(btn.data('pub')).val();
    var priv = $(btn.data('priv')).val();

    $.ajax({
        url: 'index.php?route=setting/payment/testBraintree&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        data: { environment: env, merchant_id: mid, public_key: pub, private_key: priv },
        beforeSend: function() {
            btn.button('loading');
        },
        complete: function() {
            btn.button('reset');
        },
        success: function(json) {
            $('#api-test-alert').empty();
            if (json.error) {
                $('#api-test-alert').html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json.error + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
            if (json.success) {
                $('#api-test-alert').html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json.success + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
        }
    });
});

$('.btn-test-paypal').on('click', function() {
    var btn = $(this);
    var env = btn.data('env');
    var cid = $(btn.data('cid')).val();
    var sec = $(btn.data('sec')).val();

    $.ajax({
        url: 'index.php?route=setting/payment/testPaypal&user_token={{ user_token }}',
        type: 'post',
        dataType: 'json',
        data: { environment: env, client_id: cid, secret: sec },
        beforeSend: function() {
            btn.button('loading');
        },
        complete: function() {
            btn.button('reset');
        },
        success: function(json) {
            $('#api-test-alert').empty();
            if (json.error) {
                $('#api-test-alert').html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json.error + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
            if (json.success) {
                $('#api-test-alert').html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json.success + '<button type="button" class="close" data-dismiss="alert">&times;</button></div>');
            }
        }
    });
});
//--></script>
