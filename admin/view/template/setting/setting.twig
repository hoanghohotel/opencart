$('select[name=\'config_country_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=localisation/country/country&user_token={{ user_token }}&country_id=' + this.value,
		dataType: 'json',
		beforeSend: function() {
			$('select[name=\'config_country_id\']').prop('disabled', true);
		},
		complete: function() {
			$('select[name=\'config_country_id\']').prop('disabled', false);
		},
		success: function(json) {
			html = '<option value="">{{ text_select }}</option>';

			if (json['zone'] && json['zone'] != '') {
				for (i = 0; i < json['zone'].length; i++) {
					html += '<option value="' + json['zone'][i]['zone_id'] + '"';

					if (json['zone'][i]['zone_id'] == '{{ config_zone_id }}') {
						html += ' selected="selected"';
					}

					html += '>' + json['zone'][i]['name'] + '</option>';
				}
			} else {
				html += '<option value="0" selected="selected">{{ text_none }}</option>';
			}

			$('select[name=\'config_zone_id\']').html(html);
		},
		error: function(xhr, ajaxOptions, thrownError) {
			alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
		}
	});
});

$('select[name=\'config_country_id\']').trigger('change');

$('#button-test-smtp').on('click', function() {
	var $btn = $(this);
	var $result = $('#smtp-test-result');
	$.ajax({
		url: 'index.php?route=setting/setting/testSmtp&user_token={{ user_token }}',
		type: 'post',
		dataType: 'json',
		data: {
			config_mail_engine: $('#input-mail-engine').val(),
			config_mail_parameter: $('#input-mail-parameter').val(),
			config_mail_smtp_hostname: $('#input-mail-smtp-hostname').val(),
			config_mail_smtp_username: $('#input-mail-smtp-username').val(),
			config_mail_smtp_password: $('#input-mail-smtp-password').val(),
			config_mail_smtp_port: $('#input-mail-smtp-port').val(),
			config_mail_smtp_timeout: $('#input-mail-smtp-timeout').val(),
			config_email: $('#input-email').val(),
			config_name: $('#input-name').val(),
			test_email: $('#input-mail-test-email').val()
		},
		beforeSend: function() {
			$btn.button('loading');
			$result.html('');
		},
		complete: function() {
			$btn.button('reset');
		},
		success: function(json) {
			if (json['error']) {
				$result.html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + json['error'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
			if (json['success']) {
				$result.html('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + json['success'] + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
			}
		},
		error: function(xhr, ajaxOptions, thrownError) {
			$result.html('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> ' + thrownError + ' ' + xhr.statusText + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
		}
	});
});

function updateStorageUI() {
	var driver = $('#input-storage-driver').val();
	if (driver === 'local') {
		$('#cloud-storage-fields').slideUp(150);
	} else {
		$('#cloud-storage-fields').slideDown(150);
		if (driver === 'google') {
			$('#group-storage-gcs-json').show();
		} else {
			$('#group-storage-gcs-json').hide();
		}
		if (driver === 'cloudflare' && ($('#input-storage-region').val() === '' || $('#input-storage-region').val() === 'us-east-1')) {
			$('#input-storage-region').val('auto');
		}
	}
}

$('#input-storage-driver').on('change', updateStorageUI);
updateStorageUI();

