{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-extension" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_form }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-extension" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
            <li><a href="#tab-data" data-toggle="tab">{{ tab_data }}</a></li>
            <li><a href="#tab-image" data-toggle="tab">{{ tab_image }}</a></li>
            <li><a href="#tab-download" data-toggle="tab">{{ tab_download }}</a></li>
          </ul>
          <div class="tab-content">
            <!-- General -->
            <div class="tab-pane active" id="tab-general">
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-name">{{ entry_name }}</label>
                <div class="col-sm-10">
                  <input type="text" name="name" value="{{ name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
                  {% if error_name %}
                  <div class="text-danger">{{ error_name }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-description">{{ entry_description }}</label>
                <div class="col-sm-10">
                  <textarea name="description" rows="8" placeholder="{{ entry_description }}" id="input-description" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ description }}</textarea>
                  {% if error_description %}
                  <div class="text-danger">{{ error_description }}</div>
                  {% endif %}
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-documentation">{{ entry_documentation }}</label>
                <div class="col-sm-10">
                  <textarea name="documentation" rows="6" placeholder="{{ entry_documentation }}" id="input-documentation" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ documentation }}</textarea>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-history">{{ entry_history }}</label>
                <div class="col-sm-10">
                  <textarea name="history" rows="4" placeholder="{{ entry_history }}" id="input-history" data-toggle="summernote" data-lang="{{ summernote }}" class="form-control">{{ history }}</textarea>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-tag">{{ entry_tag }}</label>
                <div class="col-sm-10">
                  <input type="text" name="tag" value="{{ tag }}" placeholder="{{ entry_tag }}" id="input-tag" class="form-control" />
                </div>
              </div>
            </div>

            <!-- Data -->
            <div class="tab-pane" id="tab-data">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-member">{{ entry_member }}</label>
                <div class="col-sm-10">
                  <select name="member_id" id="input-member" class="form-control">
                    {% for member in members %}
                    {% if member.member_id == member_id %}
                    <option value="{{ member.member_id }}" selected="selected">{{ member.username }} ({{ member.firstname }} {{ member.lastname }})</option>
                    {% else %}
                    <option value="{{ member.member_id }}">{{ member.username }} ({{ member.firstname }} {{ member.lastname }})</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-category">{{ entry_category }}</label>
                <div class="col-sm-10">
                  <select name="extension_category_id" id="input-category" class="form-control">
                    {% for category in categories %}
                    {% if category.extension_category_id == extension_category_id %}
                    <option value="{{ category.extension_category_id }}" selected="selected">{{ category.name }}</option>
                    {% else %}
                    <option value="{{ category.extension_category_id }}">{{ category.name }}</option>
                    {% endif %}
                    {% endfor %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-license">{{ entry_license }}</label>
                <div class="col-sm-10">
                  <select name="license" id="input-license" class="form-control">
                    {% if license %}
                    <option value="0">{{ text_free }}</option>
                    <option value="1" selected="selected">{{ text_commercial }}</option>
                    {% else %}
                    <option value="0" selected="selected">{{ text_free }}</option>
                    <option value="1">{{ text_commercial }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-price">{{ entry_price }}</label>
                <div class="col-sm-10">
                  <input type="text" name="price" value="{{ price }}" placeholder="{{ entry_price }}" id="input-price" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-license-period">{{ entry_license_period }}</label>
                <div class="col-sm-10">
                  <input type="text" name="license_period" value="{{ license_period }}" placeholder="{{ entry_license_period }}" id="input-license-period" class="form-control" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_recommended }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline"><input type="radio" name="recommended" value="1" {% if recommended %}checked="checked"{% endif %} /> {{ text_yes }}</label>
                  <label class="radio-inline"><input type="radio" name="recommended" value="0" {% if not recommended %}checked="checked"{% endif %} /> {{ text_no }}</label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_featured }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline"><input type="radio" name="featured" value="1" {% if featured %}checked="checked"{% endif %} /> {{ text_yes }}</label>
                  <label class="radio-inline"><input type="radio" name="featured" value="0" {% if not featured %}checked="checked"{% endif %} /> {{ text_no }}</label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_publish }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline"><input type="radio" name="publish" value="1" {% if publish %}checked="checked"{% endif %} /> {{ text_yes }}</label>
                  <label class="radio-inline"><input type="radio" name="publish" value="0" {% if not publish %}checked="checked"{% endif %} /> {{ text_no }}</label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_reviews_enabled }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline"><input type="radio" name="reviews_enabled" value="1" {% if reviews_enabled %}checked="checked"{% endif %} /> {{ text_yes }}</label>
                  <label class="radio-inline"><input type="radio" name="reviews_enabled" value="0" {% if not reviews_enabled %}checked="checked"{% endif %} /> {{ text_no }}</label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label">{{ entry_comments_enabled }}</label>
                <div class="col-sm-10">
                  <label class="radio-inline"><input type="radio" name="comments_enabled" value="1" {% if comments_enabled %}checked="checked"{% endif %} /> {{ text_yes }}</label>
                  <label class="radio-inline"><input type="radio" name="comments_enabled" value="0" {% if not comments_enabled %}checked="checked"{% endif %} /> {{ text_no }}</label>
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <select name="status" id="input-status" class="form-control">
                    {% if status %}
                    <option value="1" selected="selected">{{ text_enabled }}</option>
                    <option value="0">{{ text_disabled }}</option>
                    {% else %}
                    <option value="1">{{ text_enabled }}</option>
                    <option value="0" selected="selected">{{ text_disabled }}</option>
                    {% endif %}
                  </select>
                </div>
              </div>
            </div>

            <!-- Images -->
            <div class="tab-pane" id="tab-image">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-image">{{ entry_image }}</label>
                <div class="col-sm-10"><a href="" id="thumb-image" data-toggle="image" class="img-thumbnail"><img src="{{ thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" style="max-width:100px;" /></a>
                  <input type="hidden" name="image" value="{{ image }}" id="input-image" />
                </div>
              </div>
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-banner">{{ entry_banner }}</label>
                <div class="col-sm-10"><a href="" id="thumb-banner" data-toggle="image" class="img-thumbnail"><img src="{{ banner_thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" style="max-width:100px;" /></a>
                  <input type="hidden" name="banner" value="{{ banner }}" id="input-banner" />
                </div>
              </div>
              <div class="table-responsive">
                <table id="images" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ tab_additional }}</td>
                      <td class="text-right">{{ entry_sort_order }}</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set image_row = 0 %}
                    {% for extension_image in extension_images %}
                    <tr id="image-row{{ image_row }}">
                      <td class="text-left"><a href="" id="thumb-image{{ image_row }}" data-toggle="image" class="img-thumbnail"><img src="{{ extension_image.thumb }}" alt="" title="" data-placeholder="{{ placeholder }}" style="max-width:100px;" /></a>
                        <input type="hidden" name="extension_image[{{ image_row }}][image]" value="{{ extension_image.image }}" id="input-image{{ image_row }}" /></td>
                      <td class="text-right"><input type="text" name="extension_image[{{ image_row }}][sort_order]" value="{{ extension_image.sort_order }}" placeholder="{{ entry_sort_order }}" class="form-control" /></td>
                      <td class="text-left"><button type="button" onclick="$('#image-row{{ image_row }}').remove();" data-toggle="tooltip" title="{{ button_remove }}" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                    </tr>
                    {% set image_row = image_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="2"></td>
                      <td class="text-left"><button type="button" onclick="addImage();" data-toggle="tooltip" title="{{ button_image_add }}" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>

            <!-- Downloads -->
            <div class="tab-pane" id="tab-download">
              <div class="table-responsive">
                <table id="downloads" class="table table-striped table-bordered table-hover">
                  <thead>
                    <tr>
                      <td class="text-left">{{ entry_download_name }}</td>
                      <td class="text-left">{{ entry_filename }}</td>
                      <td class="text-left">{{ entry_mask }}</td>
                      <td class="text-left">{{ entry_compatibility }}</td>
                      <td class="text-center">{{ entry_approved }}</td>
                      <td></td>
                    </tr>
                  </thead>
                  <tbody>
                    {% set download_row = 0 %}
                    {% for dl in extension_downloads %}
                    <tr id="download-row{{ download_row }}">
                      <td class="text-left">
                        <input type="text" name="extension_download[{{ download_row }}][name]" value="{{ dl.name }}" placeholder="{{ entry_download_name }}" class="form-control" />
                        <input type="hidden" name="extension_download[{{ download_row }}][downloaded]" value="{{ dl.downloaded }}" />
                      </td>
                      <td class="text-left"><input type="text" name="extension_download[{{ download_row }}][filename]" value="{{ dl.filename }}" placeholder="{{ entry_filename }}" class="form-control" /></td>
                      <td class="text-left"><input type="text" name="extension_download[{{ download_row }}][mask]" value="{{ dl.mask }}" placeholder="{{ entry_mask }}" class="form-control" /></td>
                      <td class="text-left">
                        {% for release in releases %}
                        <label class="checkbox-inline">
                          <input type="checkbox" name="extension_download[{{ download_row }}][download_id][]" value="{{ release.download_id }}" {% if release.download_id in dl.download_id %}checked="checked"{% endif %} /> {{ release.name }}
                        </label>
                        {% endfor %}
                      </td>
                      <td class="text-center">
                        <select name="extension_download[{{ download_row }}][approved]" class="form-control">
                          <option value="1" {% if dl.approved %}selected="selected"{% endif %}>{{ text_yes }}</option>
                          <option value="0" {% if not dl.approved %}selected="selected"{% endif %}>{{ text_no }}</option>
                        </select>
                      </td>
                      <td class="text-left"><button type="button" onclick="$('#download-row{{ download_row }}').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>
                    </tr>
                    {% set download_row = download_row + 1 %}
                    {% endfor %}
                  </tbody>
                  <tfoot>
                    <tr>
                      <td colspan="5"></td>
                      <td class="text-left"><button type="button" onclick="addDownload();" class="btn btn-primary"><i class="fa fa-plus-circle"></i></button></td>
                    </tr>
                  </tfoot>
                </table>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
var image_row = {{ image_row }};

function addImage() {
	html  = '<tr id="image-row' + image_row + '">';
	html += '  <td class="text-left"><a href="" id="thumb-image' + image_row + '"data-toggle="image" class="img-thumbnail"><img src="{{ placeholder }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a><input type="hidden" name="extension_image[' + image_row + '][image]" value="" id="input-image' + image_row + '" /></td>';
	html += '  <td class="text-right"><input type="text" name="extension_image[' + image_row + '][sort_order]" value="0" placeholder="{{ entry_sort_order }}" class="form-control" /></td>';
	html += '  <td class="text-left"><button type="button" onclick="$(\'#image-row' + image_row  + '\').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
	html += '</tr>';

	$('#images tbody').append(html);
	image_row++;
}

var download_row = {{ download_row }};

function addDownload() {
	html  = '<tr id="download-row' + download_row + '">';
	html += '  <td class="text-left"><input type="text" name="extension_download[' + download_row + '][name]" value="" placeholder="{{ entry_download_name }}" class="form-control" /><input type="hidden" name="extension_download[' + download_row + '][downloaded]" value="0" /></td>';
	html += '  <td class="text-left"><input type="text" name="extension_download[' + download_row + '][filename]" value="" placeholder="{{ entry_filename }}" class="form-control" /></td>';
	html += '  <td class="text-left"><input type="text" name="extension_download[' + download_row + '][mask]" value="" placeholder="{{ entry_mask }}" class="form-control" /></td>';
	html += '  <td class="text-left">{% for release in releases %}<label class="checkbox-inline"><input type="checkbox" name="extension_download[' + download_row + '][download_id][]" value="{{ release.download_id }}" checked="checked" /> {{ release.name }}</label>{% endfor %}</td>';
	html += '  <td class="text-center"><select name="extension_download[' + download_row + '][approved]" class="form-control"><option value="1" selected="selected">{{ text_yes }}</option><option value="0">{{ text_no }}</option></select></td>';
	html += '  <td class="text-left"><button type="button" onclick="$(\'#download-row' + download_row + '\').remove();" class="btn btn-danger"><i class="fa fa-minus-circle"></i></button></td>';
	html += '</tr>';

	$('#downloads tbody').append(html);
	download_row++;
}
//--></script>
</div>
{{ footer }}
