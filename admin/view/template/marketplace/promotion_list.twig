{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right"><a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-promotion').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-info">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-tags"></i> {{ text_package_prices }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ save_prices }}" method="post" class="form-horizontal">
          <div class="row">
            <div class="col-sm-2">
              <label class="control-label">{{ entry_price_1w }}</label>
              <input type="text" name="config_promotion_price_1w" value="{{ config_promotion_price_1w }}" class="form-control" />
            </div>
            <div class="col-sm-2">
              <label class="control-label">{{ entry_price_1m }}</label>
              <input type="text" name="config_promotion_price_1m" value="{{ config_promotion_price_1m }}" class="form-control" />
            </div>
            <div class="col-sm-2">
              <label class="control-label">{{ entry_price_3m }}</label>
              <input type="text" name="config_promotion_price_3m" value="{{ config_promotion_price_3m }}" class="form-control" />
            </div>
            <div class="col-sm-2">
              <label class="control-label">{{ entry_price_6m }}</label>
              <input type="text" name="config_promotion_price_6m" value="{{ config_promotion_price_6m }}" class="form-control" />
            </div>
            <div class="col-sm-2">
              <label class="control-label">{{ entry_price_1y }}</label>
              <input type="text" name="config_promotion_price_1y" value="{{ config_promotion_price_1y }}" class="form-control" />
            </div>
            <div class="col-sm-2" style="padding-top: 25px;">
              <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-save"></i> {{ button_save_prices }}</button>
            </div>
          </div>
        </form>
      </div>
    </div>
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-promotion">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left">{{ column_extension }}</td>
                  <td class="text-left">{{ column_member }}</td>
                  <td class="text-right">{{ column_days }}</td>
                  <td class="text-right">{{ column_total }}</td>
                  <td class="text-left">{{ column_date_start }}</td>
                  <td class="text-left">{{ column_date_end }}</td>
                  <td class="text-left">{{ column_status }}</td>
                  <td class="text-right">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if promotions %}
                {% for promotion in promotions %}
                <tr>
                  <td class="text-center">{% if promotion.promotion_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ promotion.promotion_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ promotion.promotion_id }}" />
                    {% endif %}</td>
                  <td class="text-left"><strong>{{ promotion.extension }}</strong></td>
                  <td class="text-left">{{ promotion.member }}</td>
                  <td class="text-right">{{ promotion.days }}</td>
                  <td class="text-right">{{ promotion.total }}</td>
                  <td class="text-left">{{ promotion.date_start }}</td>
                  <td class="text-left">{{ promotion.date_end }}</td>
                  <td class="text-left">{% if promotion.is_paid %}<span class="label label-success">{{ promotion.status }}</span>{% else %}<span class="label label-warning">{{ promotion.status }}</span>{% endif %}</td>
                  <td class="text-right">{% if promotion.approve %}<a href="{{ promotion.approve }}" data-toggle="tooltip" title="{{ button_approve }}" class="btn btn-success"><i class="fa fa-check"></i></a> {% endif %}<a href="{{ promotion.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="9">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
