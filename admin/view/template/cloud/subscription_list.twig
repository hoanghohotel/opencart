{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" data-toggle="tooltip" title="{{ button_filter }}" onclick="$('#filter-subscription').toggleClass('hidden-sm hidden-xs');" class="btn btn-default hidden-md hidden-lg"><i class="fa fa-filter"></i></button>
        <a href="{{ add }}" data-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary"><i class="fa fa-plus"></i></a>
        <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-subscription').submit() : false;"><i class="fa fa-trash-o"></i></button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="row">
      <div id="filter-subscription" class="col-md-3 col-md-push-9 col-sm-12 hidden-sm hidden-xs">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-filter"></i> {{ text_filter }}</h3>
          </div>
          <div class="panel-body">
            <div class="form-group">
              <label class="control-label" for="input-name">{{ entry_name }}</label>
              <input type="text" name="filter_name" value="{{ filter_name }}" placeholder="{{ entry_name }}" id="input-name" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-member">{{ entry_member }}</label>
              <input type="text" name="filter_member" value="{{ filter_member }}" placeholder="{{ entry_member }}" id="input-member" class="form-control" />
            </div>
            <div class="form-group">
              <label class="control-label" for="input-plan">{{ entry_plan }}</label>
              <select name="filter_subscription_plan_id" id="input-plan" class="form-control">
                <option value=""></option>
                {% for plan in subscription_plans %}
                {% if plan.subscription_plan_id == filter_subscription_plan_id %}
                <option value="{{ plan.subscription_plan_id }}" selected="selected">{{ plan.name }}</option>
                {% else %}
                <option value="{{ plan.subscription_plan_id }}">{{ plan.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-group">
              <label class="control-label" for="input-status">{{ entry_status }}</label>
              <select name="filter_subscription_status_id" id="input-status" class="form-control">
                <option value=""></option>
                {% for status in subscription_statuses %}
                {% if status.subscription_status_id == filter_subscription_status_id %}
                <option value="{{ status.subscription_status_id }}" selected="selected">{{ status.name }}</option>
                {% else %}
                <option value="{{ status.subscription_status_id }}">{{ status.name }}</option>
                {% endif %}
                {% endfor %}
              </select>
            </div>
            <div class="form-group text-right">
              <button type="button" id="button-filter" class="btn btn-default"><i class="fa fa-filter"></i> {{ button_filter }}</button>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-9 col-md-pull-3 col-sm-12">
        <div class="panel panel-default">
          <div class="panel-heading">
            <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
          </div>
          <div class="panel-body">
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-subscription">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                      <td class="text-left">{% if sort == 's.name' %}<a href="{{ sort_name }}" class="{{ order|lower }}">{{ column_name }}</a>{% else %}<a href="{{ sort_name }}">{{ column_name }}</a>{% endif %}</td>
                      <td class="text-left">{% if sort == 'member_name' %}<a href="{{ sort_member }}" class="{{ order|lower }}">{{ column_member }}</a>{% else %}<a href="{{ sort_member }}">{{ column_member }}</a>{% endif %}</td>
                      <td class="text-left">{% if sort == 'plan_name' %}<a href="{{ sort_plan }}" class="{{ order|lower }}">{{ column_plan }}</a>{% else %}<a href="{{ sort_plan }}">{{ column_plan }}</a>{% endif %}</td>
                      <td class="text-left">{% if sort == 'status_name' %}<a href="{{ sort_status }}" class="{{ order|lower }}">{{ column_status }}</a>{% else %}<a href="{{ sort_status }}">{{ column_status }}</a>{% endif %}</td>
                      <td class="text-left">{{ column_store_status }}</td>
                      <td class="text-left">{% if sort == 's.date_added' %}<a href="{{ sort_date_added }}" class="{{ order|lower }}">{{ column_date_added }}</a>{% else %}<a href="{{ sort_date_added }}">{{ column_date_added }}</a>{% endif %}</td>
                      <td class="text-right">{{ column_action }}</td>
                    </tr>
                  </thead>
                  <tbody>
                    {% if subscriptions %}
                    {% for subscription in subscriptions %}
                    <tr>
                      <td class="text-center">{% if subscription.subscription_id in selected %}
                        <input type="checkbox" name="selected[]" value="{{ subscription.subscription_id }}" checked="checked" />
                        {% else %}
                        <input type="checkbox" name="selected[]" value="{{ subscription.subscription_id }}" />
                        {% endif %}</td>
                      <td class="text-left"><strong>{{ subscription.name }}</strong></td>
                      <td class="text-left">{{ subscription.member }}</td>
                      <td class="text-left">{{ subscription.plan }}</td>
                      <td class="text-left"><span class="label label-info">{{ subscription.status }}</span></td>
                      <td class="text-left">{{ subscription.store_status }}</td>
                      <td class="text-left">{{ subscription.date_added }}</td>
                      <td class="text-right"><a href="{{ subscription.edit }}" data-toggle="tooltip" title="{{ button_edit }}" class="btn btn-primary"><i class="fa fa-pencil"></i></a></td>
                    </tr>
                    {% endfor %}
                    {% else %}
                    <tr>
                      <td class="text-center" colspan="8">{{ text_no_results }}</td>
                    </tr>
                    {% endif %}
                  </tbody>
                </table>
              </div>
            </form>
            <div class="row">
              <div class="col-sm-6 text-left">{{ pagination }}</div>
              <div class="col-sm-6 text-right">{{ results }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script type="text/javascript"><!--
$('#button-filter').on('click', function() {
	var url = 'index.php?route=cloud/subscription&user_token={{ user_token }}';

	var filter_name = $('input[name=\'filter_name\']').val();
	if (filter_name) {
		url += '&filter_name=' + encodeURIComponent(filter_name);
	}

	var filter_member = $('input[name=\'filter_member\']').val();
	if (filter_member) {
		url += '&filter_member=' + encodeURIComponent(filter_member);
	}

	var filter_subscription_plan_id = $('select[name=\'filter_subscription_plan_id\']').val();
	if (filter_subscription_plan_id !== '') {
		url += '&filter_subscription_plan_id=' + encodeURIComponent(filter_subscription_plan_id);
	}

	var filter_subscription_status_id = $('select[name=\'filter_subscription_status_id\']').val();
	if (filter_subscription_status_id !== '') {
		url += '&filter_subscription_status_id=' + encodeURIComponent(filter_subscription_status_id);
	}

	location = url;
});
//--></script>
</div>
{{ footer }}
